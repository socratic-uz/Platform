@using Microsoft.AspNetCore.Components.Web
@namespace QuickGrid
@using Material.Web.Components
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common

<footer paginator>
    @if (State.TotalItemCount.HasValue)
    {
        <span>
            @if (SummaryTemplate is not null)
            {
                @SummaryTemplate
            }
            else
            {
                <text><strong>@State.TotalItemCount</strong> @L[PaginationItems]</text>
            }
        </span>
        <nav>
            <IconButton Icon=@FirstPage OnClick=@GoFirstAsync Disabled=@(!CanGoBack) Title=@L[PaginationFirstPage] AriaLabel=@L[PaginationFirstPage] />
            <IconButton Icon=@NavigateBefore OnClick=@GoPreviousAsync Disabled=@(!CanGoBack) Title=@L[PaginationPrevPage] AriaLabel=@L[PaginationPrevPage] />
            <span>
                @L[PaginationPage] <strong>@(State.CurrentPageIndex + 1)</strong>
                @L[PaginationOf] <strong>@(State.LastPageIndex + 1)</strong>
            </span>
            <IconButton Icon=@NavigateNext OnClick=@GoNextAsync Disabled=@(!CanGoForwards) Title=@L[PaginationNextPage] AriaLabel=@L[PaginationNextPage] />
            <IconButton Icon=@LastPage OnClick=@GoLastAsync Disabled=@(!CanGoForwards) Title=@L[PaginationLastPage] AriaLabel=@L[PaginationLastPage] />
        </nav>
    }
</footer>

{
  "name": "assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified Design System static assets, Web Components bundling, and W3C styles pipeline",
  "scripts": {
    "build:js": "rollup -c rollup.config.js",
    "generate:classes": "node scripts/generate-css-classes.mjs",
    "generate:assets": "node scripts/generate-asset-paths.mjs",
    "generate:loc": "node scripts/generate-localization-keys.mjs",
    "generate:icons": "node scripts/generate-icon-constants.mjs",
    "validate:syntax": "node scripts/validate-syntax.mjs",
    "generate:codegen": "node scripts/generate-codegen.mjs",
    "build": "npm run validate:syntax && npm run build:js && npm run generate:codegen",
    "lint:css": "stylelint \"wwwroot/css/**/*.css\"",
    "lint:css:fix": "stylelint \"wwwroot/css/**/*.css\" --fix",
    "generate:preview": "node scripts/generate-preview.mjs",
    "generate:blueprints": "node scripts/generate-blueprints.mjs",
    "generate:usage": "node scripts/generate-usage.mjs",
    "generate:all": "node scripts/generate-analytics.mjs",
    "generate:analytics": "node scripts/generate-analytics.mjs",
    "refresh": "npm run generate:codegen && npm run generate:analytics",
    "watch:blueprints": "node scripts/generate-blueprints.mjs --watch"
  },
  "dependencies": {
    "@lit-labs/ssr-client": "^1.1.8",
    "@material/material-color-utilities": "^0.3.0",
    "@material/web": "^2.3.0",
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "lightningcss": "^1.33.0",
    "purgecss": "^7.0.2",
    "rollup": "^4.34.8",
    "stylelint": "^7.7.0",
    "stylelint-config-standard": "^15.0.1"
  }
}

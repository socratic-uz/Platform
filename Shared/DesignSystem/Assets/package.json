{
  "name": "assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified Design System static assets, Web Components bundling, and design system styling pipeline",
  "scripts": {
    "build:js": "rollup -c rollup.config.js",
    "generate:styles": "node scripts/generate-styles-manifest.mjs",
    "generate:assets": "node scripts/generate-asset-paths.mjs",
    "generate:loc": "node scripts/generate-localization-keys.mjs",
    "generate:icons": "node scripts/generate-icon-constants.mjs",
    "validate:syntax": "node scripts/validate-syntax.mjs",
    "generate:codegen": "node scripts/generate-codegen.mjs",
    "build": "npm run generate:styles && npm run validate:syntax && npm run build:js && npm run generate:codegen",
    "lint:css": "stylelint \"wwwroot/css/**/*.css\"",
    "lint:css:fix": "stylelint \"wwwroot/css/**/*.css\" --fix",
    "sort:css": "node scripts/sort-css-by-dom.mjs",
    "sort:css:check": "node scripts/sort-css-by-dom.mjs --check",
    "generate:preview": "node scripts/generate-preview.mjs",
    "generate:blueprints": "node scripts/generate-blueprints.mjs",
    "generate:usage": "node scripts/generate-usage.mjs",
    "generate:all": "node scripts/generate-analytics.mjs",
    "generate:analytics": "node scripts/generate-analytics.mjs",
    "refresh": "npm run generate:codegen && npm run generate:analytics",
    "cleanup:unused-css": "node scripts/cleanup-unused-css.mjs",
    "analyze:classless": "node scripts/analyze-classless.mjs --verbose",
    "watch:blueprints": "node scripts/generate-blueprints.mjs --watch",
    "preview:serve": "http-server wwwroot -p 8080 -c-1 -o /preview/map.html"
  },
  "dependencies": {
    "@lit-labs/ssr-client": "^1.1.8",
    "@material/material-color-utilities": "^0.3.0",
    "@material/web": "^2.3.0",
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "playwright": "^1.52.0",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^6.1.4",
    "rollup": "^4.34.8",
    "stylelint": "^16.14.0",
    "stylelint-config-standard": "^37.0.0"
  }
}

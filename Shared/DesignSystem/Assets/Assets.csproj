<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Assets</RootNamespace>
    <AssemblyName>Assets</AssemblyName>
    <PackageId>Assets</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>
    <BundleAssets Condition="'$(BundleAssets)' == '' And '$(Configuration)' == 'Release'">true</BundleAssets>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\fonts\" />
    <Folder Include="wwwroot\icons\" />
    <Folder Include="wwwroot\img\" />
    <Folder Include="wwwroot\audio\" />
    <Folder Include="wwwroot\js\" />
    <Folder Include="wwwroot\maps\" />
    <Folder Include="Constants\" />
    <Folder Include="Resources\" />
  </ItemGroup>

  <!-- Excluded standalone WASM preview artifacts copied by Web.UI.Client build -->
  <ItemGroup>
    <Content Remove="wwwroot\_framework\**;wwwroot\_content\**;wwwroot\index.html;wwwroot\appsettings*.json" />
    <None Remove="wwwroot\_framework\**;wwwroot\_content\**;wwwroot\index.html;wwwroot\appsettings*.json" />
  </ItemGroup>

  <!-- Track all W3C CSS source modules for incremental build -->
  <ItemGroup>
    <CssSourceFiles Include="wwwroot\css\**\*.css" Exclude="wwwroot\css\styles.css;wwwroot\css\*.min.css*;wwwroot\css\*.map" />
    <ResxSourceFiles Include="Resources\*.resx" />
  </ItemGroup>

  <!-- Automated C# token generation pipeline -->
  <Target Name="BuildAssetsBundle" BeforeTargets="ResolveStaticWebAssetsInputs;BeforeCompile;BeforeBuild" Inputs="@(CssSourceFiles);@(ResxSourceFiles)" Outputs="wwwroot\css\styles.css;Constants\Assets.g.cs;Constants\Loc.g.cs;Constants\Icons.g.cs" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)scripts/generate-styles-manifest.mjs&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ContinueOnError="WarnAndContinue" StandardOutputImportance="Normal" />
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)scripts/generate-asset-paths.mjs&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ContinueOnError="WarnAndContinue" StandardOutputImportance="Normal" />
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)scripts/generate-localization-keys.mjs&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ContinueOnError="WarnAndContinue" StandardOutputImportance="Normal" />
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)scripts/generate-icon-constants.mjs&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ContinueOnError="WarnAndContinue" StandardOutputImportance="Normal" />
  </Target>

  <!-- Single-file CSS & JS bundling for Release (or -p:BundleAssets=true); Debug stays unbundled for Hot Reload -->
  <Target Name="BuildReleaseAssetsBundle"
          AfterTargets="BuildAssetsBundle"
          BeforeTargets="ResolveStaticWebAssetsInputs;AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(BundleAssets)' == 'true'">
    <PropertyGroup>
      <ReleaseBundleDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)release-bundle'))</ReleaseBundleDir>
    </PropertyGroup>
    <!-- CI images start from a clean checkout: install bundler deps (postcss, rollup, ...) when node_modules is missing -->
    <Exec Command="npm ci --no-audit --no-fund"
          Condition="!Exists('$(MSBuildThisFileDirectory)node_modules/postcss')"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="Normal" />
    <!-- Bundling is an optimization: if node/npm are unavailable (e.g. android/aot images) fall back to unbundled assets instead of failing the build -->
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)scripts/bundle-assets.mjs&quot; --out &quot;$(ReleaseBundleDir)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="Normal">
      <Output TaskParameter="ExitCode" PropertyName="_AssetsBundleExitCode" />
    </Exec>
    <Warning Condition="'$(_AssetsBundleExitCode)' != '0'" Text="Assets single-file bundling failed (exit $(_AssetsBundleExitCode)); falling back to unbundled css/js." />
    <ItemGroup Condition="'$(_AssetsBundleExitCode)' == '0' And Exists('$(ReleaseBundleDir)\js\scripts.js')">
      <Content Remove="wwwroot\css\**\*.css" />
      <Content Remove="wwwroot\js\**\*.js" />
      <Content Include="wwwroot\js\wasm-boot.js;wwwroot\js\file-shim.js;wwwroot\js\layouts\theme-init.js;wwwroot\js\features\hardware\camera-streamer.js" />
      <Content Include="$(ReleaseBundleDir)\css\styles.css" Link="wwwroot\css\styles.css" ContentRoot="$(ReleaseBundleDir)\" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(ReleaseBundleDir)\js\scripts.js" Link="wwwroot\js\scripts.js" ContentRoot="$(ReleaseBundleDir)\" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Configurations>Debug;Release;LocalDebug;Runner;Cluster</Configurations>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
    <Compile Update="Tokens\CssClasses.g.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <!-- Level 2: Generates strongly-typed C# class constants from CSS stylesheets -->
  <Target Name="GenerateCssClasses" BeforeTargets="BeforeCompile" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildThisFileDirectory)../../../../../scripts/generate-css-classes.mjs')">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)../../../../../scripts/generate-css-classes.mjs&quot;" 
          ContinueOnError="true" 
          StandardOutputImportance="Low" />
  </Target>

  <!-- Level 3: Produces single-file production CSS bundle with LightningCSS (7ms) -->
  <Target Name="BundleCss" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildThisFileDirectory)../../../../../scripts/bundle-css.mjs')">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)../../../../../scripts/bundle-css.mjs&quot;" 
          ContinueOnError="true" 
          StandardOutputImportance="Low" />
  </Target>

  <!-- Level 4: Socratic Quality Gate stop-lever for Release / CI builds -->
  <Target Name="ValidateCssQuality" BeforeTargets="Build" Condition="('$(Configuration)' == 'Release' or '$(ContinuousIntegrationBuild)' == 'true') and Exists('$(MSBuildThisFileDirectory)../../../../../scripts/quality-gate.ps1')">
    <Exec Command="pwsh -File &quot;$(MSBuildThisFileDirectory)../../../../../scripts/quality-gate.ps1&quot;" 
          ContinueOnError="false" />
  </Target>

</Project>

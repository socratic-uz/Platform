<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Configurations>Debug;Release;LocalDebug;Runner;Cluster</Configurations>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(Assets)" Condition="'$(Assets)' != '' and Exists('$(Assets)')" />
    <ProjectReference Include="..\Assets\Assets.csproj" Condition="('$(Assets)' == '' or !Exists('$(Assets)')) and Exists('..\Assets\Assets.csproj')" />
  </ItemGroup>

  <!-- Level 4: Socratic Quality Gate stop-lever for Release / CI builds -->
  <Target Name="ValidateCssQuality" BeforeTargets="Build" Condition="('$(Configuration)' == 'Release' or '$(ContinuousIntegrationBuild)' == 'true') and Exists('$(MSBuildThisFileDirectory)../../../../../scripts/quality-gate.ps1')">
    <Exec Command="pwsh -File &quot;$(MSBuildThisFileDirectory)../../../../../scripts/quality-gate.ps1&quot;" 
          ContinueOnError="false" />
  </Target>

</Project>

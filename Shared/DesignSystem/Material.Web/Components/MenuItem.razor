@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<md-menu-item disabled="@Disabled"
              type="@Type"
              href="@Href"
              target="@Target"
              keep-open="@KeepOpen"
              selected="@Selected"
              @attributes="AdditionalAttributes"
              @onclick="HandleClick">
    
    @if (!string.IsNullOrEmpty(StartIcon))
    {
        <md-icon slot="start">@StartIcon</md-icon>
    }
    
    @if (!string.IsNullOrEmpty(Headline))
    {
        <div slot="headline">@Headline</div>
    }
    
    @if (!string.IsNullOrEmpty(SupportingText))
    {
        <div slot="supporting-text">@SupportingText</div>
    }
    
    @if (!string.IsNullOrEmpty(EndIcon))
    {
        <md-icon slot="end">@EndIcon</md-icon>
    }
    
    @ChildContent
</md-menu-item>
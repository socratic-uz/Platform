@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<md-menu-item disabled=@Disabled
              type=@Type
              href=@Href
              target=@Target
              keep-open=@KeepOpen
              selected=@Selected
              @attributes=AdditionalAttributes
              @onclick=@HandleClick>
    
    @if (!string.IsNullOrEmpty(StartIcon))
    {
        <md-icon slot="start">@StartIcon</md-icon>
    }
    
    @if (!string.IsNullOrEmpty(Headline))
    {
        <span slot="headline">@Headline</span>
    }
    
    @if (!string.IsNullOrEmpty(SupportingText))
    {
        <span slot="supporting-text">@SupportingText</span>
    }
    
    @if (!string.IsNullOrEmpty(EndIcon))
    {
        <md-icon slot="end">@EndIcon</md-icon>
    }
    
    @ChildContent
</md-menu-item>
@if (IsSecondary)
{
    <md-secondary-tab active="@IsActive" inline-icon="@InlineIcon" @onclick="HandleClick" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <md-icon slot="icon">@Icon</md-icon>
        }
        @ChildContent
    </md-secondary-tab>
}
else
{
    <md-primary-tab active="@IsActive" inline-icon="@InlineIcon" @onclick="HandleClick" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <md-icon slot="icon">@Icon</md-icon>
        }
        @ChildContent
    </md-primary-tab>
}

@code {
    [CascadingParameter] public Tabs? Parent { get; set; }

    [Parameter] public int Index { get; set; }
    [Parameter] public bool InlineIcon { get; set; } = false;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool IsSecondary { get; set; } = false;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsActive => Parent != null && Parent.ActiveTabIndex == Index;

    private async Task HandleClick()
    {
        if (Parent != null)
        {
            await Parent.SelectTab(Index);
        }
    }
}

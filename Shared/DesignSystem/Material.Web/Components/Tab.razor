@if (IsSecondary)
{
    <md-secondary-tab active="@IsActive" inline-icon="@InlineIcon" @onclick="HandleClick" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <md-icon slot="icon">@Icon</md-icon>
        }
        @ChildContent
    </md-secondary-tab>
}
else
{
    <md-primary-tab active="@IsActive" inline-icon="@InlineIcon" @onclick="HandleClick" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <md-icon slot="icon">@Icon</md-icon>
        }
        @ChildContent
    </md-primary-tab>
}

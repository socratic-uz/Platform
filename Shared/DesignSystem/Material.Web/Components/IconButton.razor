@using Microsoft.AspNetCore.Components.Web

@switch (Variant)
{
    case IconButtonVariant.Filled:
        <md-filled-icon-button disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" toggle="@Toggle" selected="@Selected" @attributes="AdditionalAttributes" @onclick="HandleClick">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <md-icon>@Icon</md-icon>
            }
            @ChildContent
        </md-filled-icon-button>
        break;
    case IconButtonVariant.FilledTonal:
        <md-filled-tonal-icon-button disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" toggle="@Toggle" selected="@Selected" @attributes="AdditionalAttributes" @onclick="HandleClick">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <md-icon>@Icon</md-icon>
            }
            @ChildContent
        </md-filled-tonal-icon-button>
        break;
    case IconButtonVariant.Outlined:
        <md-outlined-icon-button disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" toggle="@Toggle" selected="@Selected" @attributes="AdditionalAttributes" @onclick="HandleClick">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <md-icon>@Icon</md-icon>
            }
            @ChildContent
        </md-outlined-icon-button>
        break;
    case IconButtonVariant.Standard:
    default:
        <md-icon-button disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" toggle="@Toggle" selected="@Selected" @attributes="AdditionalAttributes" @onclick="HandleClick">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <md-icon>@Icon</md-icon>
            }
            @ChildContent
        </md-icon-button>
        break;
}

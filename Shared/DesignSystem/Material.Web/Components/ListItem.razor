@using Microsoft.AspNetCore.Components.Web

<md-list-item disabled=@Disabled
              type=@EffectiveType
              href=@Href
              target=@Target
              @attributes=AdditionalAttributes
              @onclick=@HandleClick>
    @if (!string.IsNullOrEmpty(StartIcon))
    {
        <Icon Name=@StartIcon slot="start" />
    }
    @if (StartContent != null)
    {
        <span slot="start">@StartContent</span>
    }
    @if (!string.IsNullOrEmpty(Headline))
    {
        <span slot="headline">@Headline</span>
    }
    @if (!string.IsNullOrEmpty(SupportingText))
    {
        <span slot="supporting-text">@SupportingText</span>
    }
    @if (!string.IsNullOrEmpty(TrailingSupportingText))
    {
        <span slot="trailing-supporting-text">@TrailingSupportingText</span>
    }
    @if (!string.IsNullOrEmpty(EndIcon))
    {
        <Icon Name=@EndIcon slot="end" />
    }
    @if (EndContent != null)
    {
        <span slot="end">@EndContent</span>
    }
    @ChildContent
</md-list-item>

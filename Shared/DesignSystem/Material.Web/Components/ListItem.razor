@using Microsoft.AspNetCore.Components.Web

<md-list-item disabled="@Disabled"
              type="@EffectiveType"
              href="@Href"
              target="@Target"
              @attributes="AdditionalAttributes"
              @onclick="HandleClick">
    @if (StartContent != null)
    {
        <div slot="start">@StartContent</div>
    }
    @if (!string.IsNullOrEmpty(Headline))
    {
        <div slot="headline">@Headline</div>
    }
    @if (!string.IsNullOrEmpty(SupportingText))
    {
        <div slot="supporting-text">@SupportingText</div>
    }
    @if (!string.IsNullOrEmpty(TrailingSupportingText))
    {
        <div slot="trailing-supporting-text">@TrailingSupportingText</div>
    }
    @if (EndContent != null)
    {
        <div slot="end">@EndContent</div>
    }
    @ChildContent
</md-list-item>

@code {
    [Parameter] public string? Headline { get; set; }
    [Parameter] public string? SupportingText { get; set; }
    [Parameter] public bool MultiLineSupportingText { get; set; } = false;
    [Parameter] public string? TrailingSupportingText { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Selected { get; set; } = false;
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public RenderFragment? StartContent { get; set; }
    [Parameter] public RenderFragment? EndContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string EffectiveType
    {
        get
        {
            if (!string.IsNullOrEmpty(Type)) return Type;
            if (!string.IsNullOrEmpty(Href)) return "link";
            if (OnClick.HasDelegate) return "button";
            return "text";
        }
    }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (Disabled) return;
        if (SelectedChanged.HasDelegate)
        {
            Selected = !Selected;
            await SelectedChanged.InvokeAsync(Selected);
        }
        await OnClick.InvokeAsync(e);
    }
}

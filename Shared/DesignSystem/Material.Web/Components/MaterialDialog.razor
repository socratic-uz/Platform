@using Microsoft.AspNetCore.Components.Web

@if (Open)
{
    <md-dialog open=@Open
               type=@Type
               no-focus-trap=@NoFocusTrap
               @onclose=@HandleClose
               @oncancel=@HandleCancel
               @attributes=AdditionalAttributes>
        @if (Headline != null)
        {
            <header slot="headline">@Headline</header>
        }
        @if (Content != null)
        {
            <section slot="content">@Content</section>
        }
        @if (Actions != null)
        {
            <footer slot="actions">@Actions</footer>
        }
        @ChildContent
    </md-dialog>
}

@using Microsoft.AspNetCore.Components.Web

@if (Open)
{
    <md-dialog open=@Open
               type=@Type
               no-focus-trap=@NoFocusTrap
               @onclose=@HandleClose
               @oncancel=@HandleCancel
               @attributes=AdditionalAttributes>
        @if (Headline != null)
        {
            <header slot="headline" class=@HeadlineClass>@Headline</header>
        }
        @if (Content != null)
        {
            <section slot="content" class=@ContentClass>@Content</section>
        }
        @if (Actions != null)
        {
            <footer slot="actions" class=@ActionsClass>@Actions</footer>
        }
        @ChildContent
    </md-dialog>
}

@namespace Material.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant

<section file-picker>
    <PickerTriggerCard Label=@EffectiveLabel
                       Icon=@AttachFile
                       ActiveIcon=@FolderOpen
                       HasValue=@(TotalFilesCount > 0)
                       BadgeText=@GetFilesBadgeText()
                       BadgeIcon=@Folder
                       PreviewText=@GetPreviewText()
                       ResetIcon=@DeleteSweep
                       ResetAriaLabel=@L[FilePickerClearAll]
                       OnReset=@ClearAll>
        <CustomActions>
            <label for=@inputId>
                <Button Variant=@FilledTonal Type="button" Icon=@AddPhotoAlternate>
                    @EffectiveUploadLabel
                </Button>
            </label>

            @if (TotalFilesCount > 0)
            {
                <IconButton Icon=@DeleteSweep
                            AriaLabel=@L[FilePickerClearAll]
                            OnClick=@ClearAll />
            }
        </CustomActions>
    </PickerTriggerCard>

    <menu>
        <!-- Universal Attachments -->
        @if (Attachments != null)
        {
            @for (int i = 0; i < Attachments.Count; i++)
            {
                var index = i;
                if (index < Attachments.Count)
                {
                    var (fileName, contentType, url, isNew, bytesData) = GetAttachmentData(index);
                    <article>
                        <figure>
                            @if (IsImage(contentType, fileName))
                            {
                                var imgUrl = isNew ? GetBase64DataUrl(bytesData!, contentType) : GetPreviewUrl(url);
                                <img src=@imgUrl alt=@fileName />
                            }
                            else
                            {
                                <Icon Name=@GetFileIcon(contentType, fileName) />
                            }
                        </figure>
                        <footer title=@fileName>@fileName</footer>
                        @if (isNew)
                        {
                            <span>New</span>
                        }
                        <menu>
                            <IconButton Icon=@Delete
                                        AriaLabel=@EffectiveRemoveLabel
                                        OnClick=@(() => RemoveAttachment(index)) />
                        </menu>
                    </article>
                }
            }
        }

        <!-- Legacy Existing Images -->
        @if (ExistingImages != null)
        {
            @for (int i = 0; i < ExistingImages.Count; i++)
            {
                var index = i;
                if (index < ExistingImages.Count)
                {
                    var (previewUrl, fileName) = GetExistingImageData(index);
                    <article>
                        <figure>
                            <img src=@previewUrl alt=@fileName />
                        </figure>
                        <footer title=@fileName>@fileName</footer>
                        <menu>
                            <IconButton Icon=@Delete
                                        AriaLabel=@EffectiveRemoveLabel
                                        OnClick=@(() => RemoveExistingImage(index)) />
                        </menu>
                    </article>
                }
            }
        }

        <!-- Legacy New Images -->
        @if (NewImagesContent != null)
        {
            @for (int i = 0; i < NewImagesContent.Count; i++)
            {
                var index = i;
                if (index < NewImagesContent.Count)
                {
                    var (dataUrl, contentType, fileName) = GetNewImageData(index);
                    <article>
                        <figure>
                            @if (IsImage(contentType, fileName))
                            {
                                <img src=@dataUrl alt=@fileName />
                            }
                            else
                            {
                                <Icon Name=@GetFileIcon(contentType, fileName) />
                            }
                        </figure>
                        <footer title=@fileName>@fileName</footer>
                        <span>New</span>
                        <menu>
                            <IconButton Icon=@Delete
                                        AriaLabel=@EffectiveRemoveLabel
                                        OnClick=@(() => RemoveNewImage(index)) />
                        </menu>
                    </article>
                }
            }
        }

        <!-- Upload Card -->
        <label for=@inputId data-dragging=@(isDragging ? "true" : null)
             @ondragenter=@HandleDragEnter
             @ondragleave=@HandleDragLeave
             @ondragover=@HandleDragOver
             @ondragover:preventDefault
             @ondrop=@HandleDrop
             @ondrop:preventDefault>
            
            <span>
                <Icon Name=@CloudUpload />
                <span>@EffectiveUploadLabel</span>
                <span>@L[FilePickerDragFilesOrClick]</span>
            </span>
            
            <InputFile id=@inputId 
                       OnChange=@HandleFileSelected 
                       multiple=@Multiple 
                       accept=@Accept 
                       hidden />
        </label>
    </menu>
</section>

@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@inherits InputBase<string>

@if (Variant == SelectVariant.Filled)
{
    <md-filled-select id="@Id"
                      class="@CssClass material-select"
                      label="@Label"
                      value="@CurrentValueAsString"
                      supporting-text="@GetSupportingText()"
                      error-text="@GetErrorText()"
                      @attributes="AdditionalAttributes"
                      disabled="@Disabled"
                      required="@Required"
                      error="@HasValidationErrors"
                      quick="@Quick"
                      no-asterisk="@NoAsterisk"
                      menu-positioning="@MenuPositioning"
                      clamp-menu-width="@ClampMenuWidth"
                      typeahead-delay="@TypeaheadDelay"
                      has-leading-icon="@HasLeadingIcon"
                      menu-align="@MenuAlign"
                      @ref="selectElement"
                      @oninput=@HandleInput
                      @onchange=@HandleChange
                      @opening=@OnOpening
                      @opened=@OnOpened
                      @closing=@OnClosing
                      @closed=@OnClosed>
        @if (HasLeadingIcon)
        {
            <md-icon slot="leading-icon">@LeadingIcon</md-icon>
        }
        @if (Options != null && Options.Any())
        {
            @foreach (var option in Options)
            {
                <md-select-option value="@option.Value" 
                                  headline="@option.Text"
                                  selected="@(option.Value == CurrentValueAsString)">
                    @if (!string.IsNullOrEmpty(option.SupportingText))
                    {
                        <div slot="supporting-text">@option.SupportingText</div>
                    }
                    @if (!string.IsNullOrEmpty(option.TrailingText))
                    {
                        <div slot="trailing-supporting-text">@option.TrailingText</div>
                    }
                    @if (!string.IsNullOrEmpty(option.LeadingIcon))
                    {
                        <md-icon slot="start">@option.LeadingIcon</md-icon>
                    }
                    @if (!string.IsNullOrEmpty(option.TrailingIcon))
                    {
                        <md-icon slot="end">@option.TrailingIcon</md-icon>
                    }
                </md-select-option>
            }
        }
        else
        {
            @ChildContent
        }
    </md-filled-select>
}
else
{
    <md-outlined-select id="@Id"
                        class="@CssClass material-select"
                        label="@Label"
                        value="@CurrentValueAsString"
                        supporting-text="@GetSupportingText()"
                        error-text="@GetErrorText()"
                        @attributes="AdditionalAttributes"
                        disabled="@Disabled"
                        required="@Required"
                        error="@HasValidationErrors"
                        quick="@Quick"
                        no-asterisk="@NoAsterisk"
                        menu-positioning="@MenuPositioning"
                        clamp-menu-width="@ClampMenuWidth"
                        typeahead-delay="@TypeaheadDelay"
                        has-leading-icon="@HasLeadingIcon"
                        menu-align="@MenuAlign"
                        @ref="selectElement"
                        @oninput=@HandleInput
                        @onchange=@HandleChange
                        @opening=@OnOpening
                        @opened=@OnOpened
                        @closing=@OnClosing
                        @closed=@OnClosed>
        @if (HasLeadingIcon)
        {
            <md-icon slot="leading-icon">@LeadingIcon</md-icon>
        }
        @if (Options != null && Options.Any())
        {
            @foreach (var option in Options)
            {
                <md-select-option value="@option.Value" 
                                  headline="@option.Text"
                                  selected="@(option.Value == CurrentValueAsString)">
                    @if (!string.IsNullOrEmpty(option.SupportingText))
                    {
                        <div slot="supporting-text">@option.SupportingText</div>
                    }
                    @if (!string.IsNullOrEmpty(option.TrailingText))
                    {
                        <div slot="trailing-supporting-text">@option.TrailingText</div>
                    }
                    @if (!string.IsNullOrEmpty(option.LeadingIcon))
                    {
                        <md-icon slot="start">@option.LeadingIcon</md-icon>
                    }
                    @if (!string.IsNullOrEmpty(option.TrailingIcon))
                    {
                        <md-icon slot="end">@option.TrailingIcon</md-icon>
                    }
                </md-select-option>
            }
        }
        else
        {
            @ChildContent
        }
    </md-outlined-select>
}

@code {
    private ElementReference selectElement;

    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public SelectVariant Variant { get; set; } = SelectVariant.Filled;
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string SupportingText { get; set; } = "";
    [Parameter] public string ErrorText { get; set; } = "";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public bool Quick { get; set; } = false;
    [Parameter] public bool NoAsterisk { get; set; } = false;
    [Parameter] public string MenuPositioning { get; set; } = "popover";
    [Parameter] public bool ClampMenuWidth { get; set; } = false;
    [Parameter] public int TypeaheadDelay { get; set; } = 200;
    [Parameter] public bool HasLeadingIcon { get; set; } = false;
    [Parameter] public string LeadingIcon { get; set; } = "";
    [Parameter] public string MenuAlign { get; set; } = "start";

    // Ïàðàìåòðû äëÿ âàëèäàöèè
    [Parameter] public Expression<Func<string>>? For { get; set; }
    [Parameter] public bool ShowValidationMessage { get; set; } = true;

    // Îïöèè äëÿ âûáîðà
    [Parameter] public List<SelectOption>? Options { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Ñîáûòèÿ
    [Parameter] public EventCallback<EventArgs> OnOpening { get; set; }
    [Parameter] public EventCallback<EventArgs> OnOpened { get; set; }
    [Parameter] public EventCallback<EventArgs> OnClosing { get; set; }
    [Parameter] public EventCallback<EventArgs> OnClosed { get; set; }

    // Ñâîéñòâî äëÿ ïðîâåðêè íàëè÷èÿ îøèáîê âàëèäàöèè
    private bool HasValidationErrors => EditContext?.GetValidationMessages(FieldIdentifier).Any() == true;

    // Ìåòîäû äëÿ ïîëó÷åíèÿ òåêñòà ïîääåðæêè è îøèáîê
    private string GetSupportingText()
    {
        if (HasValidationErrors && ShowValidationMessage)
            return "";
        return SupportingText;
    }

    private string GetErrorText()
    {
        if (HasValidationErrors && ShowValidationMessage)
        {
            var messages = EditContext?.GetValidationMessages(FieldIdentifier);
            return messages?.FirstOrDefault() ?? ErrorText;
        }
        return ErrorText;
    }

    // Обработчики событий с правильной двусторонней привязкой
    private Task HandleInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
        return Task.CompletedTask;
    }

    private Task HandleChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        if (For != null && EditContext != null)
        {
            FieldIdentifier = FieldIdentifier.Create(For);
        }
        base.OnParametersSet();
    }

    protected override bool TryParseValueFromString(string? value, out string result, out string? validationErrorMessage)
    {
        result = value ?? "";
        validationErrorMessage = null;
        return true;
    }

    public enum SelectVariant
    {
        Filled,
        Outlined
    }

    public class SelectOption
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
        public string? SupportingText { get; set; }
        public string? TrailingText { get; set; }
        public string? LeadingIcon { get; set; }
        public string? TrailingIcon { get; set; }
        public bool Disabled { get; set; } = false;

        public SelectOption() { }

        public SelectOption(string value, string text)
        {
            Value = value;
            Text = text;
        }

        public SelectOption(string value, string text, string? supportingText = null, string? leadingIcon = null, string? trailingIcon = null)
        {
            Value = value;
            Text = text;
            SupportingText = supportingText;
            LeadingIcon = leadingIcon;
            TrailingIcon = trailingIcon;
        }
    }
}
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@inherits InputBase<string>

@if (Variant == SelectVariant.Filled)
{
    <md-filled-select id=@Id
                      label=@Label
                      value=@CurrentValueAsString
                      supporting-text=@GetSupportingText()
                      error-text=@GetErrorText()
                      @attributes=AdditionalAttributes
                      disabled=@Disabled
                      required=@Required
                      error=@HasValidationErrors
                      quick=@Quick
                      no-asterisk=@NoAsterisk
                      menu-positioning=@MenuPositioning
                      clamp-menu-width=@ClampMenuWidth
                      typeahead-delay=@TypeaheadDelay
                      has-leading-icon=@HasLeadingIcon
                      menu-align=@MenuAlign
                      @ref=selectElement
                      @oninput=@HandleInput
                      @onchange=@HandleChange
                      @opening=@OnOpening
                      @opened=@OnOpened
                      @closing=@OnClosing
                      @closed=@OnClosed>
        @if (HasLeadingIcon)
        {
            <md-icon slot="leading-icon">@LeadingIcon</md-icon>
        }
        @if (Options != null && Options.Any())
        {
            @foreach (var option in Options)
            {
                <md-select-option value=@option.Value 
                                  headline=@option.Text
                                  selected=@(option.Value == CurrentValueAsString)>
                    @if (!string.IsNullOrEmpty(option.SupportingText))
                    {
                        <span slot="supporting-text">@option.SupportingText</span>
                    }
                    @if (!string.IsNullOrEmpty(option.TrailingText))
                    {
                        <span slot="trailing-supporting-text">@option.TrailingText</span>
                    }
                    @if (!string.IsNullOrEmpty(option.LeadingIcon))
                    {
                        <md-icon slot="start">@option.LeadingIcon</md-icon>
                    }
                    @if (!string.IsNullOrEmpty(option.TrailingIcon))
                    {
                        <md-icon slot="end">@option.TrailingIcon</md-icon>
                    }
                </md-select-option>
            }
        }
        else
        {
            @ChildContent
        }
    </md-filled-select>
}
else
{
    <md-outlined-select id=@Id
                        label=@Label
                        value=@CurrentValueAsString
                        supporting-text=@GetSupportingText()
                        error-text=@GetErrorText()
                        @attributes=AdditionalAttributes
                        disabled=@Disabled
                        required=@Required
                        error=@HasValidationErrors
                        quick=@Quick
                        no-asterisk=@NoAsterisk
                        menu-positioning=@MenuPositioning
                        clamp-menu-width=@ClampMenuWidth
                        typeahead-delay=@TypeaheadDelay
                        has-leading-icon=@HasLeadingIcon
                        menu-align=@MenuAlign
                        @ref=selectElement
                        @oninput=@HandleInput
                        @onchange=@HandleChange
                        @opening=@OnOpening
                        @opened=@OnOpened
                        @closing=@OnClosing
                        @closed=@OnClosed>
        @if (HasLeadingIcon)
        {
            <md-icon slot="leading-icon">@LeadingIcon</md-icon>
        }
        @if (Options != null && Options.Any())
        {
            @foreach (var option in Options)
            {
                <md-select-option value=@option.Value 
                                  headline=@option.Text
                                  selected=@(option.Value == CurrentValueAsString)>
                    @if (!string.IsNullOrEmpty(option.SupportingText))
                    {
                        <span slot="supporting-text">@option.SupportingText</span>
                    }
                    @if (!string.IsNullOrEmpty(option.TrailingText))
                    {
                        <span slot="trailing-supporting-text">@option.TrailingText</span>
                    }
                    @if (!string.IsNullOrEmpty(option.LeadingIcon))
                    {
                        <md-icon slot="start">@option.LeadingIcon</md-icon>
                    }
                    @if (!string.IsNullOrEmpty(option.TrailingIcon))
                    {
                        <md-icon slot="end">@option.TrailingIcon</md-icon>
                    }
                </md-select-option>
            }
        }
        else
        {
            @ChildContent
        }
    </md-outlined-select>
}
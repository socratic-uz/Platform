@using Microsoft.AspNetCore.Components.Web

@{
    var cssClass = $"{(Expressive ? "expressive" : "")} {(Pill ? "pill" : "")} {GetCustomClass()}".Trim();
}

@switch (Variant)
{
    case ButtonVariant.Elevated:
        <md-elevated-button class="@cssClass" disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" @attributes="FilteredAttributes" @onclick="OnClick">
            @RenderButtonContent()
        </md-elevated-button>
        break;
    case ButtonVariant.FilledTonal:
        <md-filled-tonal-button class="@cssClass" disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" @attributes="FilteredAttributes" @onclick="OnClick">
            @RenderButtonContent()
        </md-filled-tonal-button>
        break;
    case ButtonVariant.Outlined:
        <md-outlined-button class="@cssClass" disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" @attributes="FilteredAttributes" @onclick="OnClick">
            @RenderButtonContent()
        </md-outlined-button>
        break;
    case ButtonVariant.Text:
        <md-text-button class="@cssClass" disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" @attributes="FilteredAttributes" @onclick="OnClick">
            @RenderButtonContent()
        </md-text-button>
        break;
    case ButtonVariant.Filled:
    default:
        <md-filled-button class="@cssClass" disabled="@Disabled" href="@Href" target="@Target" type="@Type" aria-label="@AriaLabel" @attributes="FilteredAttributes" @onclick="OnClick">
            @RenderButtonContent()
        </md-filled-button>
        break;
}

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Filled;
    [Parameter] public bool Expressive { get; set; } = true;
    [Parameter] public bool Pill { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? TrailingIcon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string GetCustomClass()
    {
        if (AdditionalAttributes != null && AdditionalAttributes.TryGetValue("class", out var cls) && cls != null)
        {
            return cls.ToString() ?? "";
        }
        return "";
    }

    private IDictionary<string, object>? FilteredAttributes
    {
        get
        {
            if (AdditionalAttributes == null) return null;
            var copy = new Dictionary<string, object>(AdditionalAttributes);
            copy.Remove("class");
            return copy;
        }
    }

    private RenderFragment RenderButtonContent() => __builder =>
    {
        if (!string.IsNullOrEmpty(Icon))
        {
            <md-icon slot="icon">@Icon</md-icon>
        }
        @ChildContent
        if (!string.IsNullOrEmpty(TrailingIcon))
        {
            <md-icon slot="trailing-icon">@TrailingIcon</md-icon>
        }
    };
}

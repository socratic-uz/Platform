@using Microsoft.AspNetCore.Components.Web

@switch (Variant)
{
    case ButtonVariant.Elevated:
        <md-elevated-button disabled=@Disabled href=@Href target=@Target type=@Type aria-label=@AriaLabel @attributes="FilteredAttributes" @onclick=@OnClick>
            @RenderButtonContent()
        </md-elevated-button>
        break;
    case ButtonVariant.FilledTonal:
        <md-filled-tonal-button disabled=@Disabled href=@Href target=@Target type=@Type aria-label=@AriaLabel @attributes="FilteredAttributes" @onclick=@OnClick>
            @RenderButtonContent()
        </md-filled-tonal-button>
        break;
    case ButtonVariant.Outlined:
        <md-outlined-button disabled=@Disabled href=@Href target=@Target type=@Type aria-label=@AriaLabel @attributes="FilteredAttributes" @onclick=@OnClick>
            @RenderButtonContent()
        </md-outlined-button>
        break;
    case ButtonVariant.Text:
        <md-text-button disabled=@Disabled href=@Href target=@Target type=@Type aria-label=@AriaLabel @attributes="FilteredAttributes" @onclick=@OnClick>
            @RenderButtonContent()
        </md-text-button>
        break;
    case ButtonVariant.Filled:
    default:
        <md-filled-button disabled=@Disabled href=@Href target=@Target type=@Type aria-label=@AriaLabel @attributes="FilteredAttributes" @onclick=@OnClick>
            @RenderButtonContent()
        </md-filled-button>
        break;
}

@namespace Material.Web.Components
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant

@if (Compact)
{
    <section color-picker-compact disabled=@Disabled>
        <!-- Color Swatch & Native Color Trigger -->
        <input type="color"
               title=@L[ColorPickerClickToSelect]
               value=@HexValue
               disabled=@Disabled
               @onchange=@OnNativeColorChanged
               @oninput=@OnNativeColorInput />

        <!-- Text Input for HEX -->
        <TextField TValue=string
                   Placeholder="RRGGBB"
                   PrefixText="#"
                   Value=@RawHexValue
                   Disabled=@Disabled
                   ValueChanged=@OnHexTextChangedAsync
                   ValueExpression=@(() => RawHexValue) />

        <IconButton Disabled=@Disabled
                    AriaLabel=@(isCopied ? L[ColorPickerCopied] : L[ColorPickerCopyHex])
                    OnClick=@CopyColorAsync>@(isCopied ? Check : ContentCopy)</IconButton>

        @if (ShowPresets)
        {
            <IconButton Disabled=@Disabled
                        Selected=@isPaletteOpen
                        Toggle=@true
                        AriaLabel=@L[ColorPickerPalettePresets]
                        OnClick=@TogglePalette>@Palette</IconButton>
        }

        @if (HasValue)
        {
            <IconButton Disabled=@Disabled
                        AriaLabel=@L[ColorPickerResetColor]
                        OnClick=@Clear>@Close</IconButton>
        }
    </section>
}
else
{
    <!-- Unified Base Picker Trigger Card -->
    <PickerTriggerCard Label=@EffectiveLabel
                       HasValue=@HasValue
                       BadgeText=@NormalizedValue
                       BadgeIcon=@Colorize
                       PreviewText=@GetPreviewText()
                       ActionLabel=@(isPaletteOpen ? L[ColorPickerClosePalette] : L[ColorPickerPalette])
                       ActionIcon=@Palette
                       OnAction=@TogglePalette
                       ResetAriaLabel=@L[ColorPickerResetColor]
                       OnReset=@Clear
                       Disabled=@Disabled>
        <CustomIconBadge>
            <span @attributes=@GetSwatchAttributes(NormalizedValue)>
                <input type="color"
                       value=@HexValue
                       disabled=@Disabled
                       @onchange=@OnNativeColorChanged
                       @oninput=@OnNativeColorInput />
            </span>
        </CustomIconBadge>

        <CustomActions>
            <Button Variant=@FilledTonal Icon=@Palette OnClick=@TogglePalette Disabled=@Disabled>
                @(isPaletteOpen ? L[ColorPickerClosePalette] : L[ColorPickerPalette])
            </Button>

            <IconButton Icon=@(isCopied ? Check : ContentCopy)
                        Disabled=@Disabled
                        AriaLabel=@L[ColorPickerCopyHex]
                        OnClick=@CopyColorAsync />

            @if (HasValue)
            {
                <IconButton Icon=@Close
                            Disabled=@Disabled
                            AriaLabel=@L[ColorPickerResetColor]
                            OnClick=@Clear />
            }
        </CustomActions>
    </PickerTriggerCard>
}

<!-- Presets Popover / Dialog -->
@if (ShowPresets && isPaletteOpen)
{
    <MaterialDialog Open=@isPaletteOpen OnClose=@ClosePalette color-picker-popover>
        <Headline>
            <span>@L[ColorPickerRecommendedColors]</span>
            <IconButton Icon=@Close AriaLabel=@L[ColorPickerClosePalette] OnClick=@ClosePalette />
        </Headline>
        <Content>
            <menu>
                @foreach (var color in EffectivePresets)
                {
                    var isSelected = string.Equals(NormalizedValue, color, StringComparison.OrdinalIgnoreCase);
                    <IconButton Selected=@isSelected
                            @attributes=@GetSwatchAttributes(color)
                            AriaLabel=@color
                            OnClick=@(() => SelectPreset(color))>
                        @if (isSelected)
                        {
                            <Icon Name=@Check />
                        }
                    </IconButton>
                }
            </menu>
        </Content>
        <Actions>
            <TextField TValue=string
                       Placeholder="RRGGBB"
                       PrefixText="#"
                       Value=@RawHexValue
                       Disabled=@Disabled
                       ValueChanged=@OnHexTextChangedAsync
                       ValueExpression=@(() => RawHexValue) />
            @if (HasValue)
            {
                <Button Variant=@Text Icon=@RestartAlt OnClick=@Clear>
                    @L[ResetAction]
                </Button>
            }
        </Actions>
    </MaterialDialog>
}

@namespace Material.Web.Components
@using Assets.Constants
@using static Assets.Constants.Icons
@using static Assets.Constants.Classes.Picker
@using static Assets.Constants.Classes.Common
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Actions
@using static Assets.Constants.Formats
@using static Material.Web.Components.ButtonVariant

@if (Compact)
{
    <section class=@CompactBoxClass>
        <!-- Color Swatch & Native Color Trigger -->
        <input type="color"
               class=@string.Format(Two, SwatchWrapper, Swatch)
               title=@L[ColorPickerClickToSelect]
               value=@HexValue
               disabled=@Disabled
               @onchange=@OnNativeColorChanged
               @oninput=@OnNativeColorInput />

        <!-- Text Input for HEX -->
        <span class=@HexPrefix>#</span>
        <input type="text"
               class=@string.Format(Two, HexWrapper, HexInput)
               placeholder="RRGGBB"
               value=@RawHexValue
               disabled=@Disabled
               @onchange=@OnTextInputChanged />

        <md-icon-button disabled=@Disabled
                        aria-label=@(isCopied ? L[ColorPickerCopied] : L[ColorPickerCopyHex])
                        @onclick=@CopyColorAsync>@(isCopied ? Check : ContentCopy)</md-icon-button>

        @if (ShowPresets)
        {
            <md-icon-button disabled=@Disabled
                            selected=@isPaletteOpen
                            toggle
                            aria-label=@L[ColorPickerPalettePresets]
                            @onclick=@TogglePalette>@Palette</md-icon-button>
        }

        @if (HasValue)
        {
            <md-icon-button disabled=@Disabled
                            aria-label=@L[ColorPickerResetColor]
                            @onclick=@Clear>@Close</md-icon-button>
        }
    </section>
}
else
{
    <!-- Unified Base Picker Trigger Card -->
    <PickerTriggerCard Label=@EffectiveLabel
                       HasValue=@HasValue
                       BadgeText=@NormalizedValue
                       BadgeIcon=@Colorize
                       PreviewText=@GetPreviewText()
                       ActionLabel=@(isPaletteOpen ? L[ColorPickerClosePalette] : L[ColorPickerPalette])
                       ActionIcon=@Palette
                       OnAction=@TogglePalette
                       ResetAriaLabel=@L[ColorPickerResetColor]
                       OnReset=@Clear
                       Disabled=@Disabled
                       Class=@CssClass>
        <CustomIconBadge>
            <span class=@ColorBadgeSwatch @attributes=@GetSwatchAttributes(NormalizedValue)>
                <input type="color"
                       class=@NativeInput
                       value=@HexValue
                       disabled=@Disabled
                       @onchange=@OnNativeColorChanged
                       @oninput=@OnNativeColorInput />
            </span>
        </CustomIconBadge>

        <CustomActions>
            <Button Variant=@FilledTonal OnClick=@TogglePalette Disabled=@Disabled>
                <md-icon slot="icon">@Palette</md-icon>
                @(isPaletteOpen ? L[ColorPickerClosePalette] : L[ColorPickerPalette])
            </Button>

            <IconButton Icon=@(isCopied ? Check : ContentCopy)
                        Disabled=@Disabled
                        AriaLabel=@L[ColorPickerCopyHex]
                        OnClick=@CopyColorAsync />

            @if (HasValue)
            {
                <IconButton Icon=@Close
                            Disabled=@Disabled
                            AriaLabel=@L[ColorPickerResetColor]
                            OnClick=@Clear />
            }
        </CustomActions>
    </PickerTriggerCard>
}

<!-- Presets Popover / Dialog -->
@if (ShowPresets && isPaletteOpen)
{
    <dialog class=@PopoverPanel open>
        <header class=@PopoverHeader>
            <span class=@PopoverTitle>@L[ColorPickerRecommendedColors]</span>
            <IconButton Icon=@Close AriaLabel=@L[ColorPickerClosePalette] OnClick=@ClosePalette />
        </header>
        <menu class=@PaletteGrid>
            @foreach (var color in EffectivePresets)
            {
                var isSelected = string.Equals(NormalizedValue, color, StringComparison.OrdinalIgnoreCase);
                <IconButton class=@GetPaletteSwatchClass(isSelected)
                        @attributes=@GetSwatchAttributes(color)
                        AriaLabel=@color
                        OnClick=@(() => SelectPreset(color))>
                    @if (isSelected)
                    {
                        <md-icon class=@SwatchCheck>@Check</md-icon>
                    }
                </IconButton>
            }
        </menu>
        <footer class=@PopoverFooter>
            <span class=@HexCompactClass>
                <span class=@HexPrefix>#</span>
                <input type="text"
                       class=@HexInput
                       placeholder="RRGGBB"
                       value=@RawHexValue
                       disabled=@Disabled
                       @onchange=@OnTextInputChanged />
            </span>
            @if (HasValue)
            {
                <Button Variant=@Text OnClick=@Clear>
                    <md-icon slot="icon">@RestartAlt</md-icon>
                    @L[ResetAction]
                </Button>
            }
        </footer>
    </dialog>
}

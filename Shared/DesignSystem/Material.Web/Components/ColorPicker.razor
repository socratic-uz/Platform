@namespace Material.Web.Components
@using Assets.Constants
@using static Assets.Constants.Classes.Picker
@using static Assets.Constants.Classes.Common
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant

@if (Compact)
{
    <div class="@($"{CompactBox} {CssClass} {(Disabled ? Disabled : "")}")">
        <!-- Color Swatch & Native Color Trigger -->
        <div class=@SwatchWrapper title=@L[ColorPickerClickToSelect]>
            <div class=@Swatch @attributes=@GetSwatchAttributes(NormalizedValue)>
                <input type="color"
                       class=@NativeInput
                       value="@HexValue"
                       disabled=@Disabled
                       @onchange=@OnNativeColorChanged
                       @oninput=@OnNativeColorInput />
            </div>
        </div>

        <!-- Text Input for HEX -->
        <div class=@HexWrapper>
            <span class=@HexPrefix>#</span>
            <input type="text"
                   class=@HexInput
                   placeholder="RRGGBB"
                   value="@RawHexValue"
                   disabled=@Disabled
                   @onchange=@OnTextInputChanged />
        </div>

        <IconButton Icon=@(isCopied ? Icons.Check : Icons.ContentCopy)
                    Disabled=@Disabled
                    AriaLabel=@(isCopied ? L[ColorPickerCopied] : L[ColorPickerCopyHex])
                    OnClick=@CopyColorAsync />

        @if (ShowPresets)
        {
            <IconButton Icon=@Icons.Palette
                        Disabled=@Disabled
                        Selected=@isPaletteOpen
                        Toggle=@true
                        AriaLabel=@L[ColorPickerPalettePresets]
                        OnClick=@TogglePalette />
        }

        @if (HasValue)
        {
            <IconButton Icon=@Icons.Close
                        Disabled=@Disabled
                        AriaLabel=@L[ColorPickerResetColor]
                        OnClick=@Clear />
        }
    </div>
}
else
{
    <!-- Unified Base Picker Trigger Card -->
    <PickerTriggerCard Label=@EffectiveLabel
                       HasValue=@HasValue
                       BadgeText="@NormalizedValue"
                       BadgeIcon=@Icons.Colorize
                       PreviewText=@GetPreviewText()
                       ActionLabel=@(isPaletteOpen ? L[ColorPickerClosePalette] : L[ColorPickerPalette])
                       ActionIcon=@Icons.Palette
                       OnAction=@TogglePalette
                       ResetAriaLabel=@L[ColorPickerResetColor]
                       OnReset=@Clear
                       Disabled=@Disabled
                       Class="@CssClass">
        <CustomIconBadge>
            <div class=@ColorBadgeSwatch @attributes=@GetSwatchAttributes(NormalizedValue)>
                <input type="color"
                       class=@NativeInput
                       value="@HexValue"
                       disabled=@Disabled
                       @onchange=@OnNativeColorChanged
                       @oninput=@OnNativeColorInput />
            </div>
        </CustomIconBadge>

        <CustomActions>
            <Button Variant=@FilledTonal OnClick=@TogglePalette Disabled=@Disabled>
                <md-icon slot="icon">@Icons.Palette</md-icon>
                @(isPaletteOpen ? L[ColorPickerClosePalette] : L[ColorPickerPalette])
            </Button>

            <IconButton Icon=@(isCopied ? Icons.Check : Icons.ContentCopy)
                        Disabled=@Disabled
                        AriaLabel=@L[ColorPickerCopyHex]
                        OnClick=@CopyColorAsync />

            @if (HasValue)
            {
                <IconButton Icon=@Icons.Close
                            Disabled=@Disabled
                            AriaLabel=@L[ColorPickerResetColor]
                            OnClick=@Clear />
            }
        </CustomActions>
    </PickerTriggerCard>
}

<!-- Presets Popover / Dialog -->
@if (ShowPresets && isPaletteOpen)
{
    <div class=@PopoverPanel>
        <div class=@PopoverHeader>
            <span class=@PopoverTitle>@L[ColorPickerRecommendedColors]</span>
            <IconButton Icon=@Icons.Close AriaLabel=@L[ColorPickerClosePalette] OnClick=@ClosePalette />
        </div>
        <div class=@PaletteGrid>
            @foreach (var color in EffectivePresets)
            {
                var isSelected = string.Equals(NormalizedValue, color, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="@($"{PaletteSwatch} {(isSelected ? "selected" : "")}")"
                        @attributes=@GetSwatchAttributes(color)
                        title="@color"
                        @onclick=@(() => SelectPreset(color))>
                    @if (isSelected)
                    {
                        <md-icon class=@SwatchCheck>@Icons.Check</md-icon>
                    }
                </button>
            }
        </div>
        <div class=@PopoverFooter>
            <div class="@($"{HexWrapper} m3-hex-compact")">
                <span class=@HexPrefix>#</span>
                <input type="text"
                       class=@HexInput
                       placeholder="RRGGBB"
                       value="@RawHexValue"
                       disabled=@Disabled
                       @onchange=@OnTextInputChanged />
            </div>
            @if (HasValue)
            {
                <Button Variant=@Text OnClick=@Clear>
                    <md-icon slot="icon">@Icons.RestartAlt</md-icon>
                    @L[ResetAction]
                </Button>
            }
        </div>
    </div>
}

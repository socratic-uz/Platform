@namespace Material.Web.Components.Labs

@if (Type == "filled")
{
    <md-filled-card disabled=@Disabled @attributes="FilteredAttributes">
        @ChildContent
    </md-filled-card>
}
else if (Type == "outlined")
{
    <md-outlined-card disabled=@Disabled @attributes="FilteredAttributes">
        @ChildContent
    </md-outlined-card>
}
else
{
    <md-elevated-card disabled=@Disabled @attributes="FilteredAttributes">
        @ChildContent
    </md-elevated-card>
}

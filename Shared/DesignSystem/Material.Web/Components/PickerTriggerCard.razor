@namespace Material.Web.Components
@using Microsoft.AspNetCore.Components.Web
@using Material.Web
@using Assets.Constants

<div class="@Classes.Picker.TriggerCard @(Disabled ? Classes.Picker.Disabled : "") @(HasValue ? "has-value" : "empty") @Class" style="@Style">
    <div class="@Classes.Picker.TriggerLeft">
        <!-- Icon Badge (44x44px, R12) -->
        <div class="@Classes.Picker.IconBadge @(HasValue ? Classes.Picker.Active : "")">
            @if (CustomIconBadge != null)
            {
                @CustomIconBadge
            }
            else
            {
                <md-icon>@(HasValue ? (ActiveIcon ?? Icon) : Icon)</md-icon>
            }
        </div>

        <!-- Text & Preview Area -->
        <div class="@Classes.Picker.TriggerText">
            <div class="@Classes.Picker.HeaderRow">
                <span class="@Classes.Picker.TriggerTitle">@Label</span>
                @if (HasValue && !string.IsNullOrWhiteSpace(BadgeText))
                {
                    <span class="@Classes.Picker.Badge">
                        @if (!string.IsNullOrEmpty(BadgeIcon))
                        {
                            <md-icon>@BadgeIcon</md-icon>
                        }
                        @BadgeText
                    </span>
                }
            </div>
            <div class="@Classes.Picker.PreviewText" title="@PreviewText">
                @PreviewText
            </div>
            @if (CustomPreview != null)
            {
                <div class="@Classes.Picker.CustomPreview">
                    @CustomPreview
                </div>
            }
        </div>
    </div>

    <!-- Actions Panel -->
    <div class="@Classes.Picker.TriggerActions">
        @if (CustomActions != null)
        {
            @CustomActions
        }
        else if (!string.IsNullOrEmpty(ActionLabel))
        {
            <Button Variant="ButtonVariant.FilledTonal" OnClick="HandleAction" Disabled="@Disabled">
                @if (!string.IsNullOrEmpty(ActionIcon))
                {
                    <md-icon slot="icon">@ActionIcon</md-icon>
                }
                @ActionLabel
            </Button>
        }

        @if (HasValue && ShowResetButton)
        {
            <IconButton Icon="@ResetIcon"
                        AriaLabel="@ResetAriaLabel"
                        Disabled="@Disabled"
                        OnClick="HandleReset" />
        }
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Выбор";
    [Parameter] public string Icon { get; set; } = Icons.Tune;
    [Parameter] public string? ActiveIcon { get; set; }
    [Parameter] public RenderFragment? CustomIconBadge { get; set; }

    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string? BadgeIcon { get; set; }

    [Parameter] public string? PreviewText { get; set; }
    [Parameter] public RenderFragment? CustomPreview { get; set; }

    [Parameter] public string? ActionLabel { get; set; } = "Выбрать";
    [Parameter] public string? ActionIcon { get; set; } = Icons.Edit;
    [Parameter] public EventCallback<MouseEventArgs> OnAction { get; set; }

    [Parameter] public bool HasValue { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;

    [Parameter] public bool ShowResetButton { get; set; } = true;
    [Parameter] public string ResetIcon { get; set; } = Icons.Close;
    [Parameter] public string ResetAriaLabel { get; set; } = "Сбросить значение";
    [Parameter] public EventCallback OnReset { get; set; }

    [Parameter] public RenderFragment? CustomActions { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private async Task HandleAction(MouseEventArgs e)
    {
        if (Disabled) return;
        await OnAction.InvokeAsync(e);
    }

    private async Task HandleReset()
    {
        if (Disabled) return;
        await OnReset.InvokeAsync();
    }
}

@namespace Material.Web.Components
@using Microsoft.AspNetCore.Components.Web
@using Material.Web
@using static Assets.Constants.Classes.Picker
@using static Assets.Constants.Icons
@using static Material.Web.Components.ButtonVariant

<article class=@CardClasses>
    <!-- Icon Badge (44x44px, R12) -->
    <span class=@BadgeClasses>
        @if (CustomIconBadge != null)
        {
            @CustomIconBadge
        }
        else
        {
            <Icon Name=@(HasValue ? (ActiveIcon ?? Icon) : Icon) />
        }
    </span>

    <!-- Text & Preview Area -->
    <section class=@TriggerText>
        <header class=@HeaderRow>
            <span class=@TriggerTitle>@Label</span>
            @if (HasValue && !string.IsNullOrWhiteSpace(BadgeText))
            {
                <span class=@TagBadge>
                    @if (!string.IsNullOrEmpty(BadgeIcon))
                    {
                        <Icon Name=@BadgeIcon />
                    }
                    @BadgeText
                </span>
            }
        </header>
        <p class=@PreviewText title=@PreviewText>
            @PreviewText
        </p>
        @if (CustomPreview != null)
        {
            <section class=@CustomPreview>
                @CustomPreview
            </section>
        }
    </section>

    <!-- Actions Panel -->
    <footer class=@TriggerActions>
        @if (CustomActions != null)
        {
            @CustomActions
        }
        else
        {
            <Button Variant=@FilledTonal Icon=@ActionIcon OnClick=@OnAction Disabled=@Disabled>
                @ActionLabel
            </Button>
            @if (HasValue && OnReset.HasDelegate)
            {
                <IconButton Icon=@Close
                            Disabled=@Disabled
                            AriaLabel=@ResetAriaLabel
                            OnClick=@OnReset />
            }
        }
    </footer>
</article>

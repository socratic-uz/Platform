@namespace Material.Web.Components
@using Microsoft.AspNetCore.Components.Web
@using Material.Web
@using static Assets.Constants.Classes.Picker
@using static Material.Web.Components.ButtonVariant

<div class=@($"{TriggerCard} {(Disabled ? Disabled : "")} {(HasValue ? "has-value" : "empty")} {Class}")>
    <div class=@TriggerLeft>
        <!-- Icon Badge (44x44px, R12) -->
        <div class=@($"{IconBadge} {(HasValue ? Active : "")}")>
            @if (CustomIconBadge != null)
            {
                @CustomIconBadge
            }
            else
            {
                <Icon Name=@(HasValue ? (ActiveIcon ?? Icon) : Icon) />
            }
        </div>

        <!-- Text & Preview Area -->
        <div class=@TriggerText>
            <div class=@HeaderRow>
                <span class=@TriggerTitle>@Label</span>
                @if (HasValue && !string.IsNullOrWhiteSpace(BadgeText))
                {
                    <span class=@Badge>
                        @if (!string.IsNullOrEmpty(BadgeIcon))
                        {
                            <Icon Name=@BadgeIcon />
                        }
                        @BadgeText
                    </span>
                }
            </div>
            <div class=@PreviewText title=@PreviewText>
                @PreviewText
            </div>
            @if (CustomPreview != null)
            {
                <div class=@CustomPreview>
                    @CustomPreview
                </div>
            }
        </div>
    </div>

    <!-- Actions Panel -->
    <div class=@TriggerActions>
        @if (CustomActions != null)
        {
            @CustomActions
        }
        else if (!string.IsNullOrEmpty(ActionLabel))
        {
            <Button Variant=@FilledTonal OnClick=@HandleAction Disabled=@Disabled Icon=@ActionIcon>
                @ActionLabel
            </Button>
        }

        @if (HasValue && ShowResetButton)
        {
            <IconButton Icon=@ResetIcon
                        AriaLabel=@ResetAriaLabel
                        Disabled=@Disabled
                        OnClick=@HandleReset />
        }
    </div>
</div>

@namespace Material.Web.Components
@using Microsoft.AspNetCore.Components.Web
@using Material.Web
@using static Assets.Constants.Icons
@using static Material.Web.Components.ButtonVariant

<article picker-trigger data-filled=@(HasValue ? "true" : null) disabled=@Disabled>
    <!-- Icon Badge (44x44px, R12) -->
    <span data-active=@(HasValue ? "true" : null)>
        @if (CustomIconBadge != null)
        {
            @CustomIconBadge
        }
        else
        {
            <Icon Name=@(HasValue ? (ActiveIcon ?? Icon) : Icon) />
        }
    </span>

    <!-- Text & Preview Area -->
    <section>
        <header>
            <span>@Label</span>
            @if (HasValue && !string.IsNullOrWhiteSpace(BadgeText))
            {
                <span>
                    @if (!string.IsNullOrEmpty(BadgeIcon))
                    {
                        <Icon Name=@BadgeIcon />
                    }
                    @BadgeText
                </span>
            }
        </header>
        <p title=@PreviewText>
            @PreviewText
        </p>
        @if (CustomPreview != null)
        {
            <section>
                @CustomPreview
            </section>
        }
    </section>

    <!-- Actions Panel -->
    <footer>
        @if (CustomActions != null)
        {
            @CustomActions
        }
        else
        {
            <Button Variant=@FilledTonal Icon=@ActionIcon OnClick=@OnAction Disabled=@Disabled>
                @ActionLabel
            </Button>
            @if (HasValue && OnReset.HasDelegate)
            {
                <IconButton Icon=@Close
                            Disabled=@Disabled
                            AriaLabel=@ResetAriaLabel
                            OnClick=@OnReset />
            }
        }
    </footer>
</article>

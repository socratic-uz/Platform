@using Microsoft.AspNetCore.Components.Web

@if (Branded)
{
    <md-branded-fab label="@Label" size="@Size" variant="@Variant" lowered="@Lowered" @attributes="AdditionalAttributes" @onclick="OnClick">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <md-icon slot="icon">@Icon</md-icon>
        }
        @ChildContent
    </md-branded-fab>
}
else
{
    <md-fab label="@Label" size="@Size" variant="@Variant" lowered="@Lowered" @attributes="AdditionalAttributes" @onclick="OnClick">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <md-icon slot="icon">@Icon</md-icon>
        }
        @ChildContent
    </md-fab>
}

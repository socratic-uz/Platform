    // Переопределение базовых методов InputBase
    protected override bool TryParseValueFromString(string? value, out TValue result, out string? validationErrorMessage)
    {
        result = default!;
        validationErrorMessage = null;

        // Handle null or empty values
        if (string.IsNullOrEmpty(value))
        {
            if (Required)
            {
                validationErrorMessage = "Поле обязательно для заполнения";
                return false;
            }

            // For nullable types, return default value
            if (typeof(TValue) == typeof(string) || Nullable.GetUnderlyingType(typeof(TValue)) != null)
            {
                result = default!;
                return true;
            }

            validationErrorMessage = "Поле обязательно для заполнения";
            return false;
        }

        // Try to convert the value based on the target type
        var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

        try
        {
            if (targetType == typeof(string))
            {
                result = (TValue)(object)value;
                return ValidateStringValue(value, out validationErrorMessage);
            }
            else if (targetType == typeof(int))
            {
                if (int.TryParse(value, out var intValue))
                {
                    result = (TValue)(object)intValue;
                    return true;
                }
            }
            else if (targetType == typeof(long))
            {
                if (long.TryParse(value, out var longValue))
                {
                    result = (TValue)(object)longValue;
                    return true;
                }
            }
            else if (targetType == typeof(decimal))
            {
                if (decimal.TryParse(value, CultureInfo.InvariantCulture, out var decimalValue))
                {
                    result = (TValue)(object)decimalValue;
                    return true;
                }
            }
            else if (targetType == typeof(double))
            {
                if (double.TryParse(value, out var doubleValue))
                {
                    result = (TValue)(object)doubleValue;
                    return true;
                }
            }
            else if (targetType == typeof(float))
            {
                if (float.TryParse(value, out var floatValue))
                {
                    result = (TValue)(object)floatValue;
                    return true;
                }
            }
            else if (targetType == typeof(DateTime))
            {
                if (DateTime.TryParse(value, out var dateValue))
                {
                    result = (TValue)(object)dateValue;
                    return true;
                }
            }
            else if (targetType == typeof(DateOnly))
            {
                if (DateOnly.TryParse(value, out var dateOnlyValue))
                {
                    result = (TValue)(object)dateOnlyValue;
                    return true;
                }
            }
            else if (targetType == typeof(TimeOnly))
            {
                if (TimeOnly.TryParse(value, out var timeOnlyValue))
                {
                    result = (TValue)(object)timeOnlyValue;
                    return true;
                }
            }
            else if (targetType == typeof(Timestamp))
            {
                if (DateTimeOffset.TryParse(value, out var dateTimeOffsetValue))
                {
					var timestampValue = Timestamp.FromDateTimeOffset(dateTimeOffsetValue);
					result = (TValue)(object)timestampValue;
                    return true;
                }
            }
            else if (targetType == typeof(DateTimeOffset))
            {
                if (DateTimeOffset.TryParse(value, out var dateTimeOffsetValue))
                {
                    result = (TValue)(object)dateTimeOffsetValue;
                    return true;
                }
			}
            else if (targetType == typeof(Guid))
            {
                if (Guid.TryParse(value, out var guidValue))
                {
                    result = (TValue)(object)guidValue;
                    return true;
                }
            }
            else if (targetType.IsEnum)
            {
                if (Enum.TryParse(targetType, value, true, out var enumValue))
                {
                    result = (TValue)enumValue!;
                    return true;
                }
            }
            else
            {
                // Try generic conversion for other types
                var convertedValue = Convert.ChangeType(value, targetType, CultureInfo.InvariantCulture);
                result = (TValue)convertedValue;
                return true;
            }
        }
        catch (Exception ex)
        {
            validationErrorMessage = $"Невозможно преобразовать значение: {ex.Message}";
            return false;
        }

        validationErrorMessage = $"Невозможно преобразовать '{value}' в тип {typeof(TValue).Name}";
        return false;
    }

    private bool ValidateStringValue(string value, out string? validationErrorMessage)
    {
        validationErrorMessage = null;

        // Валидация по типу поля
        switch (Type.ToLowerInvariant())
        {
            case "email":
                if (!IsValidEmail(value))
                {
                    validationErrorMessage = "Неверный формат email адреса";
                    return false;
                }
                break;
            case "url":
                if (!Uri.TryCreate(value, UriKind.Absolute, out _))
                {
                    validationErrorMessage = "Неверный формат URL";
                    return false;
                }
                break;
            case "tel":
                if (!IsValidPhoneNumber(value))
                {
                    validationErrorMessage = "Неверный формат номера телефона";
                    return false;
                }
                break;
        }

        // Валидация по паттерну
        if (!string.IsNullOrEmpty(Pattern))
        {
            if (!System.Text.RegularExpressions.Regex.IsMatch(value, Pattern))
            {
                validationErrorMessage = "Значение не соответствует требуемому формату";
                return false;
            }
        }

        // Валидация длины
        if (MinLength.HasValue && value.Length < MinLength.Value)
        {
            validationErrorMessage = $"Минимальная длина: {MinLength.Value} символов";
            return false;
        }

        if (MaxLength.HasValue && value.Length > MaxLength.Value)
        {
            validationErrorMessage = $"Максимальная длина: {MaxLength.Value} символов";
            return false;
        }

        return true;
    }

    protected override string? FormatValueAsString(TValue? value)
    {
        if (value == null)
            return null;

        // Handle different value types appropriately
        if (value is DateTime dateTime)
        {
            return Type.ToLowerInvariant() switch
            {
                "date" => dateTime.ToString("yyyy-MM-dd"),
                "datetime-local" => dateTime.ToString("yyyy-MM-ddTHH:mm"),
                "time" => dateTime.ToString("HH:mm"),
                _ => dateTime.ToString(CultureInfo.InvariantCulture)
            };
        }
        else if (value is DateOnly dateOnly)
        {
            return dateOnly.ToString("yyyy-MM-dd");
        }
        else if (value is TimeOnly timeOnly)
        {
            return timeOnly.ToString("HH:mm");
        }
        else if (value is decimal || value is double || value is float)
        {
            return value.ToString();
        }
        else
        {
            return value.ToString();
        }
    }

    // Ã‚Ã±Ã¯Ã®Ã¬Ã®Ã£Ã Ã²Ã¥Ã«Ã¼Ã­Ã»Ã¥ Ã¬Ã¥Ã²Ã®Ã¤Ã» Ã¢Ã Ã«Ã¨Ã¤Ã Ã¶Ã¨Ã¨
    private static bool IsValidEmail(string email)
    {
        try
        {
            var mail = new System.Net.Mail.MailAddress(email);
            return mail.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private static bool IsValidPhoneNumber(string phone)
    {
        // ÃÃ°Ã®Ã±Ã²Ã Ã¿ Ã¯Ã°Ã®Ã¢Ã¥Ã°ÃªÃ  Ã²Ã¥Ã«Ã¥Ã´Ã®Ã­Ã  (Ã¬Ã®Ã¦Ã­Ã® Ã°Ã Ã±Ã¸Ã¨Ã°Ã¨Ã²Ã¼)
        return System.Text.RegularExpressions.Regex.IsMatch(phone, @"^[\+]?[0-9\s\-\(\)]{7,15}$");
    }


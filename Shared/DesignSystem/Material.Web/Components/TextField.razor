    // Ã‘Ã¢Ã®Ã©Ã±Ã²Ã¢Ã® Ã¤Ã«Ã¿ Ã¯Ã°Ã®Ã¢Ã¥Ã°ÃªÃ¨ Ã­Ã Ã«Ã¨Ã·Ã¨Ã¿ Ã®Ã¸Ã¨Ã¡Ã®Ãª Ã¢Ã Ã«Ã¨Ã¤Ã Ã¶Ã¨Ã¨
    private bool HasValidationErrors => EditContext?.GetValidationMessages(FieldIdentifier).Any() == true;

    // CSS ÃªÃ«Ã Ã±Ã± Ã± Ã³Ã·Ã¥Ã²Ã®Ã¬ Ã¤Ã®Ã¯Ã®Ã«Ã­Ã¨Ã²Ã¥Ã«Ã¼Ã­Ã»Ãµ ÃªÃ«Ã Ã±Ã±Ã®Ã¢

@using System.Linq.Expressions
@using Google.Protobuf.WellKnownTypes
@using Microsoft.AspNetCore.Components.Forms
@typeparam TValue
@inherits InputBase<TValue>

@if (Variant == TextFieldVariant.Filled)
{
    <md-filled-text-field id="@Id"
                          class="@CssClass material-text-field"
                          label="@Label"
                          value="@CurrentValueAsString"
                          type="@Type"
                          placeholder="@Placeholder"
                          prefix-text="@PrefixText"
                          suffix-text="@SuffixText"
                          supporting-text="@GetSupportingText()"
                          error-text="@GetErrorText()"
                          rows="@Rows"
                          cols="@Cols"
                          max="@Max"
                          maxlength="@MaxLength"
                          min="@Min"
                          minlength="@MinLength"
                          pattern="@Pattern"
                          step="@Step"
                          inputmode="@InputMode"
                          autocomplete="@Autocomplete"
                          text-direction="@TextDirection"
                          count="@(ShowCharacterCount ? CurrentValueAsString?.Length : null)"
                          @attributes="AdditionalAttributes"
                          disabled="@Disabled"
                          readonly="@ReadOnly"
                          required="@Required"
                          no-asterisk="@NoAsterisk"
                          no-spinner="@NoSpinner"
                          multiple="@Multiple"
                          error="@HasValidationErrors"
                          has-leading-icon="@HasLeadingIcon"
                          has-trailing-icon="@HasTrailingIcon"
                          @ref="textFieldElement"
                          @oninput=@HandleInput
                          @onchange=@HandleChange
                          @onselect=@OnSelect
                          @onfocus=@OnFocus
                          @onblur=@OnBlur>
        @if (HasLeadingIcon)
        {
            <md-icon slot="leading-icon">@LeadingIcon</md-icon>
        }
        @if (HasTrailingIcon)
        {
            @if (TrailingIconToggle)
            {
                <md-icon-button toggle slot="trailing-icon" @onclick="HandleTrailingIconClick">
                    <md-icon>@TrailingIcon</md-icon>
                    <md-icon slot="selected">@TrailingIconSelected</md-icon>
                </md-icon-button>
            }
            else
            {
                <md-icon slot="trailing-icon" @onclick="HandleTrailingIconClick">@TrailingIcon</md-icon>
            }
        }
        @ChildContent
    </md-filled-text-field>
}
else
{
    <md-outlined-text-field id="@Id"
                            class="@CssClass material-text-field"
                            label="@Label"
                            value="@CurrentValueAsString"
                            type="@Type"
                            placeholder="@Placeholder"
                            prefix-text="@PrefixText"
                            suffix-text="@SuffixText"
                            supporting-text="@GetSupportingText()"
                            error-text="@GetErrorText()"
                            rows="@Rows"
                            cols="@Cols"
                            max="@Max"
                            maxlength="@MaxLength"
                            min="@Min"
                            minlength="@MinLength"
                            pattern="@Pattern"
                            step="@Step"
                            inputmode="@InputMode"
                            autocomplete="@Autocomplete"
                            text-direction="@TextDirection"
                            count="@(ShowCharacterCount ? CurrentValueAsString?.Length : null)"
                            @attributes="AdditionalAttributes"
                            disabled="@Disabled"
                            readonly="@ReadOnly"
                            required="@Required"
                            no-asterisk="@NoAsterisk"
                            no-spinner="@NoSpinner"
                            multiple="@Multiple"
                            error="@HasValidationErrors"
                            has-leading-icon="@HasLeadingIcon"
                            has-trailing-icon="@HasTrailingIcon"
                            @ref="textFieldElement"
                            @oninput=@HandleInput
                            @onchange=@HandleChange
                            @onselect=@OnSelect
                            @onfocus=@OnFocus
                            @onblur=@OnBlur>
        @if (HasLeadingIcon)
        {
            <md-icon slot="leading-icon">@LeadingIcon</md-icon>
        }
        @if (HasTrailingIcon)
        {
            @if (TrailingIconToggle)
            {
                <md-icon-button toggle slot="trailing-icon" @onclick="HandleTrailingIconClick">
                    <md-icon>@TrailingIcon</md-icon>
                    <md-icon slot="selected">@TrailingIconSelected</md-icon>
                </md-icon-button>
            }
            else
            {
                <md-icon slot="trailing-icon" @onclick="HandleTrailingIconClick">@TrailingIcon</md-icon>
            }
        }
        @ChildContent
    </md-outlined-text-field>
}
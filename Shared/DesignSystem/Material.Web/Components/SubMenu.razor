@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<md-sub-menu anchor-corner="@AnchorCorner"
             menu-corner="@MenuCorner"
             hover-open-delay="@HoverOpenDelay"
             hover-close-delay="@HoverCloseDelay"
             @attributes="AdditionalAttributes">
    
    <md-menu-item slot="item"
                  disabled="@ItemDisabled"
                  selected="@ItemSelected"
                  @onclick="OnItemClick">
        
        @if (!string.IsNullOrEmpty(ItemStartIcon))
        {
            <md-icon slot="start">@ItemStartIcon</md-icon>
        }
        
        @if (!string.IsNullOrEmpty(ItemHeadline))
        {
            <div slot="headline">@ItemHeadline</div>
        }
        
        @if (!string.IsNullOrEmpty(ItemSupportingText))
        {
            <div slot="supporting-text">@ItemSupportingText</div>
        }
        
        @if (!string.IsNullOrEmpty(ItemEndIcon))
        {
            <md-icon slot="end">@ItemEndIcon</md-icon>
        }
        
        @ItemContent
    </md-menu-item>
    
    <md-menu slot="menu" @attributes="MenuAttributes">
        @ChildContent
    </md-menu>
    
</md-sub-menu>
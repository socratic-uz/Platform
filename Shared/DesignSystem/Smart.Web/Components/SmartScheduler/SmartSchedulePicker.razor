@namespace Smart.Web.Components
@using SharedKernel.ValueObjects
@using Material.Web.Components
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Schedule
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant

<PickerTriggerCard Label=@EffectiveLabel
                   Icon=@CalendarToday
                   ActiveIcon=@CalendarToday
                   HasValue=@HasActiveDays
                   BadgeText=@string.Format("{0} {1}", ActiveDaysCount, L[DaysShort])
                   BadgeIcon=@EventAvailable
                   PreviewText=@GetSummaryText()
                   ActionLabel=@L[CommonConfigure]
                   ActionIcon=@EditCalendar
                   OnAction=@OpenDialog
                   ResetAriaLabel=@L[ResetSchedule]
                   OnReset=@ClearSchedule
                   Disabled=@Disabled>
    <CustomPreview>
        <span style="display: grid; grid-auto-flow: column; gap: 4px; align-items: center;">
            @foreach (DayOfWeek day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
            {
                var active = IsDayActive(day);
                <span active=@active style=@(active ? "color: var(--md-sys-color-primary); font-weight: 700;" : "color: var(--md-sys-color-outline);") title=@string.Format("{0} {1}", GetDayName(day), active ? L[WorkingDay] : L[DayOff])>
                    @GetDayShort(day)
                </span>
            }
        </span>
    </CustomPreview>
</PickerTriggerCard>

<MaterialDialog Open=@_isDialogOpen
                OpenChanged=@(open => _isDialogOpen = open)
                schedule>
    <Headline>
        <Icon Name=@EditCalendar />
        <span>@L[TitleText]</span>
    </Headline>

    <Content>
        <!-- Quick Presets Bar -->
        <section presets style="display: grid; gap: 8px;">
            <span style="font-size: 13px; font-weight: 700; color: var(--md-sys-color-on-surface-variant); text-transform: uppercase;">@L[QuickPresets]</span>
            <menu style="display: grid; grid-auto-flow: column; grid-auto-columns: max-content; gap: 8px; padding: 0; margin: 0; list-style: none;">
                <Button Variant=@Outlined OnClick=@ApplyWeekdaysPreset Icon=@Work>
                    @L[Weekdays]
                </Button>
                <Button Variant=@Outlined OnClick=@ApplyRetailPreset Icon=@Storefront>
                    @L[Retail]
                </Button>
                <Button Variant=@Outlined OnClick=@Apply247Preset Icon=@AllInclusive>
                    @L[_247]
                </Button>
                <Button Variant=@Text OnClick=@ClearSchedule Icon=@RestartAlt>
                    @L[ResetAll]
                </Button>
            </menu>
        </section>

        <header style="display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; margin-top: 12px;">
            <span style="font-size: 13px; font-weight: 700; color: var(--md-sys-color-on-surface-variant); text-transform: uppercase;">@L[WorkingDays]</span>
            <TextField TValue="string"
                       Variant=@(TextField<string>.TextFieldVariant.Outlined)
                       Label=@L[Timezone]
                       Value=@Schedule.TimeZoneId
                       ValueChanged=@OnTimeZoneSelected
                       ValueExpression=@(() => Schedule.TimeZoneId)
                       HasLeadingIcon=@true
                       LeadingIcon=@Public />
        </header>

        <!-- Days List -->
        <ul days style="display: grid; gap: 8px; padding: 0; margin: 12px 0 0; list-style: none;">
            @foreach (DayOfWeek day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
            {
                var item = GetOrCreateItem(day);
                var isOpen = !item.IsClosed && item.Intervals != null && item.Intervals.Count > 0;
                var firstInterval = isOpen ? item.Intervals.First() : null;

                <li active=@isOpen>
                    <Checkbox Value=@isOpen
                              ValueChanged=@(active => ToggleDay(day, active))
                              ValueExpression=@(() => isOpen)
                              Label=@GetDayName(day) />

                    @if (isOpen && firstInterval != null)
                    {
                        <menu times>
                            <TextField Type="time"
                                       Label=@L[From]
                                       Value=@FormatTime(firstInterval.Start)
                                       OnChange=@((ChangeEventArgs e) => UpdateOpenTime(day, e.Value?.ToString())) />
                            <span>─</span>
                            <TextField Type="time"
                                       Label=@L[To]
                                       Value=@FormatTime(firstInterval.End)
                                       OnChange=@((ChangeEventArgs e) => UpdateCloseTime(day, e.Value?.ToString())) />
                        </menu>
                    }
                    else
                    {
                        <span style="display: grid; grid-auto-flow: column; grid-auto-columns: max-content; gap: 4px; align-items: center; color: var(--md-sys-color-outline);">
                            <Icon Name=@Block />
                            <span>@L[DayOff]</span>
                        </span>
                    }
                </li>
            }
        </ul>
    </Content>

    <Actions>
        <Button Variant=@Text OnClick=@ClearSchedule Icon=@RestartAlt>
            @L[ResetScheduleAction]
        </Button>
        <menu style="display: grid; grid-auto-flow: column; grid-auto-columns: max-content; gap: 8px; padding: 0; margin: 0; list-style: none;">
            <Button Variant=@Text OnClick=@CloseDialog>@L[CancelAction]</Button>
            <Button Variant=@Filled OnClick=@SaveAndClose Icon=@Check>
                @L[SaveAction]
            </Button>
        </menu>
    </Actions>
</MaterialDialog>

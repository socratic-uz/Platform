@namespace Smart.Web.Components
@using SharedKernel.ValueObjects
@using Material.Web.Components

<PickerTriggerCard Label="@EffectiveLabel"
                   Icon="schedule"
                   ActiveIcon="schedule"
                   HasValue="@HasActiveDays"
                   BadgeText="@($"{ActiveDaysCount} {(L?["Schedule_DaysShort"] ?? "дн.")}")"
                   BadgeIcon="event_available"
                   PreviewText="@GetSummaryText()"
                   ActionLabel="@(L?["Common_Configure"] ?? "Настроить")"
                   ActionIcon="edit_calendar"
                   OnAction="OpenDialog"
                   ResetAriaLabel="@(L?["Schedule_ResetSchedule"] ?? "Сбросить расписание")"
                   OnReset="ClearSchedule"
                   Disabled="@Disabled">
    <CustomPreview>
        <div class="@M3.Picker.WeekMiniDots">
            @foreach (DayOfWeek day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
            {
                var active = IsDayActive(day);
                <span class="@M3.Picker.DayDot @(active ? M3.Picker.Active : "")" title="@($"{GetDayName(day)}: {(active ? (L?["Schedule_WorkingDay"] ?? "Рабочий") : (L?["Schedule_DayOff"] ?? "Выходной"))}")">
                    @GetDayShort(day)
                </span>
            }
        </div>
    </CustomPreview>
</PickerTriggerCard>

<MaterialDialog Open="@_isDialogOpen" OpenChanged="@(open => _isDialogOpen = open)" class="md3-schedule-dialog">
    <Headline>
        <div class="@M3.Picker.Md3DialogHeadline">
            <Icon Name="edit_calendar" class="@M3.Picker.Md3HeadlineIcon" />
            <span>@(L?["Schedule_Title"] ?? "Настройка графика работы")</span>
        </div>
    </Headline>

    <Content>
        <div class="@M3.Picker.Md3SchedulePicker">
            
            <!-- Quick Presets Bar -->
            <div class="@M3.Picker.Md3PresetsSection">
                <span class="@M3.Picker.Md3PresetsLabel">@(L?["Schedule_QuickPresets"] ?? "Быстрые шаблоны:")</span>
                <div class="@M3.Picker.Md3PresetsRow">
                    <Button Variant="ButtonVariant.Outlined" OnClick="ApplyWeekdaysPreset">
                        <Icon Name="work" Slot="icon" />
                        @(L?["Schedule_Weekdays"] ?? "Будни 09:00–18:00")
                    </Button>
                    <Button Variant="ButtonVariant.Outlined" OnClick="ApplyRetailPreset">
                        <Icon Name="storefront" Slot="icon" />
                        @(L?["Schedule_Retail"] ?? "Все дни 10:00–22:00")
                    </Button>
                    <Button Variant="ButtonVariant.Outlined" OnClick="Apply247Preset">
                        <Icon Name="all_inclusive" Slot="icon" />
                        @(L?["Schedule_247"] ?? "24/7 (Круглосуточно)")
                    </Button>
                    <Button Variant="ButtonVariant.Text" OnClick="ClearSchedule">
                        <Icon Name="restart_alt" Slot="icon" />
                        @(L?["Schedule_ResetAll"] ?? "Сбросить всё")
                    </Button>
                </div>
            </div>

            <div class="@M3.Picker.Md3ScheduleHeader">
                <span class="@M3.Picker.Md3ScheduleSubtitle">@(L?["Schedule_WorkingDays"] ?? "Рабочие дни и часы")</span>
                <div class="md3-schedule-tz-container">
                    <TextField TValue="string"
                               Variant="TextField<string>.TextFieldVariant.Outlined"
                               Label="@(L?["Schedule_Timezone"] ?? "Часовой пояс")"
                               Value="@Schedule.TimeZoneId"
                               ValueChanged="OnTimeZoneSelected"
                               ValueExpression="() => Schedule.TimeZoneId"
                               Class="md3-tz-field">
                        <LeadingIcon>
                            <Icon Name="public" />
                        </LeadingIcon>
                    </TextField>
                </div>
            </div>

            <!-- Days List -->
            <div class="@M3.Picker.Md3ScheduleDays">
                @foreach (DayOfWeek day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
                {
                    var item = GetOrCreateItem(day);
                    var isOpen = !item.IsClosed && item.Intervals != null && item.Intervals.Count > 0;
                    var firstInterval = isOpen ? item.Intervals.First() : null;

                    <div class="@($"{M3.Picker.Md3ScheduleDayCard} {(isOpen ? M3.Picker.Active : "closed")}")">
                        <div class="@M3.Picker.Md3ScheduleDayLeft" @onclick="() => ToggleDay(day, !isOpen)">
                            <Checkbox Value="@isOpen"
                                      ValueChanged="@(active => ToggleDay(day, active))"
                                      ValueExpression="() => isOpen"
                                      Label="@GetDayName(day)" />
                        </div>

                        @if (isOpen && firstInterval != null)
                        {
                            <div class="@M3.Picker.Md3ScheduleTimeGroup">
                                <div class="@M3.Picker.Md3TimePickerBox">
                                    <span class="@M3.Picker.Md3TimeLabel">С</span>
                                    <input type="time"
                                           class="@M3.Picker.Md3TimeInput"
                                           value="@FormatTime(firstInterval.Start)"
                                           @onchange="(e) => UpdateOpenTime(day, e.Value?.ToString())" />
                                </div>
                                <span class="@M3.Picker.Md3TimeSeparator">─</span>
                                <div class="@M3.Picker.Md3TimePickerBox">
                                    <span class="@M3.Picker.Md3TimeLabel">До</span>
                                    <input type="time"
                                           class="@M3.Picker.Md3TimeInput"
                                           value="@FormatTime(firstInterval.End)"
                                           @onchange="(e) => UpdateCloseTime(day, e.Value?.ToString())" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="@M3.Picker.Md3ClosedBadge">
                                <Icon Name="block" class="md3-closed-icon" />
                                <span>Выходной</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </Content>

    <Actions>
        <div class="@M3.Picker.Md3DialogActionsRow">
            <Button Variant="ButtonVariant.Text" OnClick="ClearSchedule">
                <Icon Name="restart_alt" Slot="icon" />
                Сбросить график
            </Button>
            <div style="display: grid; grid-auto-flow: column; grid-auto-columns: max-content; gap: 8px;">
                <Button Variant="ButtonVariant.Text" OnClick="CloseDialog">Отмена</Button>
                <Button Variant="ButtonVariant.Filled" OnClick="SaveAndClose">
                    <Icon Name="check" Slot="icon" />
                    Сохранить
                </Button>
            </div>
        </div>
    </Actions>
</MaterialDialog>

@namespace Smart.Web.Components
@using SharedKernel.ValueObjects
@using Material.Web.Components
@using static Assets.Constants.Classes.Picker
@using static Assets.Constants.Loc.Schedule
@using static Material.Web.Components.ButtonVariant

<PickerTriggerCard Label=@EffectiveLabel
                   Icon=@IconSchedule
                   ActiveIcon=@IconSchedule
                   HasValue=@HasActiveDays
                   BadgeText="@($"{ActiveDaysCount} {L[DaysShort]}")"
                   BadgeIcon=@IconEventAvailable
                   PreviewText=@GetSummaryText()
                   ActionLabel=@L[LocConfigure]
                   ActionIcon=@IconEditCalendar
                   OnAction=@OpenDialog
                   ResetAriaLabel=@L[ResetSchedule]
                   OnReset=@ClearSchedule
                   Disabled=@Disabled>
    <CustomPreview>
        <div class=@WeekMiniDots>
            @foreach (DayOfWeek day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
            {
                var active = IsDayActive(day);
                <span class="@($"{DayDot} {(active ? Active : string.Empty)}")" title="@($"{GetDayName(day)}: {(active ? L[WorkingDay] : L[DayOff])}")">
                    @GetDayShort(day)
                </span>
            }
        </div>
    </CustomPreview>
</PickerTriggerCard>

<MaterialDialog Open=@_isDialogOpen OpenChanged=@(open => _isDialogOpen = open) class=@ScheduleDialogClass>
    <Headline>
        <div class=@Md3DialogHeadline>
            <Icon Name=@IconEditCalendar class=@Md3HeadlineIcon />
            <span>@L[TitleText]</span>
        </div>
    </Headline>

    <Content>
        <div class=@Md3SchedulePicker>
            <!-- Quick Presets Bar -->
            <div class=@Md3PresetsSection>
                <span class=@Md3PresetsLabel>@L[QuickPresets]</span>
                <div class=@Md3PresetsRow>
                    <Button Variant=@Outlined OnClick=@ApplyWeekdaysPreset>
                        <Icon Name=@IconWork Slot="icon" />
                        @L[Weekdays]
                    </Button>
                    <Button Variant=@Outlined OnClick=@ApplyRetailPreset>
                        <Icon Name=@IconStorefront Slot="icon" />
                        @L[Retail]
                    </Button>
                    <Button Variant=@Outlined OnClick=@Apply247Preset>
                        <Icon Name=@IconAllInclusive Slot="icon" />
                        @L[_247]
                    </Button>
                    <Button Variant=@Text OnClick=@ClearSchedule>
                        <Icon Name=@IconRestartAlt Slot="icon" />
                        @L[ResetAll]
                    </Button>
                </div>
            </div>

            <div class=@Md3ScheduleHeader>
                <span class=@Md3ScheduleSubtitle>@L[WorkingDays]</span>
                <div class=@TzContainerClass>
                    <TextField TValue="string"
                               Variant=@(TextField<string>.TextFieldVariant.Outlined)
                               Label=@L[Timezone]
                               Value=@Schedule.TimeZoneId
                               ValueChanged=@OnTimeZoneSelected
                               ValueExpression=@(() => Schedule.TimeZoneId)
                               Class=@TzFieldClass
                               HasLeadingIcon=@true
                               LeadingIcon=@IconPublic />
                </div>
            </div>

            <!-- Days List -->
            <div class=@Md3ScheduleDays>
                @foreach (DayOfWeek day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
                {
                    var item = GetOrCreateItem(day);
                    var isOpen = !item.IsClosed && item.Intervals != null && item.Intervals.Count > 0;
                    var firstInterval = isOpen ? item.Intervals.First() : null;

                    <div class="@($"{Md3ScheduleDayCard} {(isOpen ? Active : "closed")}")">
                        <div class=@Md3ScheduleDayLeft @onclick=@(() => ToggleDay(day, !isOpen))>
                            <Checkbox Value=@isOpen
                                      ValueChanged=@(active => ToggleDay(day, active))
                                      ValueExpression=@(() => isOpen)
                                      Label=@GetDayName(day) />
                        </div>

                        @if (isOpen && firstInterval != null)
                        {
                            <div class=@Md3ScheduleTimeGroup>
                                <div class=@Md3TimePickerBox>
                                    <span class=@Md3TimeLabel>@L[From]</span>
                                    <input type="time"
                                           class=@Md3TimeInput
                                           value=@FormatTime(firstInterval.Start)
                                           @onchange=@((ChangeEventArgs e) => UpdateOpenTime(day, e.Value?.ToString())) />
                                </div>
                                <span class=@Md3TimeSeparator>─</span>
                                <div class=@Md3TimePickerBox>
                                    <span class=@Md3TimeLabel>@L[To]</span>
                                    <input type="time"
                                           class=@Md3TimeInput
                                           value=@FormatTime(firstInterval.End)
                                           @onchange=@((ChangeEventArgs e) => UpdateCloseTime(day, e.Value?.ToString())) />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class=@Md3ClosedBadge>
                                <Icon Name=@IconBlock class=@ClosedIconClass />
                                <span>@L[DayOff]</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </Content>

    <Actions>
        <div class=@Md3DialogActionsRow>
            <Button Variant=@Text OnClick=@ClearSchedule>
                <Icon Name=@IconRestartAlt Slot="icon" />
                @L[ResetScheduleAction]
            </Button>
            <div class=@GridFlowColClass>
                <Button Variant=@Text OnClick=@CloseDialog>@L[LocCancel]</Button>
                <Button Variant=@Filled OnClick=@SaveAndClose>
                    <Icon Name=@IconCheck Slot="icon" />
                    @L[LocSave]
                </Button>
            </div>
        </div>
    </Actions>
</MaterialDialog>

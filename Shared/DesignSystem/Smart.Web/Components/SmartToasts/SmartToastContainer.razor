@namespace Smart.Web.Components
@using Smart.Web.Services
@using Material.Web.Components
@using Assets.Constants
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.IconButtonVariant

<div class="@Classes.SmartToast.SmartToastContainer">
    @foreach (var toast in Toasts)
    {
        <div class="@Classes.SmartToast.SmarttoastRoot smart-toast-@toast.Level.ToString().ToLowerInvariant()" key="@toast.Id">
            <div class="@Classes.SmartToast.SmartToastHeader">
                <span class="@Classes.SmartToast.SmartToastIcon">
                    @switch (toast.Level)
                    {
                        case ToastLevel.Success:
                            <span>✓</span>
                            break;
                        case ToastLevel.Error:
                            <span>✕</span>
                            break;
                        case ToastLevel.Warning:
                            <span>⚠</span>
                            break;
                        default:
                            <span>ℹ</span>
                            break;
                    }
                </span>
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <strong class="@Classes.SmartToast.SmartToastTitle">@toast.Title</strong>
                }
                <IconButton Icon=@Icons.Close
                            Variant=@Standard
                            OnClick=@(() => DismissToast(toast.Id))
                            AriaLabel=@L[CloseAction]
                            Class="@Classes.SmartToast.SmartToastCloseBtn" />
            </div>
            <div class="@Classes.SmartToast.SmartToastBody">
                @toast.Message
            </div>
        </div>
    }
</div>

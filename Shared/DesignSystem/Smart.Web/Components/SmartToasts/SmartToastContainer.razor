@namespace Smart.Web.Components
@using Smart.Web.Services
@using Material.Web.Components
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.IconButtonVariant

<aside smart-toasts aria-live="polite">
    @foreach (var toast in Toasts)
    {
        <article level=@GetToastLevelName(toast.Level) @key=@toast.Id role="status">
            <header>
                <span>
                    @(toast.Level switch
                    {
                        ToastLevel.Success => "✓",
                        ToastLevel.Error => "✕",
                        ToastLevel.Warning => "⚠",
                        _ => "ℹ"
                    })
                </span>
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <strong>@toast.Title</strong>
                }
                <IconButton Icon=@Close
                            Variant=@Standard
                            OnClick=@(() => DismissToast(toast.Id))
                            AriaLabel=@L[CloseAction] />
            </header>
            <p>
                @toast.Message
            </p>
        </article>
    }
</aside>

@namespace Smart.Web.Components
@using Smart.Web.Services
@inject SmartToastService ToastService
@implements IDisposable

<div class="smart-toast-container">
    @foreach (var toast in _toasts)
    {
        <div class="smart-toast smart-toast-@toast.Level.ToString().ToLowerInvariant()" key="@toast.Id">
            <div class="smart-toast-header">
                <span class="smart-toast-icon">
                    @switch (toast.Level)
                    {
                        case ToastLevel.Success:
                            <span>✓</span>
                            break;
                        case ToastLevel.Error:
                            <span>✕</span>
                            break;
                        case ToastLevel.Warning:
                            <span>⚠</span>
                            break;
                        default:
                            <span>ℹ</span>
                            break;
                    }
                </span>
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <strong class="smart-toast-title">@toast.Title</strong>
                }
                <IconButton Icon="close" Variant="IconButtonVariant.Standard" OnClick="() => DismissToast(toast.Id)" AriaLabel="Close toast" style="--md-icon-button-icon-size: 16px; width: 28px; height: 28px;" />
            </div>
            <div class="smart-toast-body">
                @toast.Message
            </div>
        </div>
    }
</div>

<style>
    .smart-toast-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        display: grid;
        align-content: end;
        gap: 12px;
        max-width: 380px;
        pointer-events: none;
    }
    .smart-toast {
        pointer-events: auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        padding: 14px 16px;
        border-left: 5px solid #2196f3;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-family: inherit;
    }
    .smart-toast-success { border-left-color: #4caf50; }
    .smart-toast-error { border-left-color: #f44336; }
    .smart-toast-warning { border-left-color: #ff9800; }
    .smart-toast-info { border-left-color: #2196f3; }
    .smart-toast-header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }
    .smart-toast-icon { font-weight: bold; }
    .smart-toast-title { font-weight: 600; font-size: 14px; color: #1a1a1a; }
    .smart-toast-close {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: #888;
        padding: 0 4px;
    }
    .smart-toast-close:hover { color: #000; }
    .smart-toast-body { font-size: 13px; color: #4a4a4a; line-height: 1.4; }
</style>

@code {
    private readonly List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnToastAdded += HandleToastAdded;
        ToastService.OnToastRemoved += HandleToastRemoved;
    }

    private void HandleToastAdded(ToastMessage toast)
    {
        InvokeAsync(async () =>
        {
            _toasts.Add(toast);
            StateHasChanged();

            if (toast.DurationMs > 0)
            {
                await Task.Delay(toast.DurationMs);
                DismissToast(toast.Id);
            }
        });
    }

    private void HandleToastRemoved(string id)
    {
        DismissToast(id);
    }

    private void DismissToast(string id)
    {
        InvokeAsync(() =>
        {
            _toasts.RemoveAll(t => t.Id == id);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ToastService.OnToastAdded -= HandleToastAdded;
        ToastService.OnToastRemoved -= HandleToastRemoved;
    }
}

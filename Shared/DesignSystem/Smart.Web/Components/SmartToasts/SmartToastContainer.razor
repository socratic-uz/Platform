@namespace Smart.Web.Components
@using Smart.Web.Services
@using Material.Web.Components
@using static Assets.Constants.Classes.SmartToast
@using static Assets.Constants.Formats
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.IconButtonVariant

<div class=@ToastContainer>
    @foreach (var toast in Toasts)
    {
        <div class=@string.Format(Two, SmarttoastRoot, GetToastLevelClass(toast.Level)) key="@toast.Id">
            <div class=@SmartToastHeader>
                <span class=@SmartToastIcon>
                    @switch (toast.Level)
                    {
                        case ToastLevel.Success:
                            <span>✓</span>
                            break;
                        case ToastLevel.Error:
                            <span>✕</span>
                            break;
                        case ToastLevel.Warning:
                            <span>⚠</span>
                            break;
                        default:
                            <span>ℹ</span>
                            break;
                    }
                </span>
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <strong class=@SmartToastTitle>@toast.Title</strong>
                }
                <IconButton Icon=@Close
                            Variant=@Standard
                            OnClick=@(() => DismissToast(toast.Id))
                            AriaLabel=@L[CloseAction]
                            Class=@SmartToastCloseBtn />
            </div>
            <div class=@SmartToastBody>
                @toast.Message
            </div>
        </div>
    }
</div>

@namespace Smart.Web.Components
@typeparam TItem where TItem : class
@using static Assets.Constants.Classes.Orders
@using static Assets.Constants.Classes.Cards

<section class=@SmartKanbanBoard>
    @if (Columns != null)
    {
        @foreach (var col in Columns)
        {
            var columnItems = GetItemsForColumn(col);
            <section class=@SmartKanbanColumn
                 @ondragover:preventDefault="true"
                 @ondrop=@(() => HandleDrop(col))>
                <header class=@SmartKanbanColumnHeader>
                    <span class=@SmartKanbanColumnTitle>@col.Title</span>
                    <span class=@SmartKanbanColumnCount>@columnItems.Count</span>
                </header>
                <ul class=@SmartKanbanCards>
                    @foreach (var item in columnItems)
                    {
                        <li class=@SmartKanbanCard
                             role="button"
                             tabindex="0"
                             draggable="true"
                             @ondragstart=@(() => HandleDragStart(item))
                             @onclick=@(() => HandleCardClick(item))>
                            @if (CardTemplate != null)
                            {
                                @CardTemplate(item)
                            }
                            else
                            {
                                <h4 class=@SmartKanbanCardTitle>@GetItemTitle(item)</h4>
                                <p class=@SmartKanbanCardSubtitle>@GetItemSubtitle(item)</p>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    }
</section>

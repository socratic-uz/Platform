@namespace Smart.Web.Components
@typeparam TItem where TItem : class

<div class="@Classes.Orders.SmartKanbanBoard">
    @if (Columns != null)
    {
        @foreach (var col in Columns)
        {
            var columnItems = GetItemsForColumn(col);
            <div class="@Classes.Orders.SmartKanbanColumn"
                 @ondragover:preventDefault="true"
                 @ondrop="() => HandleDrop(col)">
                <div class="@Classes.Orders.SmartKanbanColumnHeader">
                    <span class="@Classes.Orders.SmartKanbanColumnTitle">@col.Title</span>
                    <span class="@Classes.Orders.SmartKanbanColumnCount">@columnItems.Count</span>
                </div>
                <div class="@Classes.Cards.SmartKanbanCards">
                    @foreach (var item in columnItems)
                    {
                        <div class="@Classes.Cards.SmartKanbanCard"
                             draggable="true"
                             @ondragstart="() => HandleDragStart(item)"
                             @onclick="() => HandleCardClick(item)">
                            @if (CardTemplate != null)
                            {
                                @CardTemplate(item)
                            }
                            else
                            {
                                <div class="@Classes.Cards.SmartKanbanCardTitle">@GetItemTitle(item)</div>
                                <div class="@Classes.Cards.SmartKanbanCardSubtitle">@GetItemSubtitle(item)</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

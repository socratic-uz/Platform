@namespace Smart.Web.Components
@using Microsoft.Extensions.Localization
@using static Assets.Constants.Classes.Fiscal
@using static Assets.Constants.Classes.Invoice
@using static Assets.Constants.Classes.Table
@using static Assets.Constants.Loc.Receipt
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc
@using Material.Web.Components
@using static Material.Web.Components.ButtonVariant
@typeparam TItem

<article id="check" class=@(string.IsNullOrEmpty(Class) ? ReceiptContainer : $"{ReceiptContainer} {Class}") @attributes=AdditionalAttributes>
    <header class=@ReceiptHeaderClass>
        <h3>@(OrganizationName ?? DefaultOrgName)</h3>
        <p>@(OrganizationAddress ?? L[DefaultSystem])</p>
    </header>

    <table class=@ReceiptMeta>
        <tr>
            <td>@L[Receipt.NumberText]: <strong>#@(InvoiceNumber ?? DefaultInvoiceNo)</strong></td>
            <td class=@ReceiptTextRight>@L[Date]: <strong>@(InvoiceDate?.ToString("dd.MM.yyyy HH:mm") ?? DateTime.Now.ToString("dd.MM.yyyy HH:mm"))</strong></td>
        </tr>
        <tr>
            <td>@L[Cashier]: <strong>@L[DefaultCashier]</strong></td>
            <td class=@ReceiptTextRight>@L[Receipt.PaymentText]: <strong>@PaymentMethod</strong></td>
        </tr>
    </table>

    <table class=@ReceiptTable>
        <thead>
            <tr>
                <th class=@ReceiptColQty>@L[QuantityShort]</th>
                <th class=@ReceiptColName>@L[ItemNameText]</th>
                <th class=@ReceiptColPrice>@L[Receipt.Price]</th>
                <th class=@ReceiptColSum>@L[Amount]</th>
            </tr>
        </thead>
        <tbody>
            @if (Items != null && QuantitySelector != null && NameSelector != null && PriceSelector != null)
            {
                @foreach (var op in Items)
                {
                    var qty = QuantitySelector(op);
                    var name = NameSelector(op);
                    var price = PriceSelector(op);
                    <tr>
                        <td class=@ReceiptCellQty>@qty</td>
                        <td class=@ReceiptCellName>
                            @if (OnItemClick.HasDelegate)
                            {
                                <Button Variant=@Text class=@ReceiptClickableRow OnClick=@(() => HandleItemClick(op)) Title=@L[RemoveItemHint]>@name</Button>
                            }
                            else
                            {
                                @name
                            }
                        </td>
                        <td class=@ReceiptCellPrice>@price.ToString("N0")</td>
                        <td class=@ReceiptCellSum>@((qty * price).ToString("N0"))</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @{
        var total = (Items != null && QuantitySelector != null && PriceSelector != null)
            ? Items.Sum(x => QuantitySelector(x) * PriceSelector(x))
            : 0m;
        var vat = total * 0.12m;
    }

    <table class=@ReceiptTotals>
        <tr>
            <td>@L[VatIncluded]:</td>
            <td class=@ReceiptTextRight>@vat.ToString("N0") @L[Common.CurrencyUzs]</td>
        </tr>
        <tr class=@GrandTotal>
            <td>@L[Receipt.InvoiceTotalToPay]:</td>
            <td class=@ReceiptTextRight>@total.ToString("N0") @L[Common.CurrencyUzs]</td>
        </tr>
    </table>

    <footer class=@ReceiptFooter>
        <h4 class=@ReceiptFooterTitle>@L[ThankYou]</h4>
        <p>@L[FiscalReceiptDemo]</p>
    </footer>
</article>

@namespace Smart.Web.Components
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using static Assets.Constants.Loc.Receipt
@using static Assets.Constants.Icons
@using static Material.Web.Components.ButtonVariant

<article fiscal id="fiscal-receipt-element">
    <header>
        <span>
            <Icon Name=@AccountBalance />
            <span>@L[OfdTitle]</span>
        </span>
        <h4>@OrganizationName</h4>
        <p>@L[InnLabel] <strong>@TaxId</strong> | @L[TerminalLabel] <strong>@TerminalId</strong></p>
        <p>@L[ReceiptNo] <strong>@ReceiptSeq</strong> • @ReceiptDate.ToString("dd.MM.yyyy HH:mm:ss")</p>
    </header>

    <Divider />

    <!-- Fiscalized Items List -->
    <ul>
        @foreach (var item in Items)
        {
            <li>
                <hgroup>
                    <span>@item.Name</span>
                    <span>@L[MxikCode] @item.MxikCode (@item.PackageCode)</span>
                </hgroup>
                <hgroup>
                    <span>@item.Quantity × @item.Price.ToString("N0")</span>
                    <span>@item.TotalPrice.ToString("N0") @L[ReceiptCurrencyUzs]</span>
                </hgroup>
            </li>
            <li>
                <span>@L[IncludingVat]</span>
                <span>@item.VatAmount.ToString("N0") @L[ReceiptCurrencyUzs]</span>
            </li>
        }
    </ul>

    <Divider />

    <!-- Total and VAT Breakdown -->
    <section>
        <p>
            <span>@L[TotalToPay]</span>
            <span>@TotalAmount.ToString("N0") @L[ReceiptCurrencyUzs]</span>
        </p>
        <p>
            <span>@L[VatAmount]</span>
            <span>@TotalVatAmount.ToString("N0") @L[ReceiptCurrencyUzs]</span>
        </p>
        <p>
            <span>@L[ReceiptPaymentMethod]</span>
            <span>@PaymentGatewayName (@PaymentTypeName)</span>
        </p>
    </section>

    <Divider />

    <!-- Fiscal Block and Soliq.uz QR Code -->
    <footer>
        <figure>
            @if (!string.IsNullOrWhiteSpace(QrSvg))
            {
                <span>
                    @((MarkupString)QrSvg)
                </span>
            }
            else if (!string.IsNullOrWhiteSpace(SoliqQrUrl))
            {
                <Icon Name=@QrCode2 />
            }
        </figure>
        <aside>
            <p>@L[FiscalSign] <code>@FiscalSign</code></p>
            <p>@L[OfdHint]</p>
            <a href=@SoliqQrUrl target="_blank">
                <Icon Name=@Verified /> @L[VerifySoliq]
            </a>
        </aside>
    </footer>

    <!-- Thermal Printer Receipt Print Button -->
    <Button Variant=@Filled Icon=@Print OnClick=@PrintReceiptAsync>
        @L[PrintEscPos]
    </Button>
</article>

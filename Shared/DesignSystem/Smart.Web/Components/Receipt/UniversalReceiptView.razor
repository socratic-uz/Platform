@namespace Smart.Web.Components
@using SharedKernel.Fiscalization
@using SharedKernel.ValueObjects
@using Domain.Interfaces.Common
@using Domain.Interfaces.Hardware
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using static Assets.Constants.Loc.Receipt
@using static Assets.Constants.Icons
@using static Material.Web.Components.ButtonVariant

<article id="fiscal-receipt-element" class="@Classes.Fiscal.FiscalReceipt glass-panel">
    <header class="@Classes.Terminal.PosReceiptHeader">
        <div class="@Classes.Badge.TaxBadge">
            <span class="soliq-icon">🏛️</span>
            <span class="soliq-title">@L[OfdTitle]</span>
        </div>
        <h4 class="@Classes.Fiscal.OrgName">@OrganizationName</h4>
        <p class="@Classes.Fiscal.OrgDetails">@L[InnLabel] <strong>@TaxId</strong> | @L[TerminalLabel] <strong>@TerminalId</strong></p>
        <p class="@Classes.Invoice.ReceiptMeta">@L[ReceiptNo] <strong>@ReceiptSeq</strong> • @ReceiptDate.ToString("dd.MM.yyyy HH:mm:ss")</p>
    </header>

    <div class="@Classes.Fiscal.ReceiptDivider"></div>

    <!-- Fiscalized Items List -->
    <section class="@Classes.Fiscal.ReceiptItems">
        @foreach (var item in Items)
        {
            <div class="@Classes.Fiscal.ReceiptItemRow">
                <div class="@Classes.Fiscal.ItemMain">
                    <span class="@Classes.Common.ItemName">@item.Name</span>
                    <span class="@Classes.Fiscal.ItemMxik">@L[MxikCode] @item.MxikCode (@item.PackageCode)</span>
                </div>
                <div class="@Classes.Fiscal.ItemCalc">
                    <span class="@Classes.Fiscal.ItemQty">@item.Quantity × @item.Price.ToString("N0")</span>
                    <span class="@Classes.Fiscal.ItemTotal">@item.TotalPrice.ToString("N0") @L[Loc.Common.CurrencyUzs]</span>
                </div>
            </div>
            <div class="@Classes.Fiscal.ItemVatRow">
                <span>@L[IncludingVat]</span>
                <span>@item.VatAmount.ToString("N0") @L[Loc.Common.CurrencyUzs]</span>
            </div>
        }
    </section>

    <div class="@Classes.Fiscal.ReceiptDivider"></div>

    <!-- Total and VAT Breakdown -->
    <section class="@Classes.Invoice.ReceiptTotals">
        <div class="@Classes.Common.TotalRow @Classes.Fiscal.Main">
            <span>@L[TotalToPay]</span>
            <span class="@Classes.Fiscal.TotalVal">@TotalAmount.ToString("N0") @L[Loc.Common.CurrencyUzs]</span>
        </div>
        <div class="@Classes.Common.TotalRow vat">
            <span>@L[VatAmount]</span>
            <span>@TotalVatAmount.ToString("N0") @L[Loc.Common.CurrencyUzs]</span>
        </div>
        <div class="@Classes.Common.TotalRow payment-type">
            <span>@L[Receipt_PaymentMethod]</span>
            <span>@PaymentGatewayName (@PaymentTypeName)</span>
        </div>
    </section>

    <div class="@Classes.Fiscal.ReceiptDivider"></div>

    <!-- Fiscal Block and Soliq.uz QR Code -->
    <footer class="@Classes.Fiscal.ReceiptFiscalFooter">
        <div class="@Classes.QrDesigner.QrContainer">
            @if (!string.IsNullOrWhiteSpace(QrSvg))
            {
                <div class="@Classes.QrDesigner.QrSvgWrap">
                    @((MarkupString)QrSvg)
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(SoliqQrUrl))
            {
                <div class="@Classes.QrDesigner.QrPlaceholder">
                    <Icon Name=@QrCode2 />
                </div>
            }
        </div>
        <div class="@Classes.InfoGrid.FiscalInfo">
            <p class="@Classes.Fiscal.Sign">@L[FiscalSign] <code>@FiscalSign</code></p>
            <p class="@Classes.Fiscal.OfdHint">@L[OfdHintText]</p>
            <a href="@SoliqQrUrl" target="_blank" class="@Classes.Fiscal.VerifyLink">
                <Icon Name=@Verified /> @L[VerifySoliq]
            </a>
        </div>
    </footer>

    <!-- Thermal Printer Receipt Print Button -->
    <div class="@Classes.Fiscal.ReceiptActions">
        <Button Variant=@Filled class="@Classes.Fiscal.PrintBtn" OnClick=@PrintReceiptAsync>
            <Icon Name=@Print Slot="icon" /> @L[PrintEscPos]
        </Button>
    </div>
</article>

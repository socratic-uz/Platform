@namespace Smart.Web.Components
@using Domain.Interfaces.Common
@using static Assets.Constants.Icons

@if (!string.IsNullOrEmpty(_svg))
{
    <figure qr @attributes=@AdditionalAttributes>
        @((MarkupString)_svg)
    </figure>
}
else
{
    <figure qr placeholder @attributes=@AdditionalAttributes>
        <Icon Name=@QrCode2 />
    </figure>
}

@namespace Smart.Web.Components
@using Domain.Interfaces.Common
@using static Assets.Constants.Icons

@if (!string.IsNullOrEmpty(_svg))
{
    <div class="@Classes.QrDesigner.QrWrapper" @attributes="AdditionalAttributes">
        @((MarkupString)_svg)
    </div>
}
else
{
    <div class="@Classes.QrDesigner.QrPlaceholder" @attributes="AdditionalAttributes">
        <Icon Name=@QrCode2 />
    </div>
}

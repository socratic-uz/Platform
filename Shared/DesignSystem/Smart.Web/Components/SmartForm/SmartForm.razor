</style>

<MaterialDialog id=@Id
                class="smart-form-dialog"
                Open=@Open
                Type=@Type
                NoFocusTrap=@NoFocusTrap
                aria-label="@AriaLabel"
                @attributes=@AdditionalAttributes
                OnClose=@OnClose
                OnCancel=@OnCancel>

    <Headline>
        @Headline
    </Headline>
    <Content>
        <EditForm EditContext="@editContext" id="@formId" class="smart-form-content" style="display: grid; gap: 16px; box-sizing: border-box; width: 100%; min-width: 0; overflow-x: hidden;">
            <DataAnnotationsValidator />

            @if (ShowValidationSummary)
            {
                <ValidationSummary />
            }

            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @foreach (var info in propertyInfos ?? Array.Empty<PropertyInfo>())
                {
                    @RenderField(info, Item)
                }

                @AdditionalFields
            }
        </EditForm>
    </Content>
    <Actions>
        @if (Actions != null)
        {
            @Actions
        }
        else
        {
            <Button Variant="ButtonVariant.Text" Type="button" OnClick="e => OnCancel.InvokeAsync(e)">
                @(string.IsNullOrWhiteSpace(CancelText) ? "Отмена" : CancelText)
            </Button>
            <Button Variant="ButtonVariant.Filled" Type="button" OnClick="SubmitFormAsync">
                @(string.IsNullOrWhiteSpace(SubmitText) ? "Сохранить" : SubmitText)
            </Button>
        }
    </Actions>
</MaterialDialog>

@code
{

@using System.Linq.Expressions
@using System.Linq
@using System.Reflection
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms

@using SystemEnum = System.Enum
@using SystemType = System.Type;

 string formId = Guid.NewGuid().ToString();
PropertyInfo[]? propertyInfos;
PropertyInfo? imagesProperty;
PropertyInfo? newImagesContentProperty;
PropertyInfo? newImagesFileNameProperty;
PropertyInfo? newImagesContentTypeProperty;

[Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
[Parameter] public bool Open { get; set; } = false;
[Parameter] public bool Quick { get; set; } = false;
[Parameter] public string Type { get; set; } = "alert";
[Parameter] public bool NoFocusTrap { get; set; } = false;
[Parameter] public string AriaLabel { get; set; } = "";
[Parameter] public EventCallback<EventArgs> OnClose { get; set; }
[Parameter] public EventCallback<EventArgs> OnCancel { get; set; }
[Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
[Parameter] public EventCallback<EditContext> OnInvalidSubmit { get; set; }

[Parameter] public RenderFragment? Headline { get; set; }
[Parameter] public RenderFragment? ChildContent { get; set; }
[Parameter] public RenderFragment? Actions { get; set; }
[Parameter] public RenderFragment? AdditionalFields { get; set; }

[Parameter] public TItem Item { get; set; } = new();

// Новые параметры для улучшенной функциональности
[Parameter] public bool ShowValidationSummary { get; set; } = true;
[Parameter] public string SubmitText { get; set; } = "Submit";
[Parameter] public string CancelText { get; set; } = "Cancel";
[Parameter] public List<string> ExcludeProperties { get; set; } = new();
[Parameter] public Dictionary<string, string> PropertyDisplayNames { get; set; } = new();
[Parameter] public Dictionary<string, string> PropertyTypes { get; set; } = new();
[Parameter] public bool UseCheckboxForBool { get; set; } = false; // Новый параметр
[Parameter] public bool UseChipsForEnum { get; set; } = true; // Новый параметр
[Parameter] public bool UseChipSetForEnum { get; set; } = true; // Новый параметр для ChipSet
[Parameter] public bool UseSmartCheckboxForEnum { get; set; } = false; // Новый параметр для SmartCheckbox
[Parameter] public Func<string, string>? ImageUrlResolver { get; set; }

[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; } = new();

    private EditContext? editContext;

    protected override void OnParametersSet()
    {
        if (editContext == null || editContext.Model != Item)
        {
            editContext = new EditContext(Item);
        }
        base.OnParametersSet();
    }

    private async Task SubmitFormAsync()
    {
        editContext ??= new EditContext(Item);
        bool isValid = editContext.Validate();
        if (isValid)
        {
            await OnValidSubmit.InvokeAsync(editContext);
        }
        else
        {
            await OnInvalidSubmit.InvokeAsync(editContext);
        }
    }

protected override Task OnInitializedAsync()
{
    var allProps = typeof(TItem).GetProperties(BindingFlags.Public | BindingFlags.Instance);
    
    imagesProperty = allProps.FirstOrDefault(p => p.Name.Equals("Images", StringComparison.OrdinalIgnoreCase));
    newImagesContentProperty = allProps.FirstOrDefault(p => p.Name.Equals("NewImagesContent", StringComparison.OrdinalIgnoreCase));
    newImagesFileNameProperty = allProps.FirstOrDefault(p => p.Name.Equals("NewImagesFileName", StringComparison.OrdinalIgnoreCase));
    newImagesContentTypeProperty = allProps.FirstOrDefault(p => p.Name.Equals("NewImagesContentType", StringComparison.OrdinalIgnoreCase));

    var imageRelatedNames = new List<string>();
    if (imagesProperty != null && newImagesContentProperty != null)
    {
        imageRelatedNames.Add(newImagesContentProperty.Name);
        if (newImagesFileNameProperty != null) imageRelatedNames.Add(newImagesFileNameProperty.Name);
        if (newImagesContentTypeProperty != null) imageRelatedNames.Add(newImagesContentTypeProperty.Name);
    }

    propertyInfos = allProps
        .Where(p => 
            p.GetCustomAttribute<ScaffoldColumnAttribute>()?.Scaffold != false &&
            ((p.CanRead && p.CanWrite) || 
             (imagesProperty != null && p.Name.Equals(imagesProperty.Name, StringComparison.OrdinalIgnoreCase)) ||
             IsFileCollection(p)) && 
            !ExcludeProperties.Contains(p.Name) && 
            !imageRelatedNames.Contains(p.Name) &&
            !(p.Name.StartsWith("Has") && p.PropertyType == typeof(bool) && typeof(TItem).GetProperty(p.Name.Substring(3)) != null))
        .ToArray();

    return Task.CompletedTask;
}

private bool IsFileCollection(PropertyInfo prop)
{
    var type = prop.PropertyType;
    if (!type.IsGenericType) return false;
    
    var genericArgs = type.GetGenericArguments();
    if (genericArgs.Length == 1 && (genericArgs[0].FullName == "SharedKernel.Protos.File" || genericArgs[0].FullName == "Core.Domain.Entities.File"))
    {
        return true;
    }
    
    var iListInterface = type.GetInterfaces()
        .FirstOrDefault(i => i.IsGenericType && i.GetGenericTypeDefinition() == typeof(IList<>));
    if (iListInterface != null)
    {
        var ifaceArgs = iListInterface.GetGenericArguments();
        if (ifaceArgs.Length == 1 && (ifaceArgs[0].FullName == "SharedKernel.Protos.File" || ifaceArgs[0].FullName == "Core.Domain.Entities.File"))
        {
            return true;
        }
    }
    
    return false;
}

private bool IsSimpleType(SystemType type)
{
    return type.IsPrimitive ||
           type == typeof(string) ||
           type == typeof(decimal) ||
           type == typeof(DateTime) ||
           type == typeof(Guid) ||
           type.IsEnum;
}


private string GetDisplayName(PropertyInfo property)
{
    if (PropertyDisplayNames.TryGetValue(property.Name, out var customName))
        return customName;

    var displayAttribute = property.GetCustomAttribute<DisplayAttribute>();
    return displayAttribute?.Name ?? property.Name;
}

private bool IsRequired(PropertyInfo property)
{
    return property.GetCustomAttribute<RequiredAttribute>() != null;
}

private string GetFieldType(PropertyInfo property)
{
    if (PropertyTypes.ContainsKey(property.Name))
        return PropertyTypes[property.Name];

    var dataTypeAttribute = property.GetCustomAttribute<DataTypeAttribute>();
    if (dataTypeAttribute != null)
    {
        return dataTypeAttribute.DataType switch
        {
            DataType.Password => "password",
            DataType.EmailAddress => "email",
            DataType.MultilineText => "textarea",
            DataType.PhoneNumber => "tel",
            DataType.Url => "url",
            DataType.Date => "date",
            DataType.DateTime => "datetime-local",
            DataType.Time => "time",
            DataType.Currency => "number",
            DataType.Text => "text",
            DataType.ImageUrl => "text",
            DataType.Upload => "file",
            _ => "text"
        };
    }

    var propertyType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;

    if (propertyType == typeof(int) || propertyType == typeof(long) ||
        propertyType == typeof(decimal) || propertyType == typeof(double) ||
        propertyType == typeof(float))
    {
        return "number";
    }

    if (propertyType == typeof(DateTime))
    {
        var propertyName = property.Name.ToLower();
        if (propertyName.Contains("date") && !propertyName.Contains("time"))
            return "date";
        if (propertyName.Contains("time") && !propertyName.Contains("date"))
            return "time";
        return "datetime-local";
    }

    if (propertyType == typeof(bool))
        return "switch";

    if (property.Name.ToLower().Contains("email"))
        return "email";

    if (property.Name.ToLower().Contains("password"))
        return "password";

    if (property.Name.ToLower().Contains("description") ||
        property.Name.ToLower().Contains("comment") ||
        property.Name.ToLower().Contains("note"))
        return "textarea";

    return "text";
}

private int GetTextAreaRows(PropertyInfo property)
{
    var stringLengthAttribute = property.GetCustomAttribute<StringLengthAttribute>();
    if (stringLengthAttribute != null && stringLengthAttribute.MaximumLength > 100)
        return 4;
    return 2;
}

private string GetEnumDisplayText(object enumValue, SystemType enumType)
{
    // Получаем DisplayAttribute если есть
    var memberInfo = enumType.GetMember(enumValue.ToString() ?? "").FirstOrDefault();
    if (memberInfo != null)
    {
        var displayAttribute = memberInfo.GetCustomAttribute<DisplayAttribute>();
        if (displayAttribute?.Name != null)
            return displayAttribute.Name;

        var descriptionAttribute = memberInfo.GetCustomAttribute<DescriptionAttribute>();
        if (descriptionAttribute?.Description != null)
            return descriptionAttribute.Description;
    }

    return enumValue.ToString() ?? "";
}

private bool IsZoneField(PropertyInfo info, SystemType propertyType)
{
    if (propertyType.Name.Contains("Zone", StringComparison.OrdinalIgnoreCase) || propertyType.Name.Contains("Polygon", StringComparison.OrdinalIgnoreCase))
        return true;

    if (propertyType.IsGenericType)
    {
        var genericArgs = propertyType.GetGenericArguments();
        if (genericArgs.Length == 1 && (genericArgs[0].Name.Contains("Zone", StringComparison.OrdinalIgnoreCase) || genericArgs[0].Name.Contains("Polygon", StringComparison.OrdinalIgnoreCase)))
            return true;
    }
    return false;
}

private RenderFragment RenderField(PropertyInfo info, object? obj)
{
    if (obj == null || info.GetIndexParameters().Length > 0 || !info.CanRead) return
@<text></text>;

    try
    {
        var propertyType = Nullable.GetUnderlyingType(info.PropertyType) ?? info.PropertyType;
        var value = info.GetValue(obj);

        if (info.Name.Equals("Images", StringComparison.OrdinalIgnoreCase) && newImagesContentProperty != null)
        {
            return RenderImageUploadField(info, obj);
        }
        else if (IsFileCollection(info))
        {
            return RenderFilePickerField(info, obj);
        }
        else if (IsZoneField(info, propertyType))
        {
            return RenderZoneField(info, obj, value);
        }
        else if (IsSimpleType(propertyType))
        {
            return RenderSimpleField(info, obj, value, propertyType);
        }
        else if (propertyType.Name == "Address")
        {
            return RenderAddressField(info, obj, value, propertyType);
        }
        else if (propertyType.Name == "WorkSchedule" || propertyType == typeof(SharedKernel.ValueObjects.WorkSchedule))
        {
            return RenderWorkScheduleField(info, obj, value);
        }
        else
        {
            return RenderComplexField(info, obj, value, propertyType);
        }
    }
    catch (Exception ex)
    {
        return @<div style="color: red; padding: 5px; border: 1px solid red;">
            Error rendering field '@info.Name': @ex.Message
        </div>;
    }
}

private RenderFragment RenderWorkScheduleField(PropertyInfo info, object obj, object? value)
{
    var schedule = value as SharedKernel.ValueObjects.WorkSchedule ?? new SharedKernel.ValueObjects.WorkSchedule();
    info.SetValue(obj, schedule);

    return @<text>
        <div class="smart-form-field" style="margin-bottom: 12px;">
            <SmartSchedulePicker Schedule="@schedule"
                                 ScheduleChanged="@((SharedKernel.ValueObjects.WorkSchedule updated) => { info.SetValue(obj, updated); })" />
        </div>
    </text>;
}



private RenderFragment RenderSimpleField(PropertyInfo info, object obj, object? value, SystemType propertyType)
{
    var displayName = GetDisplayName(info);
    var isRequired = IsRequired(info);
    var fieldType = GetFieldType(info);

    return propertyType switch
    {
        SystemType t when t == typeof(bool) => UseCheckboxForBool ? CreateCheckbox(info, obj) : CreateSwitch(info, obj),
        SystemType t when t == typeof(string) => CreateTextField<string>(info, obj, displayName, isRequired, fieldType),
        SystemType t when t == typeof(int) || t == typeof(int?) => CreateTextField<int?>(info, obj, displayName, isRequired, fieldType),
        SystemType t when t == typeof(decimal) || t == typeof(decimal?) => CreateTextField<decimal?>(info, obj, displayName, isRequired, fieldType),
        SystemType t when t == typeof(double) || t == typeof(double?) => CreateTextField<double?>(info, obj, displayName, isRequired, fieldType),
        SystemType t when t == typeof(DateTime) || t == typeof(DateTime?) => CreateTextField<DateTime?>(info, obj, displayName, isRequired, fieldType),
        SystemType t when t == typeof(Guid) || t == typeof(Guid?) => CreateTextField<Guid?>(info, obj, displayName, isRequired, fieldType),
        SystemType t when t.IsEnum => CreateSmartEnum(info, obj, displayName, isRequired, propertyType),
        _ => CreateTextField<string>(info, obj, displayName, isRequired, fieldType)
    };
}

private RenderFragment RenderComplexField(PropertyInfo info, object parentObj, object? value, SystemType propertyType)
{
    var displayName = GetDisplayName(info);

    if (value == null)
    {
        try
        {
            value = Activator.CreateInstance(propertyType);
            info.SetValue(parentObj, value);
        }
        catch
        {
            return @<div style="color: gray; padding: 5px;">Cannot create instance of @propertyType.Name</div>;
        }
    }

    var childProperties = propertyType.GetProperties(BindingFlags.Public | BindingFlags.Instance)
        .Where(p => p.CanRead && p.CanWrite && p.GetIndexParameters().Length == 0 && !ExcludeProperties.Contains(p.Name))
        .ToArray();

    return @<text>
        <fieldset class="smart-form-fieldset">
            <legend>@displayName</legend>
            @foreach (var childProp in childProperties)
            {
                if (value != null)
                {
                    @RenderField(childProp, value)
                }
            }
        </fieldset>
    </text>;
}

private RenderFragment CreateTextField<T>(PropertyInfo property, object parentObj, string displayName, bool isRequired, string fieldType)
{
    var canUseTextField = true;
    T typedValue = default(T)!;

    try
    {
        var currentValue = property.GetValue(parentObj);
        typedValue = currentValue is T val ? val : default(T)!;
    }
    catch
    {
        canUseTextField = false;
    }

    return @<text>
        @if (canUseTextField)
        {
            Expression<Func<T>> fallbackExpression = () => typedValue;
            <TextField T="T"
                       Label="@displayName"
                       Type="@fieldType"
                       Required="@isRequired"
                       Variant="TextField<T>.TextFieldVariant.Outlined"
                       Rows="@(fieldType == "textarea" ? GetTextAreaRows(property) : 0)"
                       Value="@typedValue"
                       ValueChanged="@((T value) => { property.SetValue(parentObj, value); StateHasChanged(); })"
                       ValueExpression="@fallbackExpression" />
        }
        else
        {
            var rawVal = property.GetValue(parentObj)?.ToString() ?? "";
            <TextField Value="@rawVal"
                       ValueChanged="@((string valStr) =>
                       {
                           if (typeof(T) == typeof(string))
                           {
                               property.SetValue(parentObj, valStr);
                           }
                           else if (typeof(T) == typeof(int) || typeof(T) == typeof(int?))
                           {
                               if (int.TryParse(valStr, out var intVal)) property.SetValue(parentObj, intVal);
                           }
                           else if (typeof(T) == typeof(decimal) || typeof(T) == typeof(decimal?))
                           {
                               if (decimal.TryParse(valStr, out var decVal)) property.SetValue(parentObj, decVal);
                           }
                           StateHasChanged();
                       })"
                       ValueExpression="() => rawVal"
                       Label="@displayName"
                       Type="@fieldType"
                       Required="@isRequired"
                       Variant="TextField<string>.TextFieldVariant.Outlined"
                       Rows="@(fieldType == "textarea" ? GetTextAreaRows(property) : 0)" />
        }
    </text>;
}

private RenderFragment CreateSwitch(PropertyInfo property, object parentObj)
{
    var displayName = GetDisplayName(property);
    var isRequired = IsRequired(property);

    var canUseSwitch = true;
    bool boolValue = false;

    try
    {
        var currentValue = property.GetValue(parentObj);
        boolValue = currentValue is bool val && val;
    }
    catch
    {
        canUseSwitch = false;
    }

    return @<text>
        @if (canUseSwitch)
        {
            <div class="smart-form-switch-container">
                <div class="smart-form-switch-label">
                    @displayName
                    @if (isRequired)
                    {
                        <span class="required"> *</span>
                    }
                </div>
                @{
                    Expression<Func<bool>> fallbackExpression = () => boolValue;
                }
                <Switch Required="@isRequired"
                        AriaLabel="@displayName"
                        Icons="true"
                        Value="@boolValue"
                        ValueChanged="@((bool value) => { property.SetValue(parentObj, value); StateHasChanged(); })"
                        ValueExpression="@fallbackExpression" />
            </div>
        }
        else
        {
            <div class="smart-form-field">
                @{
                    Expression<Func<bool>> fallbackCheckboxExpression = () => boolValue;
                }
                <Checkbox Label="@(isRequired ? $"{displayName} *" : displayName)"
                          Required="@isRequired"
                          AriaLabel="@displayName"
                          Value="@boolValue"
                          ValueChanged="@((bool value) => { property.SetValue(parentObj, value); StateHasChanged(); })"
                          ValueExpression="@fallbackCheckboxExpression" />
            </div>
        }
    </text>;
}

private RenderFragment CreateCheckbox(PropertyInfo property, object parentObj)
{
    var displayName = GetDisplayName(property);
    var isRequired = IsRequired(property);

    var canUseCheckbox = true;
    bool boolValue = false;

    try
    {
        var currentValue = property.GetValue(parentObj);
        boolValue = currentValue is bool val && val;
    }
    catch
    {
        canUseCheckbox = false;
    }

    return @<text>
        @if (canUseCheckbox)
        {
            <div class="smart-form-checkbox-container">
                @{
                    Expression<Func<bool>> fallbackExpression = () => boolValue;
                }
                <Checkbox Label="@displayName"
                          Required="@isRequired"
                          AriaLabel="@displayName"
                          Value="@boolValue"
                          ValueChanged="@((bool value) => { property.SetValue(parentObj, value); StateHasChanged(); })"
                          ValueExpression="@fallbackExpression" />
            </div>
        }
        else
        {
            <div class="smart-form-error">
                Error in checkbox '@displayName': Cannot read property value
            </div>
        }
    </text>;
}

private RenderFragment CreateEnumChip(PropertyInfo property, object parentObj, string displayName, bool isRequired, SystemType enumType)
{
    var canRender = true;
    object? currentValue = null;
    var enumValues = new List<object>();
    var isFlagsEnum = false;
    var isLongEnum = false;

    try
    {
        currentValue = property.GetValue(parentObj);
        enumValues = SystemEnum.GetValues(enumType).Cast<object>().ToList();
        isFlagsEnum = enumType.GetCustomAttributes(typeof(FlagsAttribute), false).Any();

        var underlyingType = SystemEnum.GetUnderlyingType(enumType);
        isLongEnum = underlyingType == typeof(long);
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error in CreateEnumChip for {enumType.Name}: {ex.Message}");
        canRender = false;
    }

    return @<text>
        @if (canRender)
        {
            <div class="smart-form-chip-label">
                @displayName
                @if (isRequired)
                {
                    <span class="required">*</span>
                }
            </div>

            <div class="smart-form-chip-container">
                @if (isFlagsEnum)
                {
                    @foreach (var enumValue in enumValues)
                    {
                        bool isSelected;
                        if (isLongEnum)
                        {
                            var enumLong = Convert.ToInt64(enumValue);
                            var currentLong = Convert.ToInt64(currentValue ?? 0L);
                            isSelected = (currentLong & enumLong) == enumLong && enumLong != 0;
                        }
                        else
                        {
                            var enumInt = Convert.ToInt32(enumValue);
                            var currentInt = Convert.ToInt32(currentValue ?? 0);
                            isSelected = (currentInt & enumInt) == enumInt && enumInt != 0;
                        }
                        <Chip ChipType="ChipType.Filter"
                              Label="@GetEnumDisplayText(enumValue, enumType)"
                              Selected="@isSelected"
                              Removable="@isSelected"
                              OnClick="@(async (e) =>
                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                            if (isLongEnum)
                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                                                                                var enumLong = Convert.ToInt64(enumValue);
                                                                                                                                                                                                                                                                                                                                                                                                                                                var currentLong = Convert.ToInt64(property.GetValue(parentObj) ?? 0L);
                                                                                                                                                                                                                                                                                                                                                                                                                                                property.SetValue(parentObj, SystemEnum.ToObject(enumType, currentLong ^ enumLong));
                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                            else
                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                                                                                var enumInt = Convert.ToInt32(enumValue);
                                                                                                                                                                                                                                                                                                                                                                                                                                                var currentInt = Convert.ToInt32(property.GetValue(parentObj) ?? 0);
                                                                                                                                                                                                                                                                                                                                                                                                                                                property.SetValue(parentObj, SystemEnum.ToObject(enumType, currentInt ^ enumInt));
                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                            StateHasChanged();
                                                                                                                                                                                                                                                                                                                                                                                                                                        })" />
                    }
                }
                else
                {
                    @foreach (var enumValue in enumValues)
                    {
                        var isSelected = currentValue?.Equals(enumValue) == true;
                        <Chip ChipType="ChipType.Filter"
                              Label="@GetEnumDisplayText(enumValue, enumType)"
                              Selected="@isSelected"
                              OnClick="@(async (e) =>
                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                            property.SetValue(parentObj, enumValue);
                                                                                                                                                                                                                                                                                                                                                                                                                                            StateHasChanged();
                                                                                                                                                                                                                                                                                                                                                                                                                                        })" />
                    }
                }
            </div>
        }
        else
        {
            <div class="smart-form-info" style="color: orange; padding: 8px; border: 1px solid orange; border-radius: 4px;">
                Chip display for '@displayName': Using fallback to Select component due to complex enum structure
            </div>
            @CreateEnumSelect(property, parentObj, displayName, isRequired, enumType)
        }
    </text>;
}

private RenderFragment CreateEnumSelect(PropertyInfo property, object parentObj, string displayName, bool isRequired, SystemType enumType)
{
    var canUseSelect = true;
    object? currentValue = null;
    var options = new List<Select.SelectOption>();

    try
    {
        currentValue = property.GetValue(parentObj);
        var enumValues = SystemEnum.GetValues(enumType);

        foreach (var enumValue in enumValues)
        {
            options.Add(new Select.SelectOption(
                enumValue.ToString() ?? "",
                GetEnumDisplayText(enumValue, enumType)
            ));
        }
    }
    catch
    {
        canUseSelect = false;
    }

    return @<text>
        @if (canUseSelect)
        {
            <Select Label="@displayName"
                    Required="@isRequired"
                    Variant="Select.SelectVariant.Outlined"
                    Options="@options"
                    Value="@(currentValue?.ToString() ?? "")"
                    ValueChanged="@((string value) =>
                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                if (!string.IsNullOrEmpty(value))
                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                    property.SetValue(parentObj, SystemEnum.Parse(enumType, value));
                                                                                                                                                                                                                                                                                                    StateHasChanged();
                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                            })" />
        }
        else
        {
            var selectOptions = SystemEnum.GetValues(enumType)
                .Cast<object>()
                .Select(v => new Select.SelectOption { Value = v.ToString() ?? "", Text = GetEnumDisplayText(v, enumType) })
                .ToList();
            var currentValStr = currentValue?.ToString() ?? "";

            <div class="smart-form-field">
                <Select Variant="Select.SelectVariant.Outlined"
                        Label="@(isRequired ? $"{displayName} *" : displayName)"
                        Value="@currentValStr"
                        ValueChanged="@((string val) =>
                        {
                            if (!string.IsNullOrEmpty(val))
                            {
                                property.SetValue(parentObj, SystemEnum.Parse(enumType, val));
                                StateHasChanged();
                            }
                        })"
                        ValueExpression="() => currentValStr"
                        Options="@selectOptions"
                        style="width: 100%;" />
            </div>
        }
    </text>;
}

private RenderFragment CreateEnumChipSet(PropertyInfo property, object parentObj, string displayName, bool isRequired, SystemType enumType)

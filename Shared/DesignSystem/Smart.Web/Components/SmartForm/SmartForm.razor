private RenderFragment CreateEnumSmartCheckbox(PropertyInfo property, object parentObj, string displayName, bool isRequired, SystemType enumType)
{
    // Проверяем, что тип действительно enum
    if (!enumType.IsEnum)
    {
        return @<div class="smart-form-error">Error: @displayName is not an enum type</div>;
    }

    return @<text>
        @{
            try
            {
                // Динамически создаем закрытый тип компонента
                var smartCheckboxType = typeof(SmartCheckbox<>).MakeGenericType(enumType);

                // Собираем базовые параметры
                var parameters = new Dictionary<string, object>
                    {
                        { "GroupTitle", displayName },
                        { "IsRequired", isRequired },
                        { "UseVerticalLayout", true },
                        { "ContainerClass", "smart-form-smartcheckbox" }
                    };

                var currentValue = property.GetValue(parentObj);
                var isFlagsEnum = enumType.GetCustomAttributes(typeof(FlagsAttribute), false).Any();

                if (isFlagsEnum)
                {
                    // Настройка для Flags Enum
                    parameters.Add("SelectedValue", currentValue!);
                    parameters.Add("OnValueChanged", EventCallback.Factory.Create(this, (object newValue) =>
                    {
                        property.SetValue(parentObj, newValue);
                        StateHasChanged();
                    }));
                }
                else
                {
                    // Настройка для обычного Enum
                    if (currentValue != null)
                    {
                        parameters.Add("SelectedValues", new[] { currentValue });
                    }

                    parameters.Add("OnValuesChanged", EventCallback.Factory.Create(this, (System.Collections.IEnumerable selectedValues) =>
                    {
                        var enumerable = selectedValues.Cast<object>();
                        var firstValue = enumerable.FirstOrDefault();
                        if (firstValue != null)
                        {
                            property.SetValue(parentObj, firstValue);
                            StateHasChanged();
                        }
                    }));
                }

                // Рендерим компонент через декларативный DynamicComponent
                <DynamicComponent Type="@smartCheckboxType" Parameters="@parameters" />
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in CreateEnumSmartCheckbox for {enumType.Name}: {ex.Message}");

                <div class="smart-form-info">
                    SmartCheckbox for '@displayName': Using fallback to Select component due to complex enum structure
                </div>

                @* Вызываем метод-fallback напрямую как RenderFragment *@
                @CreateEnumSelect(property, parentObj, displayName, isRequired, enumType)
            }
        }
    </text>;
}

    private RenderFragment RenderAddressField(PropertyInfo info, object parentObj, object? value, SystemType propertyType)
    {
        if (value == null)
        {
            try
            {
                value = Activator.CreateInstance(propertyType);
                info.SetValue(parentObj, value);
            }
            catch
            {
                return @<div class="smart-form-info">Cannot create instance of @propertyType.Name</div>;
            }
        }

        var parentTypeName = typeof(TItem).Name.ToLowerInvariant();

        var localValue = value; // Avoid capture issues
        var displayName = GetDisplayName(info);

        var pointPickerType = SystemType.GetType("Map.Components.PointPicker, Map");
        if (pointPickerType != null)
        {
            var parameters = new Dictionary<string, object?>
            {
                { "Address", localValue },
                { "AddressChanged", EventCallback.Factory.Create<object?>(this, (object? val) => { info.SetValue(parentObj, val); StateHasChanged(); }) }
            };
            return @<text>
                <fieldset class="smart-form-fieldset">
                    <legend>@displayName</legend>
                    <DynamicComponent Type="@pointPickerType" Parameters="@parameters" />
                </fieldset>
            </text>;
        }

        return RenderComplexField(info, parentObj, value, propertyType);
    }

    private RenderFragment RenderZoneField(PropertyInfo info, object parentObj, object? value)
    {
        var propertyType = Nullable.GetUnderlyingType(info.PropertyType) ?? info.PropertyType;

        if (value == null)
        {
            try
            {
                value = Activator.CreateInstance(propertyType);
                info.SetValue(parentObj, value);
            }
            catch {}
        }

        var isCollection = typeof(System.Collections.IList).IsAssignableFrom(propertyType);
        var localValue = value;

        var zonePickerType = SystemType.GetType("Map.Components.ZonePicker, Map");
        if (zonePickerType != null)
        {
            var parameters = new Dictionary<string, object?>
            {
                { "Zone", localValue },
                { "ZoneChanged", EventCallback.Factory.Create<object?>(this, (object? val) => {
                    try
                    {
                        if (isCollection)
                        {
                            var listProp = info.GetValue(parentObj) as System.Collections.IList;
                            if (listProp == null)
                            {
                                listProp = Activator.CreateInstance(propertyType) as System.Collections.IList;
                                info.SetValue(parentObj, listProp);
                            }

                            if (listProp != null)
                            {
                                if (val != null && !ReferenceEquals(listProp, val))
                                {
                                    listProp.Clear();
                                    if (val is System.Collections.IEnumerable enumVal && val is not string)
                                    {
                                        foreach (var item in enumVal)
                                        {
                                            if (item != null) listProp.Add(item);
                                        }
                                    }
                                    else
                                    {
                                        listProp.Add(val);
                                    }
                                }
                                else if (val == null)
                                {
                                    listProp.Clear();
                                }
                            }

                            var singleZoneProp = parentObj.GetType().GetProperty("Zone");
                            if (singleZoneProp != null && listProp != null)
                            {
                                try
                                {
                                    var firstItem = listProp.Count > 0 ? listProp[0] : null;
                                    if (firstItem != null)
                                    {
                                        if (firstItem is SharedKernel.ValueObjects.Zone vZone)
                                        {
                                            singleZoneProp.SetValue(parentObj, (SharedKernel.Protos.ZoneDto)vZone);
                                        }
                                        else
                                        {
                                            singleZoneProp.SetValue(parentObj, firstItem);
                                        }
                                    }
                                    else
                                    {
                                        singleZoneProp.SetValue(parentObj, null);
                                    }
                                }
                                catch {}
                            }
                        }
                        else
                        {
                            object? singleZone = val;
                            if (val is System.Collections.IList listVal)
                            {
                                singleZone = listVal.Count > 0 ? listVal[0] : null;
                            }

                            info.SetValue(parentObj, singleZone);
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[SmartForm] ZoneChanged error for '{info.Name}': {ex.Message}");
                    }
                    StateHasChanged();
                }) }
            };

            return @<text>
                <DynamicComponent Type="@zonePickerType" Parameters="@parameters" />
            </text>;
        }

        return RenderComplexField(info, parentObj, value, propertyType);
    }

    private RenderFragment RenderImageUploadField(PropertyInfo info, object parentObj)
    {
        var existingImages = info.GetValue(parentObj) as System.Collections.IList;
        var newContent = newImagesContentProperty?.GetValue(parentObj) as System.Collections.IList;
        var newFileNames = newImagesFileNameProperty?.GetValue(parentObj) as System.Collections.IList;
        var newContentTypes = newImagesContentTypeProperty?.GetValue(parentObj) as System.Collections.IList;

        return @<text>
            <Material.Web.Components.FilePicker 
                ExistingImages="@existingImages"
                NewImagesContent="@newContent"
                NewImagesFileName="@newFileNames"
                NewImagesContentType="@newContentTypes"
                Label="@GetDisplayName(info)"
                ImageUrlResolver="@ResolveImageUrl" />
        </text>;
    }

    private RenderFragment RenderFilePickerField(PropertyInfo info, object parentObj)
    {
        var attachments = info.GetValue(parentObj) as System.Collections.IList;

        return @<text>
            <Material.Web.Components.FilePicker 
                Attachments="@attachments"
                Label="@GetDisplayName(info)"
                ImageUrlResolver="@ResolveImageUrl" />
        </text>;
    }

    private RenderFragment CreateSmartEnum(PropertyInfo property, object parentObj, string displayName, bool isRequired, SystemType enumType)
    {
        if (!enumType.IsEnum)
        {
            return @<div class="smart-form-error">Error: @displayName is not an enum type</div>;
        }

        return @<text>
            @{
                try
                {
                    var smartEnumType = typeof(SmartEnum<>).MakeGenericType(enumType);
                    var currentValue = property.GetValue(parentObj);
                    if (currentValue == null)
                    {
                        currentValue = Activator.CreateInstance(enumType);
                    }

                    var displayType = SmartEnumDisplayType.Auto;
                    if (UseSmartCheckboxForEnum)
                    {
                        var isFlagsEnum = enumType.GetCustomAttributes(typeof(FlagsAttribute), false).Any();
                        displayType = isFlagsEnum ? SmartEnumDisplayType.Checkboxes : SmartEnumDisplayType.Radio;
                    }
                    else if (UseChipSetForEnum || UseChipsForEnum)
                    {
                        displayType = SmartEnumDisplayType.Chips;
                    }

                    var helperMethod = typeof(EnumCallbackHelper).GetMethod(nameof(EnumCallbackHelper.CreateCallback)).MakeGenericMethod(enumType);
                    var callback = helperMethod.Invoke(null, new object[] { this, property, parentObj, new Action(StateHasChanged) });

                    var expressionMethod = typeof(EnumCallbackHelper).GetMethod(nameof(EnumCallbackHelper.CreateExpression)).MakeGenericMethod(enumType);
                    var valueExpression = expressionMethod.Invoke(null, new object[] { property, parentObj });

                    var parameters = new Dictionary<string, object>
                    {
                        { "Label", displayName },
                        { "Required", isRequired },
                        { "DisplayType", displayType },
                        { "Value", currentValue! },
                        { "ValueChanged", callback! },
                        { "ValueExpression", valueExpression! }
                    };

                    <DynamicComponent Type="@smartEnumType" Parameters="@parameters" />
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error in CreateSmartEnum for {enumType.Name}: {ex.Message}");
                    <div class="smart-form-error">Error rendering enum selector for @displayName</div>
                }
            }
        </text>;
    }


    private string ResolveImageUrl(string image)
    {
        if (ImageUrlResolver != null)
        {
            return ImageUrlResolver(image);
        }
        
        var typeName = typeof(TItem).Name.ToLower();
        if (typeName.Contains("organization") || typeName.Contains("org"))
        {
            return BuildDefaultImageUrl(image, "org");
        }
        else if (typeName.Contains("product"))
        {
            return BuildDefaultImageUrl(image, "product");
        }
        else if (typeName.Contains("profile") || typeName.Contains("user"))
        {
            return BuildDefaultImageUrl(image, "profile");
        }
        
        return BuildDefaultImageUrl(image, "general");
    }

    [System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessage("Trimming", "IL2026:Members annotated with 'RequiresUnreferencedCodeAttribute' require dynamic access", Justification = "Dynamic reflection lookup for FileHelper is preserved for AOT UI fallback")]
    private string BuildDefaultImageUrl(string image, string category)
    {
        var fileHelperType = typeof(TItem).Assembly.GetType("Core.Shared.Helpers.FileHelper") ?? 
                             AppDomain.CurrentDomain.GetAssemblies()
                                .SelectMany(a => {
                                    try { return a.GetTypes(); } catch { return System.Type.EmptyTypes; }
                                })
                                .FirstOrDefault(t => t.FullName == "Core.Shared.Helpers.FileHelper");

        if (fileHelperType != null)
        {
            var minIoUrlProp = fileHelperType.GetProperty("MinIOUrl", BindingFlags.Public | BindingFlags.Static);
            var minIoUrl = minIoUrlProp?.GetValue(null)?.ToString();
            if (!string.IsNullOrEmpty(minIoUrl))
            {
                if (string.IsNullOrWhiteSpace(image))
                {
                    return $"{minIoUrl}/img/{category}/default.png";
                }
                if (Uri.TryCreate(image, UriKind.Absolute, out _))
                {
                    return image;
                }
                var normalized = image.TrimStart('/');
                if (normalized.StartsWith("img/", StringComparison.OrdinalIgnoreCase))
                {
                    return $"{minIoUrl}/{normalized}";
                }
                if (normalized.Contains('/'))
                {
                    return $"{minIoUrl}/img/{normalized}";
                }
                return $"{minIoUrl}/img/{category}/{normalized}";
            }
        }
        
        return image;
    }

    private RenderFragment RenderFilePickerField(PropertyInfo info, object parentObj)
    {
        var attachments = info.GetValue(parentObj) as System.Collections.IList;

        return @<text>
            <Material.Web.Components.FilePicker 
                Attachments="@attachments"
                Label="@GetDisplayName(info)"
                ImageUrlResolver="@ResolveImageUrl" />
        </text>;
    }

    private RenderFragment CreateSmartEnum(PropertyInfo property, object parentObj, string displayName, bool isRequired, SystemType enumType)
    {
        if (!enumType.IsEnum)
        {
            return @<div class="smart-form-error">Error: @displayName is not an enum type</div>;
        }

        return @<text>
            @{
                try
                {
                    var smartEnumType = typeof(SmartEnum<>).MakeGenericType(enumType);
                    var currentValue = property.GetValue(parentObj);
                    if (currentValue == null)
                    {
                        currentValue = Activator.CreateInstance(enumType);
                    }

                    var displayType = SmartEnumDisplayType.Auto;
                    if (UseSmartCheckboxForEnum)
                    {
                        var isFlagsEnum = enumType.GetCustomAttributes(typeof(FlagsAttribute), false).Any();
                        displayType = isFlagsEnum ? SmartEnumDisplayType.Checkboxes : SmartEnumDisplayType.Radio;
                    }
                    else if (UseChipSetForEnum || UseChipsForEnum)
                    {
                        displayType = SmartEnumDisplayType.Chips;
                    }

                    var helperMethod = typeof(EnumCallbackHelper).GetMethod(nameof(EnumCallbackHelper.CreateCallback)).MakeGenericMethod(enumType);
                    var callback = helperMethod.Invoke(null, new object[] { this, property, parentObj, new Action(StateHasChanged) });

                    var expressionMethod = typeof(EnumCallbackHelper).GetMethod(nameof(EnumCallbackHelper.CreateExpression)).MakeGenericMethod(enumType);
                    var valueExpression = expressionMethod.Invoke(null, new object[] { property, parentObj });

                    var parameters = new Dictionary<string, object>
                    {
                        { "Label", displayName },
                        { "Required", isRequired },
                        { "DisplayType", displayType },
                        { "Value", currentValue! },
                        { "ValueChanged", callback! },
                        { "ValueExpression", valueExpression! }
                    };

                    <DynamicComponent Type="@smartEnumType" Parameters="@parameters" />
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error in CreateSmartEnum for {enumType.Name}: {ex.Message}");
                    <div class="smart-form-error" style="color: red; padding: 8px;">Error rendering enum selector for @displayName</div>
                }
            }
        </text>;
    }

    private static class EnumCallbackHelper
    {
        public static object CreateCallback<TEnum>(object receiver, PropertyInfo property, object parentObj, Action stateHasChanged) where TEnum : struct, Enum
        {
            return EventCallback.Factory.Create<TEnum>(receiver, new Action<TEnum>((TEnum value) =>
            {
                property.SetValue(parentObj, value);
                stateHasChanged();
            }));
        }

        public static System.Linq.Expressions.Expression<Func<TEnum>> CreateExpression<TEnum>(PropertyInfo property, object parentObj)
        {
            var constantExpr = System.Linq.Expressions.Expression.Constant(parentObj);
            var memberExpr = System.Linq.Expressions.Expression.Property(constantExpr, property);
            return System.Linq.Expressions.Expression.Lambda<Func<TEnum>>(memberExpr);
        }
    }
}
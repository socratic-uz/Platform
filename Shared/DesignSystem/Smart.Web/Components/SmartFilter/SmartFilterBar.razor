@namespace Smart.Web.Components
@typeparam TItem where TItem : class

<div class="smart-filter-bar">
    <div class="smart-filter-search">
        <TextField TValue="string"
                   Variant="TextField<string>.TextFieldVariant.Outlined"
                   Placeholder="@Placeholder"
                   Value="@SearchText"
                   ValueChanged="OnSearchValueChanged"
                   ValueExpression="() => SearchText"
                   HasLeadingIcon="true"
                   LeadingIcon="search"
                   HasTrailingIcon="@(!string.IsNullOrEmpty(SearchText))"
                   TrailingIcon="close"
                   OnTrailingIconClick="ClearSearch"
                   style="width: 100%;" />
    </div>

    @if (FilterChips != null && FilterChips.Any())
    {
        <div class="smart-filter-chips">
            @foreach (var chip in FilterChips)
            {
                <Chip ChipType="ChipType.Filter"
                      Label="@chip.Label"
                      Selected="@chip.IsSelected"
                      OnClick="() => ToggleChip(chip)" />
            }
        </div>
    }
</div>

<style>
    .smart-filter-bar {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: #f8f9fa;
        border-radius: 12px;
        margin-bottom: 16px;
        border: 1px solid #e9ecef;
    }
    .smart-filter-search {
        position: relative;
        display: grid;
        align-items: center;
        min-width: 0;
        width: 100%;
    }
    .smart-filter-search-icon {
        position: absolute;
        left: 12px;
        font-size: 14px;
        color: #6c757d;
    }
    .smart-filter-input {
        width: 100%;
        padding: 8px 36px 8px 36px;
        border-radius: 8px;
        border: 1px solid #ced4da;
        outline: none;
        font-size: 14px;
        transition: border-color 0.2s;
    }
    .smart-filter-input:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }
    .smart-filter-clear {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        cursor: pointer;
        color: #adb5bd;
    }
    .smart-filter-chips {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: max-content;
        gap: 8px;
    }
    .smart-filter-chip {
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid #dee2e6;
        background: #ffffff;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .smart-filter-chip.active {
        background: #4f46e5;
        color: #ffffff;
        border-color: #4f46e5;
    }
</style>

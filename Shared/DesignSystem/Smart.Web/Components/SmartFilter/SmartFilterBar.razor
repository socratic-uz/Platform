@namespace Smart.Web.Components
@using Material.Web.Components
@using Assets.Constants
@using static Assets.Constants.Classes.SmartFilter
@using static Assets.Constants.Classes.Search
@using static Assets.Constants.Classes.Chip
@using static Assets.Constants.Icons
@typeparam TItem where TItem : class

<div class=@SmartFilterBar>
    <div class=@SmartFilterSearch>
        <TextField TValue="string"
                   Variant=@(TextField<string>.TextFieldVariant.Outlined)
                   Placeholder=@EffectivePlaceholder
                   Value=@SearchText
                   ValueChanged=@OnSearchValueChanged
                   ValueExpression=@(() => SearchText)
                   HasLeadingIcon=@true
                   LeadingIcon=@Search
                   HasTrailingIcon=@(!string.IsNullOrEmpty(SearchText))
                   TrailingIcon=@Close
                   OnTrailingIconClick=@ClearSearch />
    </div>

    @if (FilterChips != null && FilterChips.Any())
    {
        <div class=@SmartFilterChips>
            @foreach (var chip in FilterChips)
            {
                <Chip ChipType=@FilterChipType
                      Label=@chip.Label
                      Selected=@chip.IsSelected
                      OnClick=@(() => ToggleChip(chip)) />
            }
        </div>
    }
</div>

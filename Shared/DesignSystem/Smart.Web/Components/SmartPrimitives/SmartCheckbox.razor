@namespace Smart.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions
@using static Assets.Constants.Classes.SmartEnum
@using static Assets.Constants.Formats
@typeparam TEnum where TEnum : struct, Enum

<fieldset class=@(string.IsNullOrWhiteSpace(ContainerClass) ? SmartCheckboxContainer : string.Format(Two, SmartCheckboxContainer, ContainerClass))
          @attributes=AdditionalAttributes>

    @if (!string.IsNullOrEmpty(GroupTitle))
    {
        <legend class=@SmartCheckboxGroupTitle>
            @GroupTitle
            @if (IsRequired)
            {
                <span class=@SmartEnumRequired>*</span>
            }
        </legend>
    }

    @if (ShowAsGroup)
    {
        <ul class=@(UseVerticalLayout ? string.Format(Two, SmartCheckboxGroup, Vertical) : string.Format(Two, SmartCheckboxGroup, Horizontal))
            role="group"
            aria-label=@(GroupAriaLabel ?? GroupTitle)>
            @foreach (var enumValue in GetEnumValues())
            {
                var isChecked = IsEnumValueChecked(enumValue);
                var checkboxClass = GetCheckboxClass(enumValue, isChecked);

                <li class=@(string.IsNullOrWhiteSpace(checkboxClass) ? SmartCheckboxItem : string.Format(Two, SmartCheckboxItem, checkboxClass))>
                    <Checkbox @key=enumValue
                              Label=@GetEnumText(enumValue)
                              Value=@isChecked
                              ValueChanged=@(async (bool val) => await HandleEnumChange(enumValue, val))
                              Disabled=@Disabled
                              Required=@(IsRequired && !HasAnySelection())
                              AriaLabel=@GetEnumAriaLabel(enumValue) />

                    @if (HasEnumIcon(enumValue))
                    {
                        <Icon Name=@GetEnumIcon(enumValue) class=@CheckboxIcon />
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <!-- Single checkbox mode for simple boolean values -->
        @if (typeof(TEnum) == typeof(bool))
        {
            var value = GetBooleanValue();
            <section class=@SmartCheckboxSingle>
                <Checkbox Label=@Label
                          Value=@value
                          ValueChanged=@(async (bool val) => await HandleBooleanChange(val))
                          Disabled=@Disabled
                          Required=@IsRequired
                          AriaLabel=@(AriaLabel ?? Label) />
            </section>
        }
    }
</fieldset>

@namespace Smart.Web.Components
@using Microsoft.JSInterop

@if (Visible && !string.IsNullOrWhiteSpace(Slot))
{
    <aside ads="google" aria-label="Advertisement" class=@Class style=@Style>
        <ins class="adsbygoogle"
             style=@InsStyle
             data-ad-client=@Client
             data-ad-slot=@Slot
             data-ad-format=@Format
             data-full-width-responsive=@(FullWidthResponsive ? "true" : "false")></ins>
    </aside>
}

@namespace Smart.Web.Components
@using Material.Web.Components
@using Assets.Constants
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common
@using static Material.Web.Components.ButtonVariant
@typeparam TItem where TItem : class, new()

<div class="@Classes.SmartDataView.SmartdataviewRoot">
    <div class="@Classes.SmartDataView.SmartDataViewHeader">
        <SmartFilterBar TItem="TItem"
                        Placeholder="@EffectivePlaceholder"
                        SearchText="@SearchText"
                        SearchTextChanged=@OnSearchTextChanged
                        FilterChips="@FilterChips"
                        OnChipToggled=@OnChipToggled />

        <div class="@Classes.ThemeToggle.SmartViewModeToggle">
            <Button Variant=@(CurrentMode == ViewMode.Grid ? Filled : Outlined)
                    OnClick=@(() => SetViewMode(ViewMode.Grid))>
                <Icon Name=@Icons.TableChart Slot="icon" />
                @L[SmartDataViewTable]
            </Button>
            <Button Variant=@(CurrentMode == ViewMode.Kanban ? Filled : Outlined)
                    OnClick=@(() => SetViewMode(ViewMode.Kanban))>
                <Icon Name=@Icons.ViewKanban Slot="icon" />
                @L[SmartDataViewKanban]
            </Button>
        </div>
    </div>

    <div class="smart-data-view-content">
        @if (CurrentMode == ViewMode.Grid)
        {
            <SmartGrid TItem="TItem"
                       Items="@FilteredItems"
                       PageSize="@PageSize"
                       OnValidSubmit=@OnValidSubmit />
        }
        else if (CurrentMode == ViewMode.Kanban)
        {
            <SmartKanban TItem="TItem"
                         Items="@FilteredItems"
                         Columns="@KanbanColumns"
                         StatusSelector="@StatusSelector"
                         TitleSelector="@TitleSelector"
                         SubtitleSelector="@SubtitleSelector"
                         OnCardClicked=@OnCardClicked
                         OnCardMoved=@OnCardMoved />
        }
    </div>
</div>

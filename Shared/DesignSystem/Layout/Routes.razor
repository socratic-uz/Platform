@using Domain.Interfaces
@using System.Diagnostics.CodeAnalysis
@using static Assets.Constants.Icons
@using static Assets.Constants.Classes.Common
@using static Assets.Constants.Classes.Cards
@using static Assets.Constants.Classes.EmptyState
@using static Assets.Constants.Classes.Typography
@using static Assets.Constants.Formats
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "Layout is statically referenced typeof(MainLayout)")]

<Router AppAssembly=@typeof(Layout.MainLayout).Assembly AdditionalAssemblies=@FeatureRegistry.GetFeatureAssemblies()>
   <Found Context="routeData">
	   <AuthorizeRouteView RouteData=@routeData DefaultLayout=@typeof(Layout.MainLayout)>
		   <NotAuthorized>
			   <RedirectToSignIn />
		   </NotAuthorized>
	   </AuthorizeRouteView>
   </Found>
   <NotFound>
	   <LayoutView Layout=@typeof(Layout.MainLayout)>
		   @{
			   var modules = FeatureRegistry.GetAllModules();
			   var isRoot = string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri));
		   }
		   <main class=@string.Format(Three, EmptyStateRoot, GridCenter, CardElevated)>
			   <header>
				   <Icon Name=@RocketLaunch class=@EmptyStateIcon />
				   <hgroup>
					   <h2 class=@EmptyStateTitle>
						   @(isRoot ? "Socratic Standalone Host" : "Page Not Found")
					   </h2>
					   <p class=@EmptyStateDesc>
						   @(isRoot ? "Standalone development mode. Select an active module:" : "Requested route was not found. Available modules in this solution:")
					   </p>
				   </hgroup>
			   </header>

			   @if (modules.Count > 0)
			   {
				   <menu aria-label="Available modules">
					   @foreach (var mod in modules)
					   {
						   <li>
							   <a href=@mod.RoutePrefix>
								   <Icon Name=@(mod.Icon ?? Widgets) />
								   <span class=@TitleMedium>@mod.DisplayTitle</span>
								   <span class=@LabelSmall>@mod.RoutePrefix</span>
								   <Icon Name=@ArrowForward />
							   </a>
						   </li>
					   }
				   </menu>
			   }
			   else
			   {
				   <section class=@EmptyStateAction>
					   <p class=@EmptyStateDesc>No modules discovered in FeatureRegistry</p>
					   <span class=@LabelSmall>Verify registrations in FeatureRegistry.Register()</span>
				   </section>
			   }

			   <footer>
				   <span class=@LabelSmall>
					   Socratic Architecture &bull; Feature-Sliced Design &bull; Blazor .NET 10
				   </span>
			   </footer>
		   </main>
	   </LayoutView>
   </NotFound>
</Router>

@using Domain.Interfaces
@using System.Diagnostics.CodeAnalysis
@using static Assets.Constants.Icons
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "Layout is statically referenced typeof(AppLayout)")]

<Router AppAssembly=@typeof(Layout.AppLayout).Assembly AdditionalAssemblies=@FeatureRegistry.GetFeatureAssemblies()>
   <Found Context="routeData">
	   <AuthorizeRouteView RouteData=@routeData DefaultLayout=@typeof(Layout.AppLayout)>
		   <NotAuthorized>
			   <RedirectToSignIn />
		   </NotAuthorized>
	   </AuthorizeRouteView>
   </Found>
   <NotFound>
	   <LayoutView Layout=@typeof(Layout.AppLayout)>
		   @{
			   var modules = FeatureRegistry.GetAllModules();
			   var isRoot = string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri));
		   }
		   <main not-found>
			   <header>
				   <Icon Name=@RocketLaunch />
				   <hgroup>
					   <h2>
						   @(isRoot ? "Socratic Standalone Host" : "Page Not Found")
					   </h2>
					   <p>
						   @(isRoot ? "Standalone development mode. Select an active module:" : "Requested route was not found. Available modules in this solution:")
					   </p>
				   </hgroup>
			   </header>

			   @if (modules.Count > 0)
			   {
				   <menu aria-label="Available modules">
					   @foreach (var mod in modules)
					   {
						   <li>
							   <a href=@mod.RoutePrefix>
								   <Icon Name=@(mod.Icon ?? Widgets) />
								   <span>@mod.DisplayTitle</span>
								   <small>@mod.RoutePrefix</small>
								   <Icon Name=@ArrowForward />
							   </a>
						   </li>
					   }
				   </menu>
			   }
			   else
			   {
				   <section>
					   <p>No modules discovered in FeatureRegistry</p>
					   <small>Verify registrations in FeatureRegistry.Register()</small>
				   </section>
			   }
		   </main>
	   </LayoutView>
   </NotFound>
</Router>

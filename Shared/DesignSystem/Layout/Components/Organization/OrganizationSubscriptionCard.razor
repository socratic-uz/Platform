@namespace Shared.Components
@using SharedKernel.ValueObjects
@using Domain.Entities
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Subscription
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant

<article organization-subscription>
    <header>
        <span badge tier=@GetTierBadgeType()>
            <Icon Name=@GetTierIcon() />
            <span>@GetTierBadgeTitle()</span>
        </span>
        @if (Subscription.IsTrialActive)
        {
            <p trial-counter>
                <strong>@Subscription.RemainingTrialDays</strong>
                <span>@L[Org_TrialDaysRemaining]</span>
            </p>
        }
    </header>

    <section>
        <h2>@GetTierHeadline()</h2>
        <p>@GetTierDescription()</p>
    </section>

    <!-- Сетка сравнения 3-х тарифов -->
    <section pricing>
        <!-- 1. Пробный период -->
        <article pricing-tier active=@(Subscription.Tier == SubscriptionTier.Trial)>
            <header>
                <h3>@L[Org_TierTrialName]</h3>
                <span>@L[Org_TierTrialPrice]</span>
            </header>
            <ul>
                <li><Icon Name=@CheckCircle /> <strong>@L[Org_TierFeatureNoAds]</strong></li>
                <li><Icon Name=@CheckCircle /> @L[Org_TierFeatureAllModes]</li>
                <li><Icon Name=@CheckCircle /> @L[Org_TierFeatureBrandScreensaver]</li>
            </ul>
            @if (Subscription.Tier == SubscriptionTier.Trial && Subscription.IsTrialActive)
            {
                <span current-plan>@L[Org_CurrentPlan]</span>
            }
        </article>

        <!-- 2. С рекламой -->
        <article pricing-tier active=@(Subscription.Tier == SubscriptionTier.WithAds)>
            <header>
                <h3>@L[Org_TierWithAdsName]</h3>
                <span>@L[Org_TierWithAdsPrice]</span>
            </header>
            <ul>
                <li><Icon Name=@Info /> @L[Org_TierFeaturePartnerAds]</li>
                <li><Icon Name=@CheckCircle /> @L[Org_TierFeatureCloudPos]</li>
                <li><Icon Name=@CheckCircle /> @L[Org_TierFeatureFiscalization]</li>
            </ul>
            @if (Subscription.Tier == SubscriptionTier.WithAds)
            {
                <span current-plan>@L[Org_CurrentPlan]</span>
            }
            else
            {
                <Button Variant=@Outlined OnClick=@(() => OpenSelectPlanDialog(SubscriptionTier.WithAds))>
                    @L[Org_SelectPlanAds]
                </Button>
            }
        </article>

        <!-- 3. Без рекламы (PRO) -->
        <article pricing-tier pro active=@(Subscription.Tier == SubscriptionTier.ProAdFree)>
            <span tag-pro>@L[Org_Recommended]</span>
            <header>
                <h3>@L[Org_TierProName]</h3>
                <span>@L[Org_TierProPrice]</span>
            </header>
            <ul>
                <li><Icon Name=@Star /> <strong>@L[Org_TierFeature100NoAds]</strong></li>
                <li><Icon Name=@CheckCircle /> @L[Org_TierFeatureBrandScreensaver]</li>
                <li><Icon Name=@CheckCircle /> @L[Org_TierFeaturePrioritySupport]</li>
                <li><Icon Name=@CheckCircle /> @L[Org_TierFeatureWhiteLabel]</li>
            </ul>
            @if (Subscription.Tier == SubscriptionTier.ProAdFree)
            {
                <span current-plan pro>@L[Org_ActivePro]</span>
            }
            else
            {
                <Button Variant=@Filled Icon=@RocketLaunch OnClick=@(() => OpenSelectPlanDialog(SubscriptionTier.ProAdFree))>
                    @L[Org_ConnectPro]
                </Button>
            }
        </article>
    </section>

    <MaterialDialog Open=@isChangePlanModalOpen OpenChanged=@((bool v) => isChangePlanModalOpen = v)>
        <Headline>
            <span>@L[Org_ConnectingPlan] @(selectedTierForPayment == SubscriptionTier.ProAdFree ? L[Org_PlanProSummary] : L[Org_PlanAdsSummary])</span>
        </Headline>
        <Content>
            <p>
                @L[Org_YouSelectedPlan] <strong>@(selectedTierForPayment == SubscriptionTier.ProAdFree ? L[Org_PlanProSummary] : L[Org_PlanAdsSummary])</strong>.
            </p>
            <fieldset>
                <Radio Name="payment_method" Value="click" OptionValue=@selectedPaymentMethod ValueChanged=@((string v) => selectedPaymentMethod = v) Label=@L[Org_PaymentClickPayme] />
                <Radio Name="payment_method" Value="invoice" OptionValue=@selectedPaymentMethod ValueChanged=@((string v) => selectedPaymentMethod = v) Label=@L[Org_PaymentInvoice] />
            </fieldset>
        </Content>
        <Actions>
            <Button Variant=@Text OnClick=@CloseSelectPlanDialog>@L[Cancel]</Button>
            <Button Variant=@Filled OnClick=@ConfirmPlanChange>
                @L[Org_ConfirmActivation]
            </Button>
        </Actions>
    </MaterialDialog>
</article>

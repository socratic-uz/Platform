@namespace Shared.Components
@using SharedKernel.ValueObjects
@using Domain.Entities
@using Material.Web.Components
@using static Assets.Constants.Classes.Dialog
@using static Assets.Constants.Classes.Cards
@using static Assets.Constants.Classes.Badge
@using static Assets.Constants.Classes.Header
@using static Assets.Constants.Classes.Common
@using static Assets.Constants.Classes.Payment
@using static Assets.Constants.Classes.Chips
@using static Assets.Constants.Classes.QrDesigner
@using static Assets.Constants.Classes.Typography
@using static Assets.Constants.Formats
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Promotion
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant

@if (IsOpen && Product != null)
{
    <MaterialDialog Open=@IsOpen OpenChanged=@((bool v) => { if (!v) CloseModal(); }) class=@PromotionDialog>
        <Headline>
            <div class=@PromotionModalHeader>
                <div class=@string.Format(Two, TitleGroup, HeaderTitleGroup)>
                    <div class=@IconWrap>
                        <Icon Name=@RocketLaunch class=@RocketIcon />
                    </div>
                    <div>
                        <h2 class=@PromotionModalTitle>@L[TitleText]</h2>
                        <p class=@PromotionModalSubtitle>@L[SubtitleText]</p>
                    </div>
                </div>
                <IconButton Icon=@Close AriaLabel=@L[Close] OnClick=@CloseModal />
            </div>
        </Headline>
        <Content>
            @if (CurrentStep == PromotionModalStep.SelectPlan)
            {
                <section class=@PromotionModalBody>
                    <div class=@ProductPreviewPill>
                        <span class=@PreviewLabel>@L[PromotedProduct]</span>
                        <strong>@Product.Name</strong>
                        <span class=@PreviewProductPrice>@Product.Price.ToString("N0") UZS</span>
                    </div>

                    <h3 class=@SectionHeading>@L[Step1Title]</h3>
                    <div class=@PlansGrid>
                        @foreach (var plan in ProductPromotionPlanDefinition.AllPlans)
                        {
                            var isSelected = SelectedPlan.PlanType == plan.PlanType;
                            <div class=@(isSelected ? string.Format(Two, PlanCard, Selected) : PlanCard) @onclick=@(() => SelectPlan(plan))>
                                @if (plan.PlanType == PromotionPlanType.MonthlyTurbo)
                                {
                                    <span class=@string.Format(Three, Root, Pro, PopularBadge)>@L[PopularChoice]</span>
                                }
                                <div class=@PlanCardHeader>
                                    <h4 class=@PlanName>@plan.Name</h4>
                                    <div class=@PlanPriceWrap>
                                        <span>@plan.PriceUzs.ToString("N0")</span>
                                        <span class=@PlanCurrency>UZS</span>
                                    </div>
                                </div>
                                <p>@plan.Description</p>
                                <ul class=@PlanFeatures>
                                    @foreach (var feat in plan.Features)
                                    {
                                        <li>
                                            <Icon Name=@CheckCircle class=@FeatIcon />
                                            <span>@feat</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <h3 class=@SectionHeading>@L[Step2Title]</h3>
                    <div class=@PaymentMethodsGrid>
                        <label class=@(SelectedGateway == PromotionPaymentGatewayType.UzQr ? string.Format(Two, PromoPaymentCard, Active) : PromoPaymentCard)>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.UzQr) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.UzQr) Name="gateway" />
                            <div class=@PaymentMethodBody>
                                <span class=@MethodTitle>📱 UzQR (MUNIS QR-Online)</span>
                                <span class=@MethodSub>@L[UzQrDesc]</span>
                            </div>
                        </label>

                        <label class=@(SelectedGateway == PromotionPaymentGatewayType.Click ? string.Format(Two, PromoPaymentCard, Active) : PromoPaymentCard)>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Click) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Click) Name="gateway" />
                            <div class=@PaymentMethodBody>
                                <span class=@MethodTitle>🟡 Click / Click Up</span>
                                <span class=@MethodSub>@L[ClickDesc]</span>
                            </div>
                        </label>

                        <label class=@(SelectedGateway == PromotionPaymentGatewayType.Payme ? string.Format(Two, PromoPaymentCard, Active) : PromoPaymentCard)>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Payme) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Payme) Name="gateway" />
                            <div class=@PaymentMethodBody>
                                <span class=@MethodTitle>🟢 Payme Business</span>
                                <span class=@MethodSub>@L[PaymeDesc]</span>
                            </div>
                        </label>

                        <label class=@(SelectedGateway == PromotionPaymentGatewayType.Uzum ? string.Format(Two, PromoPaymentCard, Active) : PromoPaymentCard)>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Uzum) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Uzum) Name="gateway" />
                            <div class=@PaymentMethodBody>
                                <span class=@MethodTitle>🟣 Uzum Bank</span>
                                <span class=@MethodSub>@L[UzumDesc]</span>
                            </div>
                        </label>
                    </div>
                </section>
            }
            else if (CurrentStep == PromotionModalStep.PaymentProcessing)
            {
                <section class=@PromotionModalBody>
                    <div class=@InvoiceSummaryBox>
                        <span class=@InvoiceLabel>@L[InvoiceFor, ActiveOrder?.ProductName ?? string.Empty]</span>
                        <div class=@InvoiceAmount>@ActiveOrder?.PriceUzs.ToString("N0") UZS</div>
                        <span>@L[PromoPaymentMethod, GetGatewayDisplayName(ActiveOrder?.PaymentGateway ?? SelectedGateway)]</span>
                    </div>

                    @if (SelectedGateway == PromotionPaymentGatewayType.UzQr)
                    {
                        <div class=@QrPaymentArea>
                            <div class=@QrFrame>
                                <img src=@GetQrCodeImageUrl() alt=@L[QrCodeAlt] class=@QrImage />
                            </div>
                            <p class=@QrInstruction>
                                @L[QrInstructionText]
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class=@OnlineRedirectArea>
                            <Icon Name=@OpenInNew class=@RedirectIcon />
                            <p>@L[RedirectMessage] <strong>@GetGatewayDisplayName(SelectedGateway)</strong>.</p>
                            <a href=@GetPaymentGatewayUrl() target="_blank" rel="noopener noreferrer" class=@BtnGatewayLink>
                                @L[OpenPaymentForm]
                            </a>
                        </div>
                    }

                    <div class=@PaymentStatusChecker>
                        @if (isVerifyingPayment)
                        {
                            <div class=@SpinnerInline></div>
                            <span>@L[VerifyingPayment]</span>
                        }
                        else
                        {
                            <Button Variant=@Filled Icon=@CheckCircle OnClick=@SimulateConfirmPaymentAsync>
                                @L[PaidActivate]
                            </Button>
                        }
                    </div>
                </section>
            }
            else if (CurrentStep == PromotionModalStep.Success)
            {
                <section class=@string.Format(Two, PromotionModalBody, PromoSuccessStep)>
                    <div class=@PromoSuccessIconWrap>
                        <Icon Name=@Verified class=@PromoSuccessCheckIcon />
                    </div>
                    <h3 class=@SuccessTitleClass>@L[SuccessTitle]</h3>
                    <p class=@SuccessDescClass>
                        @L[SuccessDesc, Product.Name]
                    </p>

                    <div class=@FeedLinksCard>
                        <div class=@FeedItem>
                            <Icon Name=@ViewCarousel class=@string.Format(Two, FeedIcon, Yandex) />
                            <div class=@FeedDetails>
                                <span class=@FeedName>@L[YandexFeed]</span>
                                <code class=@FeedUrl>/feeds/yandex/@(OrganizationId).xml</code>
                            </div>
                        </div>
                        <div class=@FeedItem>
                            <Icon Name=@ShoppingBasket class=@string.Format(Two, FeedIcon, Google) />
                            <div class=@FeedDetails>
                                <span class=@FeedName>@L[GoogleFeed]</span>
                                <code class=@FeedUrl>/feeds/google/@(OrganizationId).xml</code>
                            </div>
                        </div>
                    </div>

                    <p class=@SuccessHintClass>
                        @L[SuccessHint]
                    </p>
                </section>
            }
        </Content>
        <Actions>
            @if (CurrentStep == PromotionModalStep.SelectPlan)
            {
                <Button Variant=@Text OnClick=@CloseModal>@L[Cancel]</Button>
                <Button Variant=@Filled Icon=@Lock OnClick=@ProceedToPayment>
                    @L[PayAmount, SelectedPlan.PriceUzs.ToString("N0")]
                </Button>
            }
            else if (CurrentStep == PromotionModalStep.PaymentProcessing)
            {
                <Button Variant=@Text OnClick=@(() => CurrentStep = PromotionModalStep.SelectPlan)>@L[BackToPlans]</Button>
            }
            else if (CurrentStep == PromotionModalStep.Success)
            {
                <Button Variant=@Filled OnClick=@CloseModal>@L[Done]</Button>
            }
        </Actions>
    </MaterialDialog>
}

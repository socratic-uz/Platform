@namespace Shared.Components
@using SharedKernel.ValueObjects
@using Domain.Entities
@using Material.Web.Components
@using static Assets.Constants.Classes.Dialog
@using static Assets.Constants.Classes.Picker
@using static Assets.Constants.Classes.Badge
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Promotion
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant
@using static Material.Web.Components.IconButtonVariant

@if (IsOpen && Product != null)
{
    <MaterialDialog Open=@IsOpen OpenChanged=@((bool v) => { if (!v) CloseModal(); }) style="max-width: 860px; width: 100%;">
        <Headline>
            <div class=@PromotionModalHeader>
                <div class=@($"{TitleGroup} header-title-group")>
                    <div class="header-icon-wrap">
                        <Icon Name=@RocketLaunch class="header-rocket-icon" />
                    </div>
                    <div>
                        <h2 class="promotion-modal-title">@L[TitleText]</h2>
                        <p class="promotion-modal-subtitle">@L[SubtitleText]</p>
                    </div>
                </div>
                <IconButton Icon=@Close Variant=@IconButtonVariant.Standard AriaLabel=@L[Close] OnClick=@CloseModal />
            </div>
        </Headline>
        <Content>
            @if (CurrentStep == PromotionModalStep.SelectPlan)
            {
                <div class="promotion-modal-body">
                    <div class="product-preview-pill">
                        <span class="preview-label">@L[PromotedProduct]</span>
                        <strong class="preview-product-name">@Product.Name</strong>
                        <span class="preview-product-price">@Product.Price.ToString("N0") UZS</span>
                    </div>

                    <h3 class="section-heading">@L[Step1Title]</h3>
                    <div class="plans-grid">
                        @foreach (var plan in ProductPromotionPlanDefinition.AllPlans)
                        {
                            var isSelected = SelectedPlan.PlanType == plan.PlanType;
                            <div class=@($"plan-card {(isSelected ? Selected : string.Empty)}") @onclick=@(() => SelectPlan(plan))>
                                @if (plan.PlanType == PromotionPlanType.MonthlyTurbo)
                                {
                                    <span class=@($"{Root} {Pro} popular-badge")>@L[PopularChoice]</span>
                                }
                                <div class="plan-card-header">
                                    <h4 class="plan-name">@plan.Name</h4>
                                    <div class="plan-price-wrap">
                                        <span class="plan-price">@plan.PriceUzs.ToString("N0")</span>
                                        <span class="plan-currency">UZS</span>
                                    </div>
                                </div>
                                <p class="plan-desc">@plan.Description</p>
                                <ul class="plan-features">
                                    @foreach (var feat in plan.Features)
                                    {
                                        <li>
                                            <Icon Name=@CheckCircle class="feat-icon" />
                                            <span>@feat</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <h3 class="section-heading mt-4">@L[Step2Title]</h3>
                    <div class="payment-methods-grid">
                        <label class=@($"payment-card {(SelectedGateway == PromotionPaymentGatewayType.UzQr ? Active : string.Empty)}")>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.UzQr) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.UzQr) Name="gateway" />
                            <div class="payment-method-body">
                                <span class="method-title">📱 UzQR (MUNIS QR-Online)</span>
                                <span class="method-sub">@L[UzQrDesc]</span>
                            </div>
                        </label>

                        <label class=@($"payment-card {(SelectedGateway == PromotionPaymentGatewayType.Click ? Active : string.Empty)}")>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Click) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Click) Name="gateway" />
                            <div class="payment-method-body">
                                <span class="method-title">🟡 Click / Click Up</span>
                                <span class="method-sub">@L[ClickDesc]</span>
                            </div>
                        </label>

                        <label class=@($"payment-card {(SelectedGateway == PromotionPaymentGatewayType.Payme ? Active : string.Empty)}")>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Payme) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Payme) Name="gateway" />
                            <div class="payment-method-body">
                                <span class="method-title">🟢 Payme Business</span>
                                <span class="method-sub">@L[PaymeDesc]</span>
                            </div>
                        </label>

                        <label class=@($"payment-card {(SelectedGateway == PromotionPaymentGatewayType.Uzum ? Active : string.Empty)}")>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Uzum) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Uzum) Name="gateway" />
                            <div class="payment-method-body">
                                <span class="method-title">🟣 Uzum Bank</span>
                                <span class="method-sub">@L[UzumDesc]</span>
                            </div>
                        </label>
                    </div>
                </div>
            }
            else if (CurrentStep == PromotionModalStep.PaymentProcessing)
            {
                <div class="promotion-modal-body text-center">
                    <div class="invoice-summary-box">
                        <span class="invoice-label">@L[InvoiceFor, ActiveOrder?.ProductName ?? string.Empty]</span>
                        <div class="invoice-amount">@ActiveOrder?.PriceUzs.ToString("N0") UZS</div>
                        <span class="invoice-method">@L[PromoPaymentMethod, GetGatewayDisplayName(ActiveOrder?.PaymentGateway ?? SelectedGateway)]</span>
                    </div>

                    @if (SelectedGateway == PromotionPaymentGatewayType.UzQr)
                    {
                        <div class="qr-payment-area">
                            <div class="qr-frame">
                                <img src=@GetQrCodeImageUrl() alt=@L[QrCodeAlt] class="qr-image" />
                            </div>
                            <p class="qr-instruction">
                                @L[QrInstructionText]
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="online-redirect-area">
                            <Icon Name=@OpenInNew class="redirect-icon" />
                            <p>@L[RedirectMessage] <strong>@GetGatewayDisplayName(SelectedGateway)</strong>.</p>
                            <a href=@GetPaymentGatewayUrl() target="_blank" rel="noopener noreferrer" class="btn-gateway-link">
                                @L[OpenPaymentForm]
                            </a>
                        </div>
                    }

                    <div class="payment-status-checker">
                        @if (isVerifyingPayment)
                        {
                            <div class="spinner-inline"></div>
                            <span>@L[VerifyingPayment]</span>
                        }
                        else
                        {
                            <Button Variant=@ButtonVariant.Filled Icon=@CheckCircle OnClick=@SimulateConfirmPaymentAsync>
                                @L[PaidActivate]
                            </Button>
                        }
                    </div>
                </div>
            }
            else if (CurrentStep == PromotionModalStep.Success)
            {
                <div class="promotion-modal-body text-center success-step">
                    <div class="success-icon-wrap">
                        <Icon Name=@Verified class="success-check-icon" />
                    </div>
                    <h3 class="success-title">@L[SuccessTitle]</h3>
                    <p class="success-desc">
                        @L[SuccessDesc, Product.Name]
                    </p>

                    <div class="feed-links-card">
                        <div class="feed-item">
                            <Icon Name=@ViewCarousel class="feed-icon yandex" />
                            <div class="feed-details">
                                <span class="feed-name">@L[YandexFeed]</span>
                                <code class="feed-url">/feeds/yandex/@(OrganizationId).xml</code>
                            </div>
                        </div>
                        <div class="feed-item">
                            <Icon Name=@ShoppingBasket class="feed-icon google" />
                            <div class="feed-details">
                                <span class="feed-name">@L[GoogleFeed]</span>
                                <code class="feed-url">/feeds/google/@(OrganizationId).xml</code>
                            </div>
                        </div>
                    </div>

                    <p class="success-hint">
                        @L[SuccessHint]
                    </p>
                </div>
            }
        </Content>
        <Actions>
            @if (CurrentStep == PromotionModalStep.SelectPlan)
            {
                <Button Variant=@ButtonVariant.Text OnClick=@CloseModal>@L[Cancel]</Button>
                <Button Variant=@ButtonVariant.Filled Icon=@Lock OnClick=@ProceedToPayment>
                    @L[PayAmount, SelectedPlan.PriceUzs.ToString("N0")]
                </Button>
            }
            else if (CurrentStep == PromotionModalStep.PaymentProcessing)
            {
                <Button Variant=@ButtonVariant.Text OnClick=@(() => CurrentStep = PromotionModalStep.SelectPlan)>@L[BackToPlans]</Button>
            }
            else if (CurrentStep == PromotionModalStep.Success)
            {
                <Button Variant=@ButtonVariant.Filled OnClick=@CloseModal>@L[Done]</Button>
            }
        </Actions>
    </MaterialDialog>
}

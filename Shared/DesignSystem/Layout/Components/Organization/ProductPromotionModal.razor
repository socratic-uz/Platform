@namespace Shared.Components
@using SharedKernel.ValueObjects
@using Domain.Entities
@using Material.Web.Components
@using Material.Web.Components.Labs
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Promotion
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant

@if (IsOpen && Product != null)
{
    <MaterialDialog Open=@IsOpen OpenChanged=@((bool v) => { if (!v) CloseModal(); }) promotion>
        <Headline>
            <header>
                <hgroup>
                    <Icon Name=@RocketLaunch />
                    <h2>@L[TitleText]</h2>
                    <p>@L[SubtitleText]</p>
                </hgroup>
                <IconButton Icon=@Close AriaLabel=@L[Close] OnClick=@CloseModal />
            </header>
        </Headline>
        <Content>
            @if (CurrentStep == PromotionModalStep.SelectPlan)
            {
                <section modal-body>
                    <figure preview-pill>
                        <span>@L[PromotedProduct]</span>
                        <strong>@Product.Name</strong>
                        <span>@Product.Price.ToString("N0") UZS</span>
                    </figure>

                    <fieldset plans>
                        <legend>@L[Step1Title]</legend>
                        @foreach (var plan in ProductPromotionPlanDefinition.AllPlans)
                        {
                            var isSelected = SelectedPlan.PlanType == plan.PlanType;
                            <Card Type="outlined"
                                  selected=@isSelected
                                  @onclick=@(() => SelectPlan(plan))
                                  tabindex="0"
                                  role="radio"
                                  aria-checked=@(isSelected ? "true" : "false")>
                                @if (plan.PlanType == PromotionPlanType.MonthlyTurbo)
                                {
                                    <Badge Value=@L[PopularChoice] />
                                }
                                <header>
                                    <h4>@plan.Name</h4>
                                    <data value=@plan.PriceUzs>
                                        <span>@plan.PriceUzs.ToString("N0")</span>
                                        <span>UZS</span>
                                    </data>
                                </header>
                                <p>@plan.Description</p>
                                <ul>
                                    @foreach (var feat in plan.Features)
                                    {
                                        <li>
                                            <Icon Name=@CheckCircle />
                                            <span>@feat</span>
                                        </li>
                                    }
                                </ul>
                            </Card>
                        }
                    </fieldset>

                    <fieldset gateways>
                        <legend>@L[Step2Title]</legend>
                        <label active=@(SelectedGateway == PromotionPaymentGatewayType.UzQr)>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.UzQr) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.UzQr) Name="gateway" />
                            <span>
                                <span><Icon Name=@QrCode2 /> UzQR (MUNIS QR-Online)</span>
                                <span>@L[UzQrDesc]</span>
                            </span>
                        </label>

                        <label active=@(SelectedGateway == PromotionPaymentGatewayType.Click)>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Click) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Click) Name="gateway" />
                            <span>
                                <span><Icon Name=@Payments /> Click / Click Up</span>
                                <span>@L[ClickDesc]</span>
                            </span>
                        </label>

                        <label active=@(SelectedGateway == PromotionPaymentGatewayType.Payme)>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Payme) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Payme) Name="gateway" />
                            <span>
                                <span><Icon Name=@CreditCard /> Payme Business</span>
                                <span>@L[PaymeDesc]</span>
                            </span>
                        </label>

                        <label active=@(SelectedGateway == PromotionPaymentGatewayType.Uzum)>
                            <Radio Checked=@(SelectedGateway == PromotionPaymentGatewayType.Uzum) OnChange=@(() => SelectedGateway = PromotionPaymentGatewayType.Uzum) Name="gateway" />
                            <span>
                                <span><Icon Name=@AccountBalanceWallet /> Uzum Bank</span>
                                <span>@L[UzumDesc]</span>
                            </span>
                        </label>
                    </fieldset>
                </section>
            }
            else if (CurrentStep == PromotionModalStep.PaymentProcessing)
            {
                <section modal-body>
                    <fieldset invoice-summary>
                        <span>@L[InvoiceFor, ActiveOrder?.ProductName ?? string.Empty]</span>
                        <data value=@ActiveOrder?.PriceUzs>@ActiveOrder?.PriceUzs.ToString("N0") UZS</data>
                        <span>@L[PromoPaymentMethod, GetGatewayDisplayName(ActiveOrder?.PaymentGateway ?? SelectedGateway)]</span>
                    </fieldset>

                    @if (SelectedGateway == PromotionPaymentGatewayType.UzQr)
                    {
                        <section style="display: grid; justify-items: center; gap: 1rem; text-align: center;">
                            <img src=@GetQrCodeImageUrl() alt=@L[QrCodeAlt] style="width: 220px; height: 220px; border-radius: var(--md-sys-shape-corner-medium);" />
                            <p>
                                @L[QrInstruction]
                            </p>
                        </section>
                    }
                    else
                    {
                        <section style="display: grid; justify-items: center; gap: 1rem; text-align: center;">
                            <Icon Name=@OpenInNew />
                            <p>@L[RedirectMessage] <strong>@GetGatewayDisplayName(SelectedGateway)</strong>.</p>
                            <Button Variant=@Filled Href=@GetPaymentGatewayUrl() Target="_blank" TrailingIcon=@OpenInNew>
                                @L[OpenPaymentForm]
                            </Button>
                        </section>
                    }

                    <aside style="display: grid; justify-items: center; gap: 0.5rem;">
                        @if (isVerifyingPayment)
                        {
                            <Progress IsCircular=@true Indeterminate=@true FourColor=@true />
                            <span>@L[VerifyingPayment]</span>
                        }
                        else
                        {
                            <Button Variant=@Filled Icon=@CheckCircle OnClick=@SimulateConfirmPaymentAsync>
                                @L[PaidActivate]
                            </Button>
                        }
                    </aside>
                </section>
            }
            else if (CurrentStep == PromotionModalStep.Success)
            {
                <section modal-body style="text-align: center; justify-items: center;">
                    <Icon Name=@Verified style="color: var(--md-sys-color-primary); font-size: 48px; width: 48px; height: 48px;" />
                    <h3>@L[SuccessTitle]</h3>
                    <p>
                        @L[SuccessDesc, Product.Name]
                    </p>

                    <ul style="list-style: none; padding: 0; display: grid; gap: 0.5rem; text-align: left;">
                        <li style="display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.5rem; align-items: center;">
                            <Icon Name=@ViewCarousel />
                            <span>
                                <span>@L[YandexFeed]</span>
                                <code>/feeds/yandex/@(OrganizationId).xml</code>
                            </span>
                        </li>
                        <li style="display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.5rem; align-items: center;">
                            <Icon Name=@ShoppingBasket />
                            <span>
                                <span>@L[GoogleFeed]</span>
                                <code>/feeds/google/@(OrganizationId).xml</code>
                            </span>
                        </li>
                    </ul>

                    <p>
                        @L[SuccessHint]
                    </p>
                </section>
            }
        </Content>
        <Actions>
            @if (CurrentStep == PromotionModalStep.SelectPlan)
            {
                <Button Variant=@Text OnClick=@CloseModal>@L[Cancel]</Button>
                <Button Variant=@Filled Icon=@Lock OnClick=@ProceedToPayment>
                    @L[PayAmount, SelectedPlan.PriceUzs.ToString("N0")]
                </Button>
            }
            else if (CurrentStep == PromotionModalStep.PaymentProcessing)
            {
                <Button Variant=@Text OnClick=@(() => CurrentStep = PromotionModalStep.SelectPlan)>@L[BackToPlans]</Button>
            }
            else if (CurrentStep == PromotionModalStep.Success)
            {
                <Button Variant=@Filled OnClick=@CloseModal>@L[Done]</Button>
            }
        </Actions>
    </MaterialDialog>
}

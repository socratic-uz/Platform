@namespace Shared.Components
@using Material.Web.Components
@using static Icons
@using static Loc.Settings
@using static Material.Web.Components.ButtonVariant

<div class=@SettingsPanelContainerClass>
    <div class=@SettingsSectionClass>
        <h4 style="margin-bottom: 8px; color: var(--md-sys-color-on-surface);">@L[SettingsThemeTitle]</h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, max-content)); gap: 8px;">
            <Button Variant=@(ThemeMode == "light" ? Filled : Outlined)
                    OnClick=@(() => SetThemeAsync("light"))
                    Icon=@LightMode>
                @L[SettingsThemeLight]
            </Button>
            <Button Variant=@(ThemeMode == "dark" ? Filled : Outlined)
                    OnClick=@(() => SetThemeAsync("dark"))
                    Icon=@DarkMode>
                @L[SettingsThemeDark]
            </Button>
            <Button Variant=@(ThemeMode == "system" ? Filled : Outlined)
                    OnClick=@(() => SetThemeAsync("system"))
                    Icon=@BrightnessAuto>
                @L[SettingsThemeAuto]
            </Button>
        </div>
    </div>

    <Divider style="margin: 16px 0;" />

    <div class=@SettingsSectionClass>
        <h4 style="margin-bottom: 8px; color: var(--md-sys-color-on-surface);">@L[AccentColor]</h4>
        <ColorPicker @bind-Value=@AccentColor Compact=@true />
    </div>
</div>


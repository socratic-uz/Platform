@namespace Shared.Components
@using Material.Web.Components
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Settings
@using static Material.Web.Components.ButtonVariant

<aside settings>
    <fieldset>
        <legend>@L[SettingsThemeTitle]</legend>
        <menu>
            <Button Variant=@(ThemeMode == "light" ? Filled : Outlined)
                    OnClick=@(() => SetThemeAsync("light"))
                    Icon=@LightMode>
                @L[SettingsThemeLight]
            </Button>
            <Button Variant=@(ThemeMode == "dark" ? Filled : Outlined)
                    OnClick=@(() => SetThemeAsync("dark"))
                    Icon=@DarkModeIcon>
                @L[SettingsThemeDark]
            </Button>
            <Button Variant=@(ThemeMode == "system" ? Filled : Outlined)
                    OnClick=@(() => SetThemeAsync("system"))
                    Icon=@BrightnessAuto>
                @L[SettingsThemeAuto]
            </Button>
        </menu>
    </fieldset>

    <Divider />

    <fieldset>
        <legend>@L[AccentColor]</legend>
        <ColorPicker @bind-Value=@AccentColor Compact=@true />
    </fieldset>
</aside>

@inherits DataComponentBase
@using System.Diagnostics.CodeAnalysis
@using static Assets.Constants.Classes.Avatar
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "CameraStreamerComponentType is statically resolved from ICameraStreamerUiProvider annotated with DynamicallyAccessedMemberTypes.All")]

<div class=@Container>
	<Button Variant=@ButtonVariant.Outlined OnClick=@OpenProfile class=@Classes.Avatar.Button AriaLabel=@l[Profile]>
		@if (profile?.Image != null && (!string.IsNullOrEmpty(profile.Image.Url) || (profile.Image.Content != null && profile.Image.Content.Length > 0)))
		{
			<img src=@profile.Image.ToProfileImage() alt="Avatar" />
		}
		else
		{
			<Icon Name=@Person />
		}
	</Button>

	@if (IsOpen)
	{
	<MaterialDialog class=@Classes.Avatar.Contacts Open=@IsOpen OnClose=@OnClose Type="alert">
		<span slot="headline">
			<span class=@Headline>@l[EditProfile]</span>
			<IconButton form="form" value="close" AriaLabel=@l[Close] OnClick=@(e => IsOpen = false) Icon=@Close />
		</span>
		@if (FormModel is null)
		{
			<div slot="content" class=@Content>
				<Progress IsCircular="true" FourColor="true" Indeterminate="true" />
			</div>
		}
		else
		{
			<EditForm Model=@FormModel slot="content" method="dialog" class=@Content @onsubmit:preventDefault>
				<AntiforgeryToken />
				<List>
					<!--Id-->
					<details @ontoggle=@(e => GetRoles())>
						<summary>
							<ListItem type="button">
								<p>@FormModel?.Name.FirstName @FormModel?.Name?.LastName</p>
								<Icon Name=@Person slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>
						<div class=@Content>
							<input type="hidden" name=@profile.Id value=@FormModel.Id />
							<TextField TValue="Guid?"
									   Variant=@(TextField<Guid?>.TextFieldVariant.Outlined)
									   Label=@l[Id]
									   Value=@FormModel.Id
									   ValueExpression="() => FormModel.Id"
									   Disabled="true" />
							@if (Roles.Any())
							{
								@foreach (var role in Roles.Where(r => r.UserId == profile?.Id))
								{
									<label>
										<Radio Name="role"
											   Checked=@(role.Id.ToString() == roleId)
											   OnChange=@(async () => await Switch(role.Id.ToString()))
											   touch-target="wrapper" />
										<span aria-hidden="true">@role.Name</span>
									</label>
								}
							}
							else
							{
								<Progress IsCircular="true" FourColor="true" Indeterminate="true" />
							}
						</div>
						<Divider />
					</details>

					<Divider />

					<!--Phone-->
					<details>
						<summary>
							<ListItem type="button">
								<div>@l[Phone]</div>
								<Icon Name=@Phone slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<div class=@Content>
							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[Phone]
									   Value=@FormModel.Phone
									   ValueExpression="() => FormModel.Phone"
									   Disabled="true" />
						</div>
						<Divider />
					</details>

					<!--Photo-->
					<details>
						<summary>
							<ListItem type="button">
								<div>@l[PhotoLabel]</div>
								<Icon Name=@AddPhotoAlternate slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<div class=@Content style="padding: 16px;">
							<Material.Web.Components.FilePicker 
								Attachments=@_imageAttachments
								Label=@l[PhotoLabel]
								UploadLabel=@l[ProfileUploadPhoto]
								RemoveLabel=@l[Delete]
								Multiple="false"
								Accept="image/*"
								MaxAllowedFiles="1"
								OnChanged=@HandleImageChanged />
						</div>
						<Divider />
					</details>

					<!--Name-->
					<details>
						<summary>
							<ListItem type="button">
								<div>@l[NameLabel]</div>
								<Icon Name=@IdCard slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<div class=@Content>
							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[FirstName]
									   autofocus
									   Value=@FormModel.Name.FirstName
									   ValueChanged=@(val => FormModel.Name.FirstName = val)
									   ValueExpression="() => FormModel.Name.FirstName"
									   OnInput=@(e => FormModel.Name.FirstName = e.Value?.ToString() ?? string.Empty)
									   MaxLength="10"
									   Required="true"
									   SupportingText="*required"
									   ErrorText="Please fill out this field" />

							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[LastName]
									   Value=@FormModel.Name.LastName
									   ValueChanged=@(val => FormModel.Name.LastName = val)
									   ValueExpression="() => FormModel.Name.LastName"
									   OnInput=@(e => FormModel.Name.LastName = e.Value?.ToString() ?? string.Empty)
									   MaxLength="10"
									   Required="true"
									   SupportingText="*required"
									   ErrorText="Please fill out this field" />

							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[MiddleName]
									   Value=@FormModel.Name.MiddleName
									   ValueChanged=@(val => FormModel.Name.MiddleName = val)
									   ValueExpression="() => FormModel.Name.MiddleName"
									   OnInput=@(e => FormModel.Name.MiddleName = e.Value?.ToString() ?? string.Empty)
									   MaxLength="10"
									   Required="true"
									   SupportingText="*required"
									   ErrorText="Please fill out this field" />
						</div>
						<Divider />
					</details>

					<!--Address-->
					<details>
						<summary>
							<ListItem type="button">
								<div>@l[AddressLabel]</div>
								<Icon Name=@LocationOn slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>
						<div class=@Content style="display: grid; gap: 12px; padding: 16px;">
							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[City]
									   Value=@(GetOrCreateAddress().City)
									   ValueChanged=@(c => GetOrCreateAddress().City = c)
									   ValueExpression="() => GetOrCreateAddress().City" />
							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[Street]
									   Value=@(GetOrCreateAddress().Street)
									   ValueChanged=@(s => GetOrCreateAddress().Street = s)
									   ValueExpression="() => GetOrCreateAddress().Street" />
						</div>
						<Divider />
					</details>

					<!--Language-->
					<details>
						<summary>
							<ListItem type="button">
								<div>@l[LanguageLabel]</div>
								<Icon Name=@Translate slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<div class=@Content>
							@foreach (var language in languages)
							{
								<label>
									<Radio Name="language"
										   Checked=@(language == (Language)FormModel.Language)
										   OnChange=@(() => FormModel.Language = language)
										   touch-target="wrapper" />
									<span aria-hidden="true">@l[language.ToString()]</span>
								</label>
							}
						</div>
						<Divider />
					</details>

					<!--Accent-->
					<details>
						<summary>
							<ListItem type="button">
								<div>@l[AccentLabel]</div>
								<Icon Name=@Palette slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<div class=@Content style="padding: 1rem; display: grid; grid-auto-flow: row; gap: 1rem;">
							<div style="display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem;">
								<Select Label=@l[ThemeLabel]
										Value=@ThemeString
										ValueChanged=@OnThemeChanged
										ValueExpression="() => ThemeString"
										Options=@ThemeOptions />
								<div style="display: grid; grid-auto-flow: row; justify-items: center; gap: 0.25rem;">
									<span style="font-size: 0.75rem; color: var(--md-sys-color-outline);">@l[Loc.Common.Color]</span>
									<ColorPicker Value=@(color.HasValue ? Shared.Layout.Color.ToHex(color.Value) : "#00ffb3") ValueChanged=@ChangeTheme />
								</div>
							</div>
						</div>
						<Divider />
					</details>

					<!--Security & Fast Login Methods (Face ID, Google, Passkeys)-->
					<details>
						<summary>
							<ListItem type="button">
								<div>@l[ProfileSecurityAndLogin]</div>
								<Icon Name=@Security slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>
						<div class=@Content style="padding: 1rem; display: grid; grid-auto-flow: row; gap: 0.75rem;">
							<p style="font-size: 0.8rem; color: var(--md-sys-color-outline); margin: 0;">
								@l[ProfileSecuritySubtext]
							</p>

							<!-- Face ID -->
							<div style="display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 0.75rem; background: var(--md-sys-color-surface-container-high); border-radius: 12px; border: 1px solid var(--md-sys-color-outline-variant);">
								<div style="display: grid; grid-auto-flow: column; grid-auto-columns: auto minmax(0, 1fr); align-items: center; gap: 8px;">
									<Icon Name=@(isFaceIdConfigured ? CheckCircle : Face) style=@($"color: {(isFaceIdConfigured ? "var(--md-sys-color-primary)" : "var(--md-sys-color-secondary)")};") />
									<div style="display: grid; grid-auto-flow: row; min-width: 0;">
										<span style="font-size: 0.85rem; font-weight: 600;">@l[ProfileFaceIdTitle]</span>
										<span style="font-size: 0.75rem; color: @(isFaceIdConfigured ? "var(--md-sys-color-primary)" : "var(--md-sys-color-secondary)");">
											@(isFaceIdConfigured ? l[ProfileLinkedToAccount] : l[ProfileFaceLoginSubtext])
										</span>
									</div>
								</div>
								<div style="display: grid; grid-auto-flow: column; align-items: center; gap: 6px;">
									<Button Variant=@ButtonVariant.Outlined OnClick=@NavigateToFaceIdSetup>
										@(isFaceIdConfigured ? l[Update] : l[CommonConfigure])
									</Button>
									@if (isFaceIdConfigured)
									{
										<IconButton OnClick=@RemoveFaceId title=@l[ProfileDeleteBiometrics] AriaLabel=@l[ProfileDeleteBiometrics]>
											<Icon Name=@DeleteOutline style="color: var(--md-sys-color-error); font-size: 20px;" />
										</IconButton>
									}
								</div>
							</div>

							<!-- Google SSO -->
							<div style="display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 0.75rem; background: var(--md-sys-color-surface-container-high); border-radius: 12px; border: 1px solid var(--md-sys-color-outline-variant);">
								<div style="display: grid; grid-auto-flow: column; grid-auto-columns: auto minmax(0, 1fr); align-items: center; gap: 8px;">
									<Icon Name=@AccountCircle />
									<div style="display: grid; grid-auto-flow: row; min-width: 0;">
										<span style="font-size: 0.85rem; font-weight: 600;">Google SSO</span>
										<span style="font-size: 0.75rem; color: var(--md-sys-color-outline);">@(string.IsNullOrEmpty(FormModelEmail) ? l[ProfileNotLinked] : FormModelEmail)</span>
									</div>
								</div>
								<Button Variant=@ButtonVariant.Outlined OnClick=@LinkGoogleAccount>
									@(string.IsNullOrEmpty(FormModelEmail) ? l[Link] : l[Update])
								</Button>
							</div>

							<!-- Passkeys (FIDO2 / WebAuthn) -->
							<div style="display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 0.75rem; background: var(--md-sys-color-surface-container-high); border-radius: 12px; border: 1px solid var(--md-sys-color-outline-variant);">
								<div style="display: grid; grid-auto-flow: column; grid-auto-columns: auto minmax(0, 1fr); align-items: center; gap: 8px;">
									<Icon Name=@Fingerprint style="color: var(--md-sys-color-tertiary);" />
									<div style="display: grid; grid-auto-flow: row; min-width: 0;">
										<span style="font-size: 0.85rem; font-weight: 600;">Passkeys (WebAuthn)</span>
										<span style="font-size: 0.75rem; color: var(--md-sys-color-tertiary);">@l[ProfileDeviceBiometricsSubtext]</span>
									</div>
								</div>
								<Button Variant=@ButtonVariant.Outlined OnClick=@RegisterPasskey>
									@(isPasskeyConfigured ? l[Update] : l[CommonConfigure])
								</Button>
							</div>
						</div>
						<Divider />
					</details>

					<!--Support-->
					<ListItem Href="https://t.me/sardorsafarovv" Target="_blank" type="link">
						<div>@l[Support]</div>
						<Icon Name=@SupportAgent slot="start" />
						<Icon Name=@Link slot="end" />
					</ListItem>

					@if (permission > Permission.Customer)
					{
						<!--Roles-->
						<ListItem Href="roles" type="button">
							<div>@l[RolesLabel]</div>
							<Icon Name=@Group slot="start" />
							<Icon Name=@ChevronRight slot="end" />
						</ListItem>
					}

					<!--Log out-->
					<ListItem type="button" OnClick=@(async e => { await settings.SetAccessTokenAsync(string.Empty); nav.Refresh(); })>
						<div>@l[LogOut]</div>
						<Icon Name=@Logout slot="start" />
					</ListItem>
				</List>
			</EditForm>
		}
		<div slot="actions">
			<Button Variant=@ButtonVariant.Text value="reset" Type="reset" OnClick=@(e => FormModel = profile?.Clone())>@l[ResetAction]</Button>
			<div style="display: block;"></div>
			<Button Variant=@ButtonVariant.Text value="save" OnClick=@(async e => { await UpdateProfile(); IsOpen = false; })>@l[Save]</Button>
			<Button Variant=@ButtonVariant.Text value="cancel" OnClick=@(e => IsOpen = false)>@l[Cancel]</Button>
		</div>
	</MaterialDialog>
	}

	@if (isFaceIdModalOpen)
	{
	<MaterialDialog class=@FaceidProfileModal Open=@isFaceIdModalOpen OnClose=@CloseFaceIdModal Type="alert">
		<span slot="headline">
			<span class=@Headline>@l[ProfileFaceIdTitle]</span>
			<IconButton form="form" value="close" AriaLabel=@l[Close] OnClick=@CloseFaceIdModal Icon=@Close />
		</span>
		<div slot="content" style="display: grid; grid-auto-flow: row; justify-items: center; gap: 14px; padding: 0.75rem 0;">
			<!-- 3-Step Calibration Progress Bar -->
			<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; width: 100%; max-width: 240px; justify-items: stretch;">
				<div style="height: 5px; border-radius: 3px; background: @(currentEnrollmentStage >= 1 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-surface-variant)"); transition: all 0.3s ease;"></div>
				<div style="height: 5px; border-radius: 3px; background: @(currentEnrollmentStage >= 2 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-surface-variant)"); transition: all 0.3s ease;"></div>
				<div style="height: 5px; border-radius: 3px; background: @(currentEnrollmentStage >= 3 ? "var(--md-sys-color-tertiary)" : "var(--md-sys-color-surface-variant)"); transition: all 0.3s ease;"></div>
			</div>

			<div style="width: 280px; height: 280px; border-radius: 50%; overflow: hidden; border: 4px solid @faceIdStatusColor; box-shadow: 0 0 24px var(--md-sys-color-shadow); position: relative; display: grid; place-items: center;">
				@if (isFaceIdModalOpen && CameraStreamerUiProvider?.CameraStreamerComponentType != null)
				{
					<DynamicComponent Type=@CameraStreamerUiProvider.CameraStreamerComponentType
									  Parameters=@CameraStreamerParameters />
				}
				else if (isFaceIdModalOpen)
				{
					<div style="display: grid; place-items: center; text-align: center; padding: 1rem; color: var(--md-sys-color-on-surface-variant);">
						<Icon Name=@VideocamOff style="font-size: 48px; margin-bottom: 8px;" />
						<span>@l[ProfileCameraUnavailable]</span>
					</div>
				}
				<!-- Dynamic Pose Direction Badge -->
				<div style="position: absolute; bottom: 12px; padding: 4px 12px; background: var(--md-sys-color-surface-container-highest); backdrop-filter: blur(8px); border-radius: 20px; font-size: 0.75rem; color: var(--md-sys-color-on-surface); font-weight: 600; pointer-events: none; border: 1px solid var(--md-sys-color-outline-variant);">
					@if (currentEnrollmentStage == 1)
					{
						<span>@l[ProfileLookStraight]</span>
					}
					else if (currentEnrollmentStage == 2)
					{
						<span>@l[ProfileTurnLeft]</span>
					}
					else
					{
						<span>@l[ProfileTurnRight]</span>
					}
				</div>
			</div>
			<div style="font-weight: 600; font-size: 0.95rem; color: @faceIdStatusColor; text-align: center;">
				@faceIdStatusMessage
			</div>
			<p style="font-size: 0.8rem; color: var(--md-sys-color-outline); text-align: center; margin: 0; max-width: 320px;">
				@l[ProfileCenterFaceInstruction]
			</p>
		</div>
		<div slot="actions">
			<Button Variant=@ButtonVariant.Text value="cancel" OnClick=@CloseFaceIdModal>@l[Cancel]</Button>
		</div>
	</MaterialDialog>
	}
</div>

@inherits DataComponentBase
@using System.Diagnostics.CodeAnalysis
@using static Assets.Constants.Classes.Avatar
@using static Assets.Constants.Classes.ProfileDialog
@using static Assets.Constants.Formats
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Actions
@using static Material.Web.Components.ButtonVariant
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "CameraStreamerComponentType is statically resolved from ICameraStreamerUiProvider annotated with DynamicallyAccessedMemberTypes.All")]

<Button Variant=@Outlined OnClick=@OpenProfile class=@string.Format(Two, Container, AvatarButton) AriaLabel=@l[Profile]>
	@if (profile?.Image != null && (!string.IsNullOrEmpty(profile.Image.Url) || (profile.Image.Content != null && profile.Image.Content.Length > 0)))
	{
		<img src=@profile.Image.ToProfileImage() alt="Avatar" />
	}
	else
	{
		<Icon Name=@Person />
	}
</Button>

	@if (IsOpen)
	{
	<MaterialDialog class=@AvatarContacts Open=@IsOpen OnClose=@OnClose Type="alert">
		<span slot="headline">
			<span class=@Headline>@l[EditProfile]</span>
			<IconButton form="form" value="close" AriaLabel=@l[Close] OnClick=@(e => IsOpen = false) Icon=@Close />
		</span>
		@if (FormModel is null)
		{
			<figure slot="content" class=@Content>
				<Progress IsCircular="true" FourColor="true" Indeterminate="true" />
			</figure>
		}
		else
		{
			<EditForm Model=@FormModel slot="content" method="dialog" class=@Content @onsubmit:preventDefault>
				<AntiforgeryToken />
				<List>
					<!--Id-->
					<details @ontoggle=@GetRoles>
						<summary>
							<ListItem type="button">
								<p>@FormModel?.Name.FirstName @FormModel?.Name?.LastName</p>
								<Icon Name=@Person slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>
						<fieldset class=@Content>
							<input type="hidden" name=@profile.Id value=@FormModel.Id />
							<TextField TValue="Guid?"
									   Variant=@(TextField<Guid?>.TextFieldVariant.Outlined)
									   Label=@l[Id]
									   Value=@FormModel.Id
									   ValueExpression="() => FormModel.Id"
									   Disabled="true" />
							@if (Roles.Any())
							{
								@foreach (var role in Roles.Where(r => r.UserId == profile?.Id))
								{
									<label>
										<Radio Name="role"
											   Checked=@(role.Id.ToString() == roleId)
											   OnChange=@(async () => await Switch(role.Id.ToString()))
											   touch-target="wrapper" />
										<span aria-hidden="true">@role.Name</span>
									</label>
								}
							}
							else
							{
								<Progress IsCircular="true" FourColor="true" Indeterminate="true" />
							}
						</fieldset>
						<Divider />
					</details>

					<Divider />

					<!--Phone-->
					<details>
						<summary>
							<ListItem type="button">
								<span slot="headline">@l[Phone]</span>
								<Icon Name=@Phone slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<fieldset class=@Content>
							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[Phone]
									   Value=@FormModel.Phone
									   ValueExpression="() => FormModel.Phone"
									   Disabled="true" />
						</fieldset>
						<Divider />
					</details>

					<!--Photo-->
					<details>
						<summary>
							<ListItem type="button">
								<span slot="headline">@l[PhotoLabel]</span>
								<Icon Name=@AddPhotoAlternate slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<section class=@ProfileDialogContent>
							<Material.Web.Components.FilePicker 
								Attachments=@_imageAttachments
								Label=@l[PhotoLabel]
								UploadLabel=@l[ProfileUploadPhoto]
								RemoveLabel=@l[Delete]
								Multiple="false"
								Accept="image/*"
								MaxAllowedFiles="1"
								OnChanged=@HandleImageChanged />
						</section>
						<Divider />
					</details>

					<!--Name-->
					<details>
						<summary>
							<ListItem type="button">
								<span slot="headline">@l[NameLabel]</span>
								<Icon Name=@IdCard slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<fieldset class=@Content>
							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[FirstName]
									   autofocus
									   Value=@FormModel.Name.FirstName
									   ValueChanged=@(val => FormModel.Name.FirstName = val)
									   ValueExpression="() => FormModel.Name.FirstName"
									   OnInput=@(e => FormModel.Name.FirstName = e.Value?.ToString() ?? string.Empty)
									   MaxLength="10"
									   Required="true"
									   SupportingText="*required"
									   ErrorText="Please fill out this field" />

							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[LastName]
									   Value=@FormModel.Name.LastName
									   ValueChanged=@(val => FormModel.Name.LastName = val)
									   ValueExpression="() => FormModel.Name.LastName"
									   OnInput=@(e => FormModel.Name.LastName = e.Value?.ToString() ?? string.Empty)
									   MaxLength="10"
									   Required="true"
									   SupportingText="*required"
									   ErrorText="Please fill out this field" />

							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[MiddleName]
									   Value=@FormModel.Name.MiddleName
									   ValueChanged=@(val => FormModel.Name.MiddleName = val)
									   ValueExpression="() => FormModel.Name.MiddleName"
									   OnInput=@(e => FormModel.Name.MiddleName = e.Value?.ToString() ?? string.Empty)
									   MaxLength="10"
									   Required="true"
									   SupportingText="*required"
									   ErrorText="Please fill out this field" />
						</fieldset>
						<Divider />
					</details>

					<!--Address-->
					<details>
						<summary>
							<ListItem type="button">
								<span slot="headline">@l[AddressLabel]</span>
								<Icon Name=@LocationOn slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>
						<section class=@ProfileDialogContent>
							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[City]
									   Value=@(GetOrCreateAddress().City)
									   ValueChanged=@(c => GetOrCreateAddress().City = c)
									   ValueExpression="() => GetOrCreateAddress().City" />
							<TextField TValue="string"
									   Variant=@(TextField<string>.TextFieldVariant.Outlined)
									   Label=@l[Street]
									   Value=@(GetOrCreateAddress().Street)
									   ValueChanged=@(s => GetOrCreateAddress().Street = s)
									   ValueExpression="() => GetOrCreateAddress().Street" />
						</section>
						<Divider />
					</details>

					<!--Language-->
					<details>
						<summary>
							<ListItem type="button">
								<span slot="headline">@l[LanguageLabel]</span>
								<Icon Name=@Translate slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<fieldset class=@Content>
							@foreach (var language in languages)
							{
								<label>
									<Radio Name="language"
										   Checked=@(language == (Language)FormModel.Language)
										   OnChange=@(() => FormModel.Language = language)
										   touch-target="wrapper" />
									<span aria-hidden="true">@l[language.ToString()]</span>
								</label>
							}
						</fieldset>
						<Divider />
					</details>

					<!--Accent-->
					<details>
						<summary>
							<ListItem type="button">
								<span slot="headline">@l[AccentLabel]</span>
								<Icon Name=@Palette slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>

						<section class=@ProfileDialogContent>
							<fieldset class=@ProfileThemeGrid>
								<Select Label=@l[ThemeLabel]
										Value=@ThemeString
										ValueChanged=@OnThemeChanged
										ValueExpression="() => ThemeString"
										Options=@ThemeOptions />
								<span class=@ProfileColorPickerBox>
									<span class=@ProfileColorPickerLabel>@l[PaletteColor]</span>
									<ColorPicker Value=@(color.HasValue ? Shared.Layout.Color.ToHex(color.Value) : "#00ffb3") ValueChanged=@ChangeTheme />
								</span>
							</fieldset>
						</section>
						<Divider />
					</details>

					<!--Security & Fast Login Methods (Face ID, Google, Passkeys)-->
					<details class=@ProfileDialogContent>
						<summary>
							<ListItem type="button">
								<span slot="headline">@l[ProfileSecurityAndLogin]</span>
								<Icon Name=@Security slot="start" />
								<Icon Name=@ArrowDropDown slot="end" />
							</ListItem>
						</summary>
							<p class=@ProfileSecuritySubtext>
								@l[Profile_SecuritySubtext]
							</p>

							<!-- Face ID -->
							<article class=@ProfileAuthCard>
								<Icon Name=@(isFaceIdConfigured ? CheckCircle : Face) />
								<hgroup class=@ProfileAuthText>
									<strong class=@ProfileAuthTitle>@l[ProfileFaceIdTitle]</strong>
									<small class=@ProfileAuthDesc>
										@(isFaceIdConfigured ? l[ProfileLinkedToAccount] : l[ProfileFaceLoginSubtext])
									</small>
								</hgroup>
								<menu class=@ProfileAuthActions>
									<Button Variant=@Outlined OnClick=@NavigateToFaceIdSetup>
										@(isFaceIdConfigured ? l[Update] : l[CommonConfigure])
									</Button>
									@if (isFaceIdConfigured)
									{
										<IconButton OnClick=@RemoveFaceId title=@l[ProfileDeleteBiometrics] AriaLabel=@l[ProfileDeleteBiometrics]>
											<Icon Name=@DeleteOutline class=@ProfileDeleteIcon />
										</IconButton>
									}
								</menu>
							</article>

							<!-- Google SSO -->
							<article class=@ProfileAuthCard>
								<Icon Name=@AccountCircle />
								<hgroup class=@ProfileAuthText>
									<strong class=@ProfileAuthTitle>Google SSO</strong>
									<small class=@ProfileAuthDesc>@(string.IsNullOrEmpty(FormModelEmail) ? l[ProfileNotLinked] : FormModelEmail)</small>
								</hgroup>
								<Button Variant=@Outlined OnClick=@LinkGoogleAccount>
									@(string.IsNullOrEmpty(FormModelEmail) ? l[Link] : l[Update])
								</Button>
							</article>

							<!-- Passkeys (FIDO2 / WebAuthn) -->
							<article class=@ProfileAuthCard>
								<Icon Name=@Fingerprint class=@ProfilePasskeyIcon />
								<hgroup class=@ProfileAuthText>
									<strong class=@ProfileAuthTitle>Passkeys (WebAuthn)</strong>
									<small class=@ProfileAuthDesc>@l[ProfileDeviceBiometricsSubtext]</small>
								</hgroup>
								<Button Variant=@Outlined OnClick=@RegisterPasskey>
									@(isPasskeyConfigured ? l[Update] : l[CommonConfigure])
								</Button>
							</article>
						<Divider />
					</details>

					<!--Support-->
					<ListItem Href="https://t.me/sardorsafarovv" Target="_blank" type="link">
						<span slot="headline">@l[Support]</span>
						<Icon Name=@SupportAgent slot="start" />
						<Icon Name=@Link slot="end" />
					</ListItem>

					@if (permission > Permission.Customer)
					{
						<!--Roles-->
						<ListItem Href="roles" type="button">
							<span slot="headline">@l[RolesLabel]</span>
							<Icon Name=@Group slot="start" />
							<Icon Name=@ChevronRight slot="end" />
						</ListItem>
					}

					<!--Log out-->
					<ListItem type="button" OnClick=@(async e => { await settings.SetAccessTokenAsync(string.Empty); nav.Refresh(); })>
						<span slot="headline">@l[LogOut]</span>
						<Icon Name=@Logout slot="start" />
					</ListItem>
				</List>
			</EditForm>
		}
		<footer slot="actions">
			<Button Variant=@Text value="reset" Type="reset" OnClick=@(e => { FormModel = profile?.Clone(); })>@l[ResetAction]</Button>
			<Button Variant=@Text value="save" OnClick=@(async e => { await UpdateProfile(); IsOpen = false; })>@l[Save]</Button>
			<Button Variant=@Text value="cancel" OnClick=@(e => IsOpen = false)>@l[Cancel]</Button>
		</footer>
	</MaterialDialog>
	}

	@if (isFaceIdModalOpen)
	{
	<MaterialDialog class=@FaceidProfileModal Open=@isFaceIdModalOpen OnClose=@CloseFaceIdModal Type="alert">
		<span slot="headline">
			<span class=@Headline>@l[ProfileFaceIdTitle]</span>
			<IconButton form="form" value="close" AriaLabel=@l[Close] OnClick=@CloseFaceIdModal Icon=@Close />
		</span>
		<section slot="content" class=@FaceidModalContent>
			<!-- 3-Step Calibration Progress Bar -->
			<ol class=@FaceidProgressBar>
				<li class=@(currentEnrollmentStage >= 1 ? string.Format(Two, FaceidStageStep, StepActive) : FaceidStageStep)></li>
				<li class=@(currentEnrollmentStage >= 2 ? string.Format(Two, FaceidStageStep, StepActive) : FaceidStageStep)></li>
				<li class=@(currentEnrollmentStage >= 3 ? string.Format(Two, FaceidStageStep, StepTertiary) : FaceidStageStep)></li>
			</ol>

			<figure class=@FaceidCameraViewport>
				@if (isFaceIdModalOpen && CameraStreamerUiProvider?.CameraStreamerComponentType != null)
				{
					<DynamicComponent Type=@CameraStreamerUiProvider.CameraStreamerComponentType
									  Parameters=@CameraStreamerParameters />
				}
				else if (isFaceIdModalOpen)
				{
					<figure class=@FaceidCameraFallback>
						<Icon Name=@VideocamOff class=@FaceidCameraFallbackIcon />
						<span>@l[ProfileCameraUnavailable]</span>
					</figure>
				}
				<!-- Dynamic Pose Direction Badge -->
				<span class=@FaceidDirectionBadge>
					@if (currentEnrollmentStage == 1)
					{
						<span>@l[ProfileLookStraight]</span>
					}
					else if (currentEnrollmentStage == 2)
					{
						<span>@l[ProfileTurnLeft]</span>
					}
					else
					{
						<span>@l[ProfileTurnRight]</span>
					}
				</span>
			</figure>
			<p class=@FaceidStatusMessage>
				@faceIdStatusMessage
			</p>
			<p class=@FaceidInstructionText>
				@l[ProfileCenterFaceInstruction]
			</p>
		</section>
		<footer slot="actions">
			<Button Variant=@Text value="cancel" OnClick=@CloseFaceIdModal>@l[Cancel]</Button>
		</footer>
	</MaterialDialog>
	}

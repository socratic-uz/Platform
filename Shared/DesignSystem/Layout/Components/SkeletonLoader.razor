@namespace Shared.Layout
@using Material.Web

@if (!string.IsNullOrEmpty(Height) || !string.IsNullOrEmpty(Width))
{
    <span skeleton style=@GetCustomStyle() @attributes=@AdditionalAttributes></span>
}
else
{
    <section skeleton type=@Type @attributes=@AdditionalAttributes>
        @for (int i = 0; i < Count; i++)
        {
            @if (Type == "card")
            {
                <article>
                    <figure style="height: 140px; border-radius: var(--md-sys-shape-corner-medium);"></figure>
                    <section style="display: grid; gap: 8px; align-content: space-between;">
                        <span style="width: 70%; height: 18px;"></span>
                        <span style="width: 90%;"></span>
                        <section style="display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center;">
                            <span style="width: 40%; height: 20px;"></span>
                            <span style="width: 80px; height: 36px; border-radius: 18px;"></span>
                        </section>
                    </section>
                </article>
            }
            else if (Type == "list")
            {
                <article style="display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: center; padding: 12px;">
                    <figure circle></figure>
                    <section style="display: grid; gap: 8px;">
                        <span style="width: 70%; height: 18px;"></span>
                        <span style="width: 90%;"></span>
                    </section>
                </article>
            }
            else
            {
                <span></span>
            }
        }
    </section>
}

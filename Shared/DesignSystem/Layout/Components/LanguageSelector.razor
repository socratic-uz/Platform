@namespace Shared.Layout
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common
@using static Material.Web.Components.ButtonVariant

@if (IsInline)
{
	<menu lang-selector variant="inline" role="group" aria-label=@L[LanguageLabel]>
		<Button Variant=@(IsUz ? Filled : Text)
				OnClick=@SelectUz
				Title=@L[CommonLangUz]>
			UZ
		</Button>
		<Button Variant=@(IsRu ? Filled : Text)
				OnClick=@SelectRu
				Title=@L[CommonLangRu]>
			RU
		</Button>
		<Button Variant=@(IsEn ? Filled : Text)
				OnClick=@SelectEn
				Title=@L[CommonLangEn]>
			EN
		</Button>
	</menu>
}
else
{
	<menu lang-selector variant="pill">
		<Button id="lang-menu-anchor"
				Variant=@Text
				OnClick=@ToggleDropdown
				LeadingIcon=@Translate
				TrailingIcon=@(IsOpen ? ArrowDropUp : ArrowDropDown)
				AriaLabel=@L[LanguageLabel]>
			<span>@GetLangShortLabel(CurrentLanguage)</span>
		</Button>

		<Menu Anchor="lang-menu-anchor" Open=@IsOpen OnClosed=@CloseDropdown>
			<MenuItem Selected=@IsUz
					  EndIcon=@(IsUz ? Check : null)
					  OnClick=@SelectUz>
				<span slot="start">🇺🇿</span>
				<span slot="headline">@L[CommonLangUz]</span>
			</MenuItem>
			<MenuItem Selected=@IsRu
					  EndIcon=@(IsRu ? Check : null)
					  OnClick=@SelectRu>
				<span slot="start">🇷🇺</span>
				<span slot="headline">@L[CommonLangRu]</span>
			</MenuItem>
			<MenuItem Selected=@IsEn
					  EndIcon=@(IsEn ? Check : null)
					  OnClick=@SelectEn>
				<span slot="start">🇬🇧</span>
				<span slot="headline">@L[CommonLangEn]</span>
			</MenuItem>
		</Menu>
	</menu>
}

@namespace Shared.Layout
@using static Assets.Constants.Formats
@using static Classes.Picker
@using static Icons
@using static Loc.Common

<div class=@string.Format(Three, LangSelect, IsInline ? LangSelectorInline : LangSelectorPill, Class)>
	@if (IsInline)
	{
		<div class=@LangInlineGrid role="group" aria-label=@L[LanguageLabel]>
			<button type="button"
					class=@(IsUz ? string.Format(Two, LangChipBtn, LangChipActive) : LangChipBtn)
					@onclick=@SelectUz
					aria-pressed=@(IsUz ? "true" : "false")
					title=@L[CommonLangUz]>
				<span>UZ</span>
			</button>
			<button type="button"
					class=@(IsRu ? string.Format(Two, LangChipBtn, LangChipActive) : LangChipBtn)
					@onclick=@SelectRu
					aria-pressed=@(IsRu ? "true" : "false")
					title=@L[CommonLangRu]>
				<span>RU</span>
			</button>
			<button type="button"
					class=@(IsEn ? string.Format(Two, LangChipBtn, LangChipActive) : LangChipBtn)
					@onclick=@SelectEn
					aria-pressed=@(IsEn ? "true" : "false")
					title=@L[CommonLangEn]>
				<span>EN</span>
			</button>
		</div>
	}
	else
	{
		<div class=@LangDropdownWrapper>
			<button type="button"
					class=@LangToggleBtn
					@onclick=@ToggleDropdown
					aria-expanded=@(IsOpen ? "true" : "false")
					aria-label=@L[LanguageLabel]>
				<Icon Name=@Translate />
				<span class=@LangCurrentLabel>@GetLangShortLabel(CurrentLanguage)</span>
				<Icon Name=@(IsOpen ? ArrowDropUp : ArrowDropDown) />
			</button>

			@if (IsOpen)
			{
				<button type="button" class=@LangMenuBackdrop @onclick=@CloseDropdown aria-label=@L[CloseAction]></button>
				<menu class=@LangDropdownMenu>
					<button type="button"
							class=@(IsUz ? string.Format(Two, LangMenuItem, LangMenuItemActive) : LangMenuItem)
							role="menuitem"
							@onclick=@SelectUz>
						<span class=@LangFlag>🇺🇿</span>
						<span class=@LangName>@L[CommonLangUz]</span>
						@if (IsUz)
						{
							<Icon Name=@Check />
						}
					</button>
					<button type="button"
							class=@(IsRu ? string.Format(Two, LangMenuItem, LangMenuItemActive) : LangMenuItem)
							role="menuitem"
							@onclick=@SelectRu>
						<span class=@LangFlag>🇷🇺</span>
						<span class=@LangName>@L[CommonLangRu]</span>
						@if (IsRu)
						{
							<Icon Name=@Check />
						}
					</button>
					<button type="button"
							class=@(IsEn ? string.Format(Two, LangMenuItem, LangMenuItemActive) : LangMenuItem)
							role="menuitem"
							@onclick=@SelectEn>
						<span class=@LangFlag>🇬🇧</span>
						<span class=@LangName>@L[CommonLangEn]</span>
						@if (IsEn)
						{
							<Icon Name=@Check />
						}
					</button>
				</menu>
			}
		</div>
	}
</div>

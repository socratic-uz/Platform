@namespace Shared.Layout
@using static Classes.Picker
@using static Icons

<div class="@LangSelect @(Variant == "inline" ? "lang-selector-inline" : "lang-selector-pill") @Class">
	@if (Variant == "inline")
	{
		<div class="@LangInlineGrid" role="group" aria-label="Language">
			<button type="button"
					class="@LangChipBtn @(IsUz ? LangChipActive : "")"
					@onclick="SelectUz"
					aria-pressed="@(IsUz ? "true" : "false")"
					title="O'zbekcha">
				<span>UZ</span>
			</button>
			<button type="button"
					class="@LangChipBtn @(IsRu ? LangChipActive : "")"
					@onclick="SelectRu"
					aria-pressed="@(IsRu ? "true" : "false")"
					title="Русский">
				<span>RU</span>
			</button>
			<button type="button"
					class="@LangChipBtn @(IsEn ? LangChipActive : "")"
					@onclick="SelectEn"
					aria-pressed="@(IsEn ? "true" : "false")"
					title="English">
				<span>EN</span>
			</button>
		</div>
	}
	else
	{
		<div class="@LangDropdownWrapper">
			<button type="button"
					class="@LangToggleBtn"
					@onclick="ToggleDropdown"
					aria-expanded="@(IsOpen ? "true" : "false")"
					aria-label="Language">
				<Icon Name="@Translate" />
				<span class="@LangCurrentLabel">@GetLangShortLabel(CurrentLanguage)</span>
				<Icon Name="@(IsOpen ? ArrowDropUp : ArrowDropDown)" />
			</button>

			@if (IsOpen)
			{
				<div class="lang-menu-backdrop" @onclick="CloseDropdown"></div>
				<div class="@LangDropdownMenu" role="menu">
					<button type="button"
							class="@LangMenuItem @(IsUz ? "lang-menu-item--active" : "")"
							role="menuitem"
							@onclick="SelectUz">
						<span class="lang-flag">🇺🇿</span>
						<span class="lang-name">O'zbekcha</span>
						@if (IsUz)
						{
							<Icon Name="@Check" />
						}
					</button>
					<button type="button"
							class="@LangMenuItem @(IsRu ? "lang-menu-item--active" : "")"
							role="menuitem"
							@onclick="SelectRu">
						<span class="lang-flag">🇷🇺</span>
						<span class="lang-name">Русский</span>
						@if (IsRu)
						{
							<Icon Name="@Check" />
						}
					</button>
					<button type="button"
							class="@LangMenuItem @(IsEn ? "lang-menu-item--active" : "")"
							role="menuitem"
							@onclick="SelectEn">
						<span class="lang-flag">🇬🇧</span>
						<span class="lang-name">English</span>
						@if (IsEn)
						{
							<Icon Name="@Check" />
						}
					</button>
				</div>
			}
		</div>
	}
</div>

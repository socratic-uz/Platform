
@namespace Shared.Components
<svg @onclick=@OnClick style=@Style viewBox="0 0 480 480" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
	<defs>
		<!-- Переиспользуемые фильтры -->
		<filter id="blur1">
			<feGaussianBlur stdDeviation="1" />
		</filter>
		<filter id="blur2">
			<feGaussianBlur stdDeviation="2" />
		</filter>
		<filter id="blur3">
			<feGaussianBlur stdDeviation="3" />
		</filter>
		<filter id="blur4">
			<feGaussianBlur stdDeviation="24" />
		</filter>

		<path id="baseBlob1" fill="#6f00ff" d=@d1>
			<animate attributeName="d" dur="16s" repeatCount="indefinite" values=@dvs1 />

			<animate attributeName="fill" dur="16s" repeatCount="indefinite" values=@c1 />


		</path>

		<path id="baseBlob2"
			  fill="#b073ff"
			  d=@d2>
			<animate attributeName="d" dur="16s" repeatCount="indefinite" values=@dvs2 />
			<animate attributeName="fill" dur="16s" repeatCount="indefinite" values=@c2 />
		</path>

		<path id="baseBlob3" fill="#d8bbff" d=@d3>
			<animate attributeName="d" dur="16s" repeatCount="indefinite" values=@dvs3 />
			<animate attributeName="fill" dur="16s" repeatCount="indefinite" values=@c3 />
		</path>
	</defs>

	<g id="blob">
		<use href="#baseBlob1" class="l4" />
		<use href="#baseBlob1" class="l3" />
		<use href="#baseBlob1" class="l2" />
		<use href="#baseBlob1" class="l1" />
		<use href="#baseBlob1" class="l0" />
		<use href="#baseBlob2" class="l4" />
		<use href="#baseBlob2" class="l3" />
		<use href="#baseBlob2" class="l2" />
		<use href="#baseBlob2" class="l1" />
		<use href="#baseBlob2" class="l0" />
		<use href="#baseBlob3" class="l4" />
		<use href="#baseBlob3" class="l3" />
		<use href="#baseBlob3" class="l2" />
		<use href="#baseBlob3" class="l1" />
		<use href="#baseBlob3" class="l0" />
	</g>
</svg>

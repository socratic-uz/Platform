@namespace Shared.Components
<svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
	<defs>
		<filter id="blur4">
			<feGaussianBlur stdDeviation="4" />
		</filter>
		<filter id="blob-soft-blur" x="-50%" y="-50%" width="200%" height="200%">
			<feGaussianBlur stdDeviation="36" />
		</filter>
		<filter id="glass-distortion" x="-20%" y="-20%" width="140%" height="140%">
			<feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="2" result="noise" />
			<feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
		</filter>
		<pattern id="svg-pattern" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
			<svg width="20" height="20" viewBox="0 0 1000 1000">
				<g fill="#47ffd3" opacity="0.35">
					<circle cx="50" cy="50" r="50"></circle>
				</g>
			</svg>
		</pattern>

	
		<path id="baseBlob1">
			<animate attributeName="d" dur="16s" repeatCount="indefinite" values=@d[0] />
			<animate attributeName="fill" dur="16s" repeatCount="indefinite" values=@f[0] />
		</path>
		<path id="baseBlob2">
			<animate attributeName="d" dur="16s" repeatCount="indefinite" values=@d[1] />
			<animate attributeName="fill" dur="16s" repeatCount="indefinite" values=@f[1] />
		</path>
		<path id="baseBlob3">
			<animate attributeName="d" dur="16s" repeatCount="indefinite" values=@d[2] />
			<animate attributeName="fill" dur="16s" repeatCount="indefinite" values=@f[2] />
		</path>
		<path id="baseBlob4">
			<animate attributeName="d" dur="16s" repeatCount="indefinite" values=@d[3] />
			<animate attributeName="fill" dur="16s" repeatCount="indefinite" values=@f[3] />
		</path>
		<path id="baseBlob5">
			<animate attributeName="d" dur="16s" repeatCount="indefinite" values=@d[4] />
			<animate attributeName="fill" dur="16s" repeatCount="indefinite" values=@f[4] />
		</path>
	</defs>


	<rect x="0" y="0" fill="#0d0f22"></rect>

	<g id="blob" filter="url(#blob-soft-blur)" style="transform:translate(50%, 50%); opacity: 0.85; filter: blur(36px);">
		<use id="blob1" href="#baseBlob1" />
		<use id="blob2" href="#baseBlob2" />
		<use id="blob3" href="#baseBlob3" />
		<use id="blob4" href="#baseBlob4" />
		<use id="blob5" href="#baseBlob5" />
	</g>

	<rect x="0" y="0" fill="url(#svg-pattern)"></rect>
</svg>


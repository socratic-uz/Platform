@using Material.Web
<div class="@Classes.Form.MaterialCounter">
	@if (OrderItem != null)
	{
		<IconButton Icon="@Icons.Remove" Variant="IconButtonVariant.FilledTonal" OnClick=@(async e => await Remove.InvokeAsync(OrderItem)) />
		<span class="counter-quantity">@OrderItem.Quantity</span>
		<IconButton Icon="@Icons.Add" Variant="IconButtonVariant.Filled" OnClick=@(async e => await Add.InvokeAsync(OrderItem)) />
	}
	else
	{
		<Button Variant="ButtonVariant.Filled" OnClick=@(async e => await CreateOrderItem.InvokeAsync((Product, OrderItem)))>
			<md-icon slot="icon">@Icons.AddShoppingCart</md-icon>
			В корзину
		</Button>
	}
</div>

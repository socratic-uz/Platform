@using Material.Web
@using Material.Web.Components
@using static Classes.Form
@using static Icons
@using static Loc.Common
@using static Material.Web.Components.IconButtonVariant

<fieldset class=@MaterialCounter>
	@if (OrderItem != null)
	{
		<IconButton Icon=@Remove Variant=@FilledTonal OnClick=@(async e => await OnRemove.InvokeAsync(OrderItem)) />
		<span class=@CounterQuantityClass>@OrderItem.Quantity</span>
		<IconButton Icon=@Add Variant=@Filled OnClick=@(async e => await OnAdd.InvokeAsync(OrderItem)) />
	}
	else
	{
		<Button OnClick=@(async e => await CreateOrderItem.InvokeAsync((Product, OrderItem))) Icon=@AddShoppingCart>
			@L[ProductVariantAddToCart]
		</Button>
	}
</fieldset>

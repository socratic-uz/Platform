@using Material.Web
@using Material.Web.Components
@using static Classes.Form
@using static Icons
@using static Loc.Common
@using static Material.Web.Components.IconButtonVariant

<div class=@MaterialCounter>
	@if (OrderItem != null)
	{
		<IconButton Icon=@RemoveIcon Variant=@IconFilledTonal OnClick=@(async e => await Remove.InvokeAsync(OrderItem)) />
		<span class=@CounterQuantityClass>@OrderItem.Quantity</span>
		<IconButton Icon=@AddIcon Variant=@IconFilled OnClick=@(async e => await Add.InvokeAsync(OrderItem)) />
	}
	else
	{
		<Button Variant=@BtnFilled OnClick=@(async e => await CreateOrderItem.InvokeAsync((Product, OrderItem))) Icon=@AddShoppingCart>
			@L[ProductVariantAddToCart]
		</Button>
	}
</div>

@inject IStringLocalizer L

<div class="@M3.Search.Container">
    <TextField TValue="string" 
               Variant="TextField<string>.TextFieldVariant.Outlined" 
               Placeholder="@T("Search_Placeholder", "Поиск товаров...")" 
               Value="@SearchText" 
               ValueChanged="v => SearchText = v" 
               ValueExpression="() => SearchText" 
               HasLeadingIcon="true"
               LeadingIcon="search"
               class="search-input-field">
        @if (!string.IsNullOrEmpty(SearchText))
        {
            <IconButton Icon="clear" Slot="trailing-icon" OnClick="() => SearchText = string.Empty" />
        }
    </TextField>
</div>

@code {
    [Parameter] public EventCallback<string> OnSubmit { get; set; }

    string? searchText;
    string? SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            OnSubmit.InvokeAsync(value);
        }
    }

    private string T(string key, string fallback)
    {
        if (L == null) return fallback;
        var loc = L[key];
        return (loc == null || loc.ResourceNotFound || string.IsNullOrWhiteSpace(loc.Value) || loc.Value == key) ? fallback : loc.Value;
    }
}

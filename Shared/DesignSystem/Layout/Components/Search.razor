@namespace Shared.Layout
@using static Classes.Search
@using static Loc.Common
@using static Icons

<TextField TValue="string"
           Variant=@(TextField<string>.TextFieldVariant.Outlined)
           Placeholder=@L[SearchPlaceholder]
           Value=@SearchText
           ValueChanged=@(v => SearchText = v)
           ValueExpression=@(() => SearchText)
           HasLeadingIcon=@true
           LeadingIcon=@SearchIcon
           HasTrailingIcon=@(!string.IsNullOrEmpty(SearchText))
           TrailingIcon=@Clear
           OnTrailingIconClick=@ClearSearch
           role="search"
           Class=@Container />

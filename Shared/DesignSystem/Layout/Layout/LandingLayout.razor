@namespace Shared.Layout
@inherits LayoutComponentBase
@using Domain.Enums
@using Microsoft.AspNetCore.Components
@using SharedKernel.Extensions
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Landing
@using static Material.Web.Components.ButtonVariant

<Color />
<layout landing />
@if (!IsRootLanding)
{
	<Blob />
}

@if (IsRootLanding)
{
	<aside floating aria-label="Quick Actions">
		<LanguageSelector Variant="pill" />
		<Button Variant=@Filled Href="/signin" Icon=@Login title=@L[SocraticID]>
			@L[SocraticID]
		</Button>
	</aside>
}
else
{
	<Header ShowDefaultActions=@false>
		<CenterContent>
			<nav aria-label=@L[MainNavigation]>
				<a href="/kiosk/@(ObjectIdExtension.DemoId)">
					<Icon Name=@Storefront />
					<span>@L[Showroom]</span>
				</a>
				<a href="/docs">
					<Icon Name=@MenuBook />
					<span>@L[Documentation]</span>
				</a>
				<a href="/help">
					<Icon Name=@HelpOutline />
					<span>@L[HelpText]</span>
				</a>
				<a href="/about">
					<Icon Name=@Info />
					<span>@L[AboutText]</span>
				</a>
			</nav>
		</CenterContent>
		<EndContent>
			<LanguageSelector Variant="pill" />
			<Button Variant=@Outlined Href="/signin" Icon=@Login>
				@L[SocraticID]
			</Button>
			<IconButton Icon=@MenuIcon OnClick=@ToggleMobileMenu AriaLabel=@(IsMobileMenuOpen ? L[CloseAction] : L[Docs_ShowMenu]) />
		</EndContent>
	</Header>

	<HeaderOutlet />

	@if (IsMobileMenuOpen)
	{
		<IconButton backdrop OnClick=@CloseMobileMenu AriaLabel=@L[CloseAction] />
		<nav drawer aria-label=@L[MainNavigation]>
			<a href="/kiosk/@(ObjectIdExtension.DemoId)" @onclick=@CloseMobileMenu>
				<Icon Name=@Storefront />
				<span>@L[Showroom]</span>
			</a>
			<a href="/docs" @onclick=@CloseMobileMenu>
				<Icon Name=@MenuBook />
				<span>@L[Documentation]</span>
			</a>
			<a href="/help" @onclick=@CloseMobileMenu>
				<Icon Name=@HelpOutline />
				<span>@L[HelpText]</span>
			</a>
			<a href="/about" @onclick=@CloseMobileMenu>
				<Icon Name=@Info />
				<span>@L[AboutText]</span>
			</a>
			<Divider />
			<footer>
				<LanguageSelector Variant="inline" />
			</footer>
		</nav>
	}
}

<ErrorBoundary @ref=@ErrorBoundaryRef>
	<ChildContent>
		@Body
	</ChildContent>
	<ErrorContent Context="ex">
		<article error role="alert">
			<h3>@L[ErrorLoading]</h3>
			<p>@ex.Message</p>
			<Button Variant=@Filled OnClick=@Recover>@L[TryAgain]</Button>
		</article>
	</ErrorContent>
</ErrorBoundary>

@if (Nav != null && !string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri).Trim('/')))
{
	<FooterOutlet />
}

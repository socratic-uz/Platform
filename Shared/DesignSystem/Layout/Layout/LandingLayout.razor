@namespace Shared.Layout
@inherits LayoutComponentBase
@using Domain.Enums
@using Microsoft.AspNetCore.Components
@using SharedKernel.Extensions
@using static Assets.Constants.Classes.Cards
@using static Assets.Constants.Classes.Feedback
@using static Assets.Constants.Icons
@using static Assets.Constants.Loc.Common
@using static Assets.Constants.Loc.Landing
@using static Material.Web.Components.ButtonVariant

<Color />
<layout landing />
@if (!IsRootLanding)
{
	<Blob />
}

@if (IsRootLanding)
{
	<aside class=@LandingFloatingControlsClass aria-label="Quick Actions">
		<LanguageSelector Variant="pill" />
		<Button Variant=@Filled Href="/signin" Icon=@Login class=@LandingFloatingAuthBtnClass title=@L[SocraticID]>
			@L[SocraticID]
		</Button>
	</aside>
}
else
{
	<Header Class=@LandingHeaderClass ShowDefaultActions=@false>
		<CenterContent>
			<nav class=@LandingHeaderNavClass aria-label=@L[MainNavigation]>
				<a href="/kiosk/@(ObjectIdExtension.DemoId)" class=@LandingNavLinkClass>
					<Icon Name=@Storefront />
					<span>@L[Showroom]</span>
				</a>
				<a href="/docs" class=@LandingNavLinkClass>
					<Icon Name=@MenuBook />
					<span>@L[Documentation]</span>
				</a>
				<a href="/help" class=@LandingNavLinkClass>
					<Icon Name=@HelpOutline />
					<span>@L[HelpText]</span>
				</a>
				<a href="/about" class=@LandingNavLinkClass>
					<Icon Name=@Info />
					<span>@L[AboutText]</span>
				</a>
			</nav>
		</CenterContent>
		<EndContent>
			<LanguageSelector Variant="pill" />
			<Button Variant=@Outlined Href="/signin" Icon=@Login class=@LandingAuthBtnClass>
				@L[SocraticID]
			</Button>
			<IconButton Icon=@MenuIcon Class=@LandingMobileMenuToggleClass OnClick=@ToggleMobileMenu AriaLabel=@(IsMobileMenuOpen ? L[CloseAction] : L[Docs_ShowMenu]) />
		</EndContent>
	</Header>

	<HeaderOutlet />

	@if (IsMobileMenuOpen)
	{
		<IconButton class=@LandingMobileMenuBackdropClass OnClick=@CloseMobileMenu AriaLabel=@L[CloseAction] />
		<nav class=@LandingMobileMenuDrawerClass aria-label=@L[MainNavigation]>
			<a href="/kiosk/@(ObjectIdExtension.DemoId)" class=@MobileNavItemClass @onclick=@CloseMobileMenu>
				<Icon Name=@Storefront />
				<span>@L[Showroom]</span>
			</a>
			<a href="/docs" class=@MobileNavItemClass @onclick=@CloseMobileMenu>
				<Icon Name=@MenuBook />
				<span>@L[Documentation]</span>
			</a>
			<a href="/help" class=@MobileNavItemClass @onclick=@CloseMobileMenu>
				<Icon Name=@HelpOutline />
				<span>@L[HelpText]</span>
			</a>
			<a href="/about" class=@MobileNavItemClass @onclick=@CloseMobileMenu>
				<Icon Name=@Info />
				<span>@L[AboutText]</span>
			</a>
			<Divider Class=@MobileNavDividerClass />
			<footer class=@MobileNavFooterClass>
				<LanguageSelector Variant="inline" />
			</footer>
		</nav>
	}
}

<ErrorBoundary @ref=@ErrorBoundaryRef>
	<ChildContent>
		@Body
	</ChildContent>
	<ErrorContent Context="ex">
		<article class=@ErrorBoundaryCard>
			<h3 class=@ErrorBoundaryTitle>@L[ErrorLoading]</h3>
			<p class=@ErrorBoundaryDesc>@ex.Message</p>
			<Button Variant=@Filled OnClick=@Recover>@L[TryAgain]</Button>
		</article>
	</ErrorContent>
</ErrorBoundary>

@if (Nav != null && !string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri).Trim('/')))
{
	<FooterOutlet />
}
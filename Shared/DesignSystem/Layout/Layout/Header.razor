@namespace Shared.Layout
@using Microsoft.AspNetCore.Components.Sections
@using static Classes.Header
@using static Icons

@if (Visible && !Empty)
{
	<SectionContent SectionName=@Name>
		@if (ShouldRenderCustom)
		{
			@ChildContent
		}
		else
		{
			<!-- START ZONE: Socratic Platform Brand + Tenant / Breadcrumb -->
			<nav class=@HeaderStartZone aria-label="Breadcrumb">
				@if (ShowBrand)
				{
					<a href="/" class=@HeaderBrandLink title="Socratic">
						<Icon Name=@AutoAwesome class=@BrandIconBox />
						<span class=@HeaderBrandText>Socratic</span>
					</a>
				}
				@if (StartContent != null)
				{
					@StartContent
				}
				<HeaderStartOutlet />
			</nav>

			<!-- CENTER ZONE: Navigation Links or Center Search Bar -->
			@if (CenterContent != null)
			{
				@CenterContent
			}
			<HeaderCenterOutlet />

			<!-- END ZONE: Actions (Trial, Custom Actions, Language, Avatar) -->
			<menu class=@HeaderEndZone aria-label="User Actions">
				@if (EndContent != null)
				{
					@EndContent
				}
				<HeaderEndOutlet />
				@if (ShowDefaultActions)
				{
					<LanguageSelector Variant="pill" />
				}
				@if (ShowAvatar)
				{
					<Avatar />
				}
			</menu>
		}
	</SectionContent>
}


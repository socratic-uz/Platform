@namespace Shared.Layout
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Sections
@using static Icons

<header class="@Classes.Common.AppHeader @(Sticky ? Classes.Header.Sticky : string.Empty) @Class">
	<div class="@Classes.Footer.HeaderGridLayout">
		<!-- START ZONE: Socratic Platform Brand + Tenant / Breadcrumb -->
		<div class="@Classes.Cart.HeaderStartZone">
			@if (ShowBrand)
			{
				<div class="@Classes.Cart.HeaderBrandZone">
					<a href="/" class="@Classes.Cart.HeaderBrandLink" title="Socratic">
						<span class="@Classes.Header.BrandIconBox">
							<Icon Name="@AutoAwesome" />
						</span>
						<span class="@Classes.Cart.HeaderBrandText">Socratic</span>
					</a>
				</div>
			}
			@if (StartContent != null)
			{
				@StartContent
			}
		</div>

		<!-- CENTER ZONE: Navigation Links or Center Search Bar -->
		<div class="@Classes.GridLayout.HeaderCenterZone">
			@if (CenterContent != null)
			{
				@CenterContent
			}
			@if (ChildContent != null)
			{
				@ChildContent
			}
		</div>

		<!-- END ZONE: Actions (Trial, Custom Actions, Language, Avatar) -->
		<div class="@Classes.Cart.HeaderEndZone">
			@if (EndContent != null)
			{
				@EndContent
			}
			@if (ShowDefaultActions)
			{
				<LanguageSelector Variant="pill" />
			}
			@if (ShowAvatar)
			{
				<Avatar />
			}
		</div>
	</div>
</header>

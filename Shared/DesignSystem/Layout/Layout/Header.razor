@namespace Shared.Layout
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Sections
@using static Classes.Header
@using static Icons

<header class=@ComputedHeaderClass>
	<div class=@HeaderGridLayout>
		<!-- START ZONE: Socratic Platform Brand + Tenant / Breadcrumb -->
		<div class=@HeaderStartZone>
			@if (ShowBrand)
			{
				<div class=@HeaderBrandZone>
					<a href="/" class=@HeaderBrandLink title="Socratic">
						<span class=@BrandIconBox>
							<Icon Name=@AutoAwesome />
						</span>
						<span class=@HeaderBrandText>Socratic</span>
					</a>
				</div>
			}
			@if (StartContent != null)
			{
				@StartContent
			}
		</div>

		<!-- CENTER ZONE: Navigation Links or Center Search Bar -->
		<nav class=@HeaderCenterZone aria-label="Main Navigation">
			@if (CenterContent != null)
			{
				@CenterContent
			}
			@if (ChildContent != null)
			{
				@ChildContent
			}
		</nav>

		<!-- END ZONE: Actions (Trial, Custom Actions, Language, Avatar) -->
		<section class=@HeaderEndZone aria-label="User Actions">
			@if (EndContent != null)
			{
				@EndContent
			}
			@if (ShowDefaultActions)
			{
				<LanguageSelector Variant="pill" />
			}
			@if (ShowAvatar)
			{
				<Avatar />
			}
		</section>
	</div>
</header>

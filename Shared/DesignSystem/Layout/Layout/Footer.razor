@namespace Shared.Layout
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Sections
@using static Icons

<footer class="app-footer @Class">
	<div class="footer-container">
		@if (ChildContent != null)
		{
			<div class="footer-custom-slot">
				@ChildContent
			</div>
		}

		<div class="footer-primary-grid">
			<!-- Brand Column -->
			<div class="footer-brand-col">
				<a href="/" class="footer-brand-link">
					<span class="footer-brand-badge">
						<Icon Name="@AutoAwesome" />
					</span>
					<span class="footer-brand-title">Socratic</span>
				</a>
				<p class="footer-brand-tagline">
					@T("Footer_Tagline", "Универсальная омниканальная AI-экосистема для бизнеса, торговли, смарт-киосков и компьютерного зрения.")
				</p>
				<div class="footer-system-status">
					<span class="status-pulse-dot" aria-hidden="true"></span>
					<span class="status-text">@T("Footer_Status", "Все системы работают стабильно")</span>
				</div>
			</div>

			<!-- Nav Column 1: Каталог & Киоски -->
			<div class="footer-nav-col">
				<h4 class="footer-col-title">@T("Footer_Col_Catalog", "Каталог & Киоски")</h4>
				<ul class="footer-links-list">
					<li><a href="/kiosk/@(SharedKernel.Extensions.ObjectIdExtension.DemoId)"><Icon Name="@Storefront" /> <span>@T("Showroom", "Витрина товаров")</span></a></li>
					<li><a href="/kiosk/@(SharedKernel.Extensions.ObjectIdExtension.SocraticId)"><Icon Name="@BusinessCenter" /> <span>@T("Plans", "Тарифы и подключение")</span></a></li>
					<li><a href="/home"><Icon Name="@Domain" /> <span>@T("Places", "Каталог заведений")</span></a></li>
					<li><a href="/map"><Icon Name="@Map" /> <span>@T("Map", "Интерактивная карта")</span></a></li>
				</ul>
			</div>

			<!-- Nav Column 2: Управление & POS -->
			<div class="footer-nav-col">
				<h4 class="footer-col-title">@T("Footer_Col_Management", "Управление & POS")</h4>
				<ul class="footer-links-list">
					<li><a href="/orders"><Icon Name="@ReceiptLong" /> <span>@T("Orders", "Заказы")</span></a></li>
					<li><a href="/payment"><Icon Name="@Payments" /> <span>@T("Payment", "Оплата и финансы")</span></a></li>
					<li><a href="/qr-designer"><Icon Name="@QrCode2" /> <span>@T("QRDesigner", "QR Конструктор")</span></a></li>
					<li><a href="/seat-designer"><Icon Name="@EventSeat" /> <span>@T("SeatDesigner", "Схема залов")</span></a></li>
					<li><a href="/terminal"><Icon Name="@PointOfSale" /> <span>@T("Terminal", "POS Терминал")</span></a></li>
				</ul>
			</div>

			<!-- Nav Column 3: Ресурсы & Инфо -->
			<div class="footer-nav-col">
				<h4 class="footer-col-title">@T("Footer_Col_Resources", "Ресурсы & Инфо")</h4>
				<ul class="footer-links-list">
					<li><a href="/docs"><Icon Name="@MenuBook" /> <span>@T("Documentation", "Документация")</span></a></li>
					<li><a href="/help"><Icon Name="@HelpOutline" /> <span>@T("Help", "Справка и FAQ")</span></a></li>
					<li><a href="/about"><Icon Name="@Info" /> <span>@T("About", "О платформе")</span></a></li>
					<li><a href="/signin"><Icon Name="@Login" /> <span>@T("SocraticID", "Socratic ID")</span></a></li>
				</ul>
			</div>

			<!-- Nav Column 4: Сообщество & Поддержка -->
			<div class="footer-nav-col">
				<h4 class="footer-col-title">@T("Footer_Col_Community", "Поддержка & Связь")</h4>
				<ul class="footer-links-list">
					<li><a href="https://t.me/sardorsafarovv" target="_blank" rel="noopener noreferrer"><Icon Name="@SupportAgent" /> <span>@T("Support", "Служба заботы")</span></a></li>
					<li><a href="https://t.me/socratic_uz_bot" target="_blank" rel="noopener noreferrer"><Icon Name="@Send" /> <span>Telegram Bot</span></a></li>
					<li><a href="https://www.instagram.com/socratic.uz/" target="_blank" rel="noopener noreferrer"><Icon Name="@CameraAlt" /> <span>Instagram</span></a></li>
				</ul>
			</div>
		</div>

		<!-- Sub-Footer Bottom Bar -->
		<div class="footer-bottom-bar">
			<div class="footer-copyright">
				&copy; @DateTime.Now.Year Socratic. @T("AllRightsReserved", "Все права защищены.")
			</div>
			<div class="footer-lang-container">
				<LanguageSelector Variant="inline" />
			</div>
			<div class="footer-trust-info">
				<span class="trust-badge">
					<Icon Name="@VerifiedUser" />
					<span>256-bit SSL • Zero-Trust Cloud</span>
				</span>
			</div>
		</div>
	</div>
</footer>

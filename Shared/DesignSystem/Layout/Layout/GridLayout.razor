@namespace Shared.Layout
@inherits LayoutComponentBase

@using Domain.Enums
@using Microsoft.AspNetCore.Components
@using static Loc.Common
@using static Material.Web.Components.ButtonVariant

<Color />

<Header ShowAvatar=@true>
	<StartContent>
		<SectionOutlet SectionName="header-start" />
	</StartContent>
	<CenterContent>
		<SectionOutlet SectionName="header-center" />
	</CenterContent>
	<EndContent>
		<SectionOutlet SectionName="header-end" />
	</EndContent>
	<ChildContent>
		<SectionOutlet SectionName="header" />
	</ChildContent>
</Header>

<Nav>
	<SectionOutlet SectionName="nav" />
</Nav>

<ErrorBoundary @ref=@ErrorBoundaryRef>
	<ChildContent>
		@Body
	</ChildContent>
	<ErrorContent Context="ex">
		<div style="padding: 2rem; max-width: 600px; margin: 2rem auto; border-radius: 12px; background: var(--md-sys-color-error-container); border: 1px solid var(--md-sys-color-outline-variant); color: var(--md-sys-color-on-error-container); text-align: center;">
			<h3 style="color: var(--md-sys-color-error); margin-bottom: 0.5rem;">@L[ErrorLoading]</h3>
			<p style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 1rem;">@ex.Message</p>
			<Button Variant=@Filled OnClick=@Recover>@L[TryAgain]</Button>
		</div>
	</ErrorContent>
</ErrorBoundary>

<Footer>
	<SectionOutlet SectionName="footer" />
</Footer>

@namespace Shared.Layout
@inherits LayoutComponentBase

@using Domain.Enums
@using Microsoft.AspNetCore.Components
@using static Assets.Constants.Loc.Common
@using static Material.Web.Components.ButtonVariant

<layout grid />
<Color />

<Nav />

<HeaderOutlet />
<NavOutlet />

<ErrorBoundary @ref=@ErrorBoundaryRef>
	<ChildContent>
		@Body
	</ChildContent>
	<ErrorContent Context="ex">
		<article error role="alert">
			<h3>@L[ErrorLoading]</h3>
			<p>@ex.Message</p>
			<Button Variant=@Filled OnClick=@Recover>@L[TryAgain]</Button>
		</article>
	</ErrorContent>
</ErrorBoundary>

<FooterOutlet />

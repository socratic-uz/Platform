<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<RootNamespace>Web.UI.Client</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<NoWarn>$(NoWarn);CS8618;CS8604;CS8602;CS8625</NoWarn>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<WasmEnableSIMD>false</WasmEnableSIMD>
		<WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
		<LangVersion>preview</LangVersion>

		<WasmNativeDebugSymbols Condition="'$(Configuration)' == 'Debug'">true</WasmNativeDebugSymbols>
		<WasmNativeDebugSymbols Condition="'$(Configuration)' != 'Debug'">false</WasmNativeDebugSymbols>
		<WasmNativeStrip Condition="'$(Configuration)' != 'Debug'">true</WasmNativeStrip>
		<Configurations>Debug;Release</Configurations>
		
		<!-- Hybrid Globalization: использует нативный браузерный Intl API вместо 2.6 МБ ICU .dat таблиц -->
		<HybridGlobalization>true</HybridGlobalization>

		<!-- Trimming: вырезает неиспользуемые BCL-сборки (System.Security, System.Xml и др.) из WebAssembly -->
		<PublishTrimmed Condition="'$(Configuration)' != 'Debug'">true</PublishTrimmed>
		<TrimMode Condition="'$(Configuration)' != 'Debug'">partial</TrimMode>
	</PropertyGroup>


	<ItemGroup>




	

		<ProjectReference Include="$(Composition)" Condition="'$(Composition)' != '' and Exists('$(Composition)')" />
		<ProjectReference Include="../../Shared/Composition/Composition.csproj" Condition="('$(Composition)' == '' or !Exists('$(Composition)')) and Exists('../../Shared/Composition/Composition.csproj')" />
	</ItemGroup>


	<ItemGroup>
	  <PackageReference Include="SkiaSharp.Views.Blazor" />
	</ItemGroup>

	<!-- Pack Web.UI.Client .wasm + icudt into single bundle for standalone WasmAppHost (:5080) and sync modified index.html + _framework to Assets/wwwroot/ -->
	<Target Name="BundleClientWasmOnBuild"
	        AfterTargets="Build"
	        Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="node &quot;$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../Shared/DesignSystem/Assets/scripts/bundle-wasm.mjs'))&quot; --build-dir &quot;$([System.IO.Path]::GetFullPath('$(OutDir).'))&quot; --manifest-prefix Web.UI.Client --assets-wwwroot &quot;$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../Shared/DesignSystem/Assets/wwwroot'))&quot;"
		      WorkingDirectory="$(MSBuildThisFileDirectory)"
		      StandardOutputImportance="Normal" />
	</Target>

</Project>

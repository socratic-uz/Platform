<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Web.UI.Client</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<NoWarn>$(NoWarn);CS8618;CS8604;CS8602;CS8625</NoWarn>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<WasmEnableSIMD>false</WasmEnableSIMD>
		<WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
		<LangVersion>preview</LangVersion>

		<WasmNativeDebugSymbols Condition="'$(Configuration)' == 'Debug'">true</WasmNativeDebugSymbols>
		<WasmNativeDebugSymbols Condition="'$(Configuration)' != 'Debug'">false</WasmNativeDebugSymbols>
		<WasmNativeStrip Condition="'$(Configuration)' != 'Debug'">true</WasmNativeStrip>
		<Configurations>Debug;Release;LocalDebug;Runner;Cluster</Configurations>
		
		<!-- Hybrid Globalization: использует нативный браузерный Intl API вместо 2.6 МБ ICU .dat таблиц -->
		<HybridGlobalization>true</HybridGlobalization>

		<!-- Trimming: вырезает неиспользуемые BCL-сборки (System.Security, System.Xml и др.) из WebAssembly -->
		<PublishTrimmed Condition="'$(Configuration)' != 'Debug'">true</PublishTrimmed>
		<TrimMode Condition="'$(Configuration)' != 'Debug'">partial</TrimMode>
	</PropertyGroup>

	<ItemGroup>
		<!-- Map lazy assemblies -->
		<BlazorWebAssemblyLazyLoad Include="Map.wasm" />
		<BlazorWebAssemblyLazyLoad Include="NetTopologySuite.wasm" />

		<!-- Chat lazy assemblies (OpenAI SDK is 5MB) -->
		<BlazorWebAssemblyLazyLoad Include="Chat.wasm" />
		<BlazorWebAssemblyLazyLoad Include="OpenAI.wasm" />
		<BlazorWebAssemblyLazyLoad Include="Microsoft.Extensions.AI.wasm" />
		<BlazorWebAssemblyLazyLoad Include="Microsoft.Extensions.AI.OpenAI.wasm" />

		<!-- Vision, Biometrics & Video lazy assemblies -->
		<BlazorWebAssemblyLazyLoad Include="Vision.wasm" />
		<BlazorWebAssemblyLazyLoad Include="Biometrics.Processor.wasm" />
		<BlazorWebAssemblyLazyLoad Include="FFmpegProcessor.wasm" />
	</ItemGroup>


	<ItemGroup>




	

		<ProjectReference Include="$(Composition)" Condition="'$(Composition)' != '' and Exists('$(Composition)')" />
		<ProjectReference Include="../../Shared/Composition/Composition.csproj" Condition="('$(Composition)' == '' or !Exists('$(Composition)')) and Exists('../../Shared/Composition/Composition.csproj')" />
	</ItemGroup>


	<ItemGroup>
	  <PackageReference Include="SkiaSharp.Views.Blazor" />
	</ItemGroup>



</Project>

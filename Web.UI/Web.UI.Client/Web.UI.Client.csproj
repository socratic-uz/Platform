<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Web.UI.Client</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<NoWarn>$(NoWarn);CS8618;CS8604;CS8602;CS8625</NoWarn>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<WasmEnableSIMD>false</WasmEnableSIMD>
		<WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
		<LangVersion>preview</LangVersion>

		<WasmNativeDebugSymbols Condition="'$(Configuration)' == 'Debug'">true</WasmNativeDebugSymbols>
		<WasmNativeDebugSymbols Condition="'$(Configuration)' != 'Debug'">false</WasmNativeDebugSymbols>
		<WasmNativeStrip Condition="'$(Configuration)' != 'Debug'">true</WasmNativeStrip>
		<Configurations>Debug;Release;LocalDebug;Runner;Cluster</Configurations>
		
		<!-- Отключаем инвариантную глобализацию для правильной работы локализации -->
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>


	<ItemGroup>




	

		<!-- Unified Shared Platform App (aggregating Shell, Features, DesignSystem, and Hardware) -->
		<ProjectReference Include="$(Shared)" Condition="'$(Shared)' != '' and Exists('$(Shared)')" />
		<ProjectReference Include="../../Shared/Shared/Shared.csproj" Condition="('$(Shared)' == '' or !Exists('$(Shared)')) and Exists('../../Shared/Shared/Shared.csproj')" />
	</ItemGroup>


	<ItemGroup>
	  <PackageReference Include="SkiaSharp.Views.Blazor" />
	</ItemGroup>



</Project>

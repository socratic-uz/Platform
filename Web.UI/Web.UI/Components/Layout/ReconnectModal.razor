@namespace Web.UI.Components.Layout
@using Material.Web.Components

<script type="module" src=@Scripts.Layouts.ReconnectModal></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <section>
        <figure aria-hidden="true">
            <span></span>
            <span></span>
        </figure>
        <p data-state="first-attempt">
            Rejoining the server...
        </p>
        <p data-state="repeated-attempt">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p data-state="failed">
            Failed to rejoin.<br />Please retry or reload the page.
        </p>
        <Button id="components-reconnect-button" data-state="failed">
            Retry
        </Button>
        <p data-state="paused">
            The session has been paused by the server.
        </p>
        <Button id="components-resume-button" data-state="paused">
            Resume
        </Button>
        <p data-state="resume-failed">
            Failed to resume the session.<br />Please reload the page.
        </p>
    </section>
</dialog>

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="@Classes.Common.ComponentsReconnectContainer">
        <div class="@Classes.Common.ComponentsRejoiningAnimation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="@Classes.Common.ComponentsReconnectFirstAttemptVisible">
            Rejoining the server...
        </p>
        <p class="@Classes.Common.ComponentsReconnectRepeatedAttemptVisible">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="@Classes.Common.ComponentsReconnectFailedVisible">
            Failed to rejoin.<br />Please retry or reload the page.
        </p>
        <button id="components-reconnect-button" class="@Classes.Common.ComponentsReconnectFailedVisible">
            Retry
        </button>
        <p class="@Classes.Common.ComponentsPauseVisible">
            The session has been paused by the server.
        </p>
        <button id="components-resume-button" class="@Classes.Common.ComponentsPauseVisible">
            Resume
        </button>
        <p class="@Classes.Common.ComponentsResumeFailedVisible">
            Failed to resume the session.<br />Please reload the page.
        </p>
    </div>
</dialog>

@page "/components"
@layout NavOnlyLayout
@namespace Shared.Pages

@using Material.Web.Components
@using Material.Web.Components.Labs
@using Smart.Web.Components
@using Smart.Web.Services
@using Socratic.QrDesigner
@using Markdown.Web
@using QuickGrid
@using QuickGrid.Infrastructure
@using Chat.Web
@using Microsoft.Extensions.AI
@using SeatDesigner.Components
@using Shared.Components
@using Shared.Modules.Auction
@using Shared.Modules.Booking
@using Shared.Modules.Donation
@using Shared.Modules.Gift
@using Shared.Modules.GroupBuy
@using Shared.Modules.Hotel
@using Shared.Modules.Quote
@using Shared.Modules.Delivery
@using Shared.Modules.Subscription
@using Shopping.Application.Protos
@using SharedKernel.ValueObjects
@using Domain.Entities

<PageTitle>Компоненты платформы Socratic • Showcase</PageTitle>

<main class="showcase-page">
    @if (isMobileSidebarOpen)
    {
        <div class="showcase-sidebar-backdrop" @onclick="ToggleMobileSidebar"></div>
    }

    <!-- Sidebar Navigation -->
    <aside class="showcase-sidebar @(isMobileSidebarOpen ? "open" : "")">
        <div class="showcase-sidebar-header">
            <div class="showcase-brand">
                <div class="showcase-brand-icon">
                    <Icon Name="widgets" />
                </div>
                <div style="display: grid; gap: 2px;">
                    <span class="showcase-brand-title">Socratic UI</span>
                    <span style="font-size: 0.72rem; color: var(--md-sys-color-on-surface-variant);">Design System & Catalog</span>
                </div>
            </div>
            <span class="showcase-brand-badge">v2.0</span>
        </div>

        <div class="showcase-search-box">
            <TextField Value="@searchQuery"
                       ValueChanged="@((string val) => { searchQuery = val; HandleSearchInput(new ChangeEventArgs { Value = val }); })"
                       ValueExpression="() => searchQuery"
                       Placeholder="Поиск компонентов..."
                       HasLeadingIcon="true"
                       LeadingIcon="search"
                       Variant="TextField<string>.TextFieldVariant.Outlined"
                       class="showcase-search-field" />
        </div>

        <List class="showcase-sidebar-nav">
            <ListItem Headline="Все компоненты"
                      Selected=@(selectedCategory == "all")
                      OnClick=@(() => SelectCategory("all"))>
                <StartContent>
                    <Icon Name="dashboard" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">@TotalComponentsCount</span>
                </EndContent>
            </ListItem>

            <div class="showcase-nav-category-header">Material.Web</div>
            <ListItem Headline="Кнопки, FAB & Выбор"
                      Selected=@(selectedCategory == "mat-buttons")
                      OnClick=@(() => SelectCategory("mat-buttons"))>
                <StartContent>
                    <Icon Name="smart_button" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">4</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="Элементы управления"
                      Selected=@(selectedCategory == "mat-controls")
                      OnClick=@(() => SelectCategory("mat-controls"))>
                <StartContent>
                    <Icon Name="tune" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">5</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="Поля ввода & Формы"
                      Selected=@(selectedCategory == "mat-inputs")
                      OnClick=@(() => SelectCategory("mat-inputs"))>
                <StartContent>
                    <Icon Name="edit_note" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">3</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="Вкладки & Навигация"
                      Selected=@(selectedCategory == "mat-nav")
                      OnClick=@(() => SelectCategory("mat-nav"))>
                <StartContent>
                    <Icon Name="tab" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">3</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="Карточки & Обратная связь"
                      Selected=@(selectedCategory == "mat-surface")
                      OnClick=@(() => SelectCategory("mat-surface"))>
                <StartContent>
                    <Icon Name="layers" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">6</span>
                </EndContent>
            </ListItem>

            <div class="showcase-nav-category-header">Специализированные библиотеки</div>
            <ListItem Headline="Smart.Web"
                      Selected=@(selectedCategory == "smart-web")
                      OnClick=@(() => SelectCategory("smart-web"))>
                <StartContent>
                    <Icon Name="auto_awesome" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">5</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="QuickGrid Таблица"
                      Selected=@(selectedCategory == "quickgrid")
                      OnClick=@(() => SelectCategory("quickgrid"))>
                <StartContent>
                    <Icon Name="table_chart" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">2</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="QrDesigner"
                      Selected=@(selectedCategory == "qr-designer")
                      OnClick=@(() => SelectCategory("qr-designer"))>
                <StartContent>
                    <Icon Name="qr_code_2" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">1</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="ReceiptPrinter"
                      Selected=@(selectedCategory == "receipt-printer")
                      OnClick=@(() => SelectCategory("receipt-printer"))>
                <StartContent>
                    <Icon Name="receipt_long" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">1</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="Markdown Section"
                      Selected=@(selectedCategory == "markdown")
                      OnClick=@(() => SelectCategory("markdown"))>
                <StartContent>
                    <Icon Name="code" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">1</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="Chat & AI Messaging"
                      Selected=@(selectedCategory == "chat")
                      OnClick=@(() => SelectCategory("chat"))>
                <StartContent>
                    <Icon Name="forum" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">4</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="Карты & Геолокация"
                      Selected=@(selectedCategory == "map")
                      OnClick=@(() => SelectCategory("map"))>
                <StartContent>
                    <Icon Name="map" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">3</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="SeatDesigner"
                      Selected=@(selectedCategory == "seat-designer")
                      OnClick=@(() => SelectCategory("seat-designer"))>
                <StartContent>
                    <Icon Name="chair" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">2</span>
                </EndContent>
            </ListItem>
            <ListItem Headline="Shared Модули"
                      Selected=@(selectedCategory == "modules")
                      OnClick=@(() => SelectCategory("modules"))>
                <StartContent>
                    <Icon Name="extension" class="nav-icon" />
                </StartContent>
                <EndContent>
                    <span class="showcase-nav-count">9</span>
                </EndContent>
            </ListItem>
        </List>
    </aside>

    <!-- Main Content Area -->
    <div class="showcase-content">
        <!-- Top Bar -->
        <header class="showcase-topbar">
            <div class="showcase-topbar-left">
                <IconButton class="showcase-mobile-toggle" Icon="menu" OnClick="ToggleMobileSidebar" Title="Меню" AriaLabel="Меню" />
                <div>
                    <h2 class="showcase-topbar-title">Каталог компонентов Razor</h2>
                    <p class="showcase-topbar-subtitle">Единая интерактивная витрина всех библиотек компонентов Socratic</p>
                </div>
            </div>
            <div class="showcase-topbar-actions">
                <Button Variant="ButtonVariant.Outlined" Href="/docs">
                    <Icon Name="menu_book" Slot="icon" />
                    Документация
                </Button>
                <Button Variant="ButtonVariant.Filled" Href="/home">
                    <Icon Name="home" Slot="icon" />
                    На главную
                </Button>
            </div>
        </header>

        <!-- Hero Stats Banner -->
        <section class="showcase-hero">
            <div class="showcase-hero-content">
                <h1>Интерактивная библиотека компонентов</h1>
                <p>
                    В данном каталоге собраны все Razor-компоненты экосистемы Socratic: Material Design 3, умные компоненты Smart.Web, генераторы QR и чеков, карты, мессенджер и отраслевые модули электронной коммерции.
                </p>
                <div class="showcase-stats">
                    <div class="showcase-stat-pill">
                        <Icon Name="extension" class="showcase-stat-icon" />
                        <div class="showcase-stat-info">
                            <span class="showcase-stat-val">40+</span>
                            <span class="showcase-stat-lbl">Компонентов</span>
                        </div>
                    </div>
                    <div class="showcase-stat-pill">
                        <Icon Name="library_books" class="showcase-stat-icon" />
                        <div class="showcase-stat-info">
                            <span class="showcase-stat-val">10</span>
                            <span class="showcase-stat-lbl">Библиотек</span>
                        </div>
                    </div>
                    <div class="showcase-stat-pill">
                        <Icon Name="bolt" class="showcase-stat-icon" />
                        <div class="showcase-stat-info">
                            <span class="showcase-stat-val">Native AOT</span>
                            <span class="showcase-stat-lbl">Готовность</span>
                        </div>
                    </div>
                    <div class="showcase-stat-pill">
                        <Icon Name="palette" class="showcase-stat-icon" />
                        <div class="showcase-stat-info">
                            <span class="showcase-stat-val">Material 3</span>
                            <span class="showcase-stat-lbl">Дизайн-система</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Container for all Component Cards -->
        <div class="showcase-main-body">

            @* ------------------------------------------------------------- *@
            @* SECTION 1: MATERIAL.WEB - BUTTONS & ACTIONS                   *@
            @* ------------------------------------------------------------- *@
            @if (MatchesCategory("mat-buttons") && MatchesSearch("Button IconButton Fab SegmentedButton Кнопка"))
            {
                <section class="showcase-section" id="mat-buttons">
                    <div class="showcase-section-header">
                        <div class="showcase-section-title-wrap">
                            <Icon Name="smart_button" class="showcase-section-icon" />
                            <h3 class="showcase-section-title">Кнопки, FAB & Сегментированный выбор</h3>
                        </div>
                        <span class="showcase-lib-badge">Material.Web.Components</span>
                    </div>

                    <div class="showcase-cards-grid">
                        <!-- Button Card -->
                        <div class="showcase-card">
                            <div class="showcase-card-header">
                                <div class="showcase-card-title-group">
                                    <h4 class="showcase-card-title">Button</h4>
                                    <p class="showcase-card-desc">Все варианты Material 3 кнопок с иконками и состояниями</p>
                                </div>
                                <div class="showcase-card-actions">
                                    <IconButton Icon="code" OnClick=@(() => ToggleCode("button")) Title="Код" AriaLabel="Код" />
                                </div>
                            </div>
                            <div class="showcase-card-body">
                                <div class="showcase-demo-canvas">
                                    <div class="showcase-demo-row">
                                        <Button Variant="ButtonVariant.Filled" OnClick="@(() => IncrementClick("Filled Button"))">
                                            <Icon Name="check" Slot="icon" />
                                            Filled
                                        </Button>
                                        <Button Variant="ButtonVariant.Outlined" OnClick="@(() => IncrementClick("Outlined Button"))">
                                            <Icon Name="star" Slot="icon" />
                                            Outlined
                                        </Button>
                                        <Button Variant="ButtonVariant.Elevated" OnClick="@(() => IncrementClick("Elevated Button"))">
                                            Elevated
                                        </Button>
                                        <Button Variant="ButtonVariant.FilledTonal" OnClick="@(() => IncrementClick("Tonal Button"))">
                                            Tonal
                                        </Button>
                                        <Button Variant="ButtonVariant.Text" OnClick="@(() => IncrementClick("Text Button"))">
                                            Text
                                        </Button>
                                    </div>
                                    <div class="showcase-demo-row">
                                        <Button Variant="ButtonVariant.Filled" Disabled="true">Disabled</Button>
                                        <Button Variant="ButtonVariant.Outlined" Disabled="true">Disabled</Button>
                                    </div>
                                </div>
                            </div>
                            @if (IsCodeOpen("button"))
                            {
                                <div class="showcase-card-code">&lt;Button Variant="ButtonVariant.Filled" OnClick="HandleClick"&gt;
    &lt;Icon Name="check" Slot="icon" /&gt;
    Filled Button
&lt;/Button&gt;
&lt;Button Variant="ButtonVariant.Outlined"&gt;Outlined&lt;/Button&gt;
&lt;Button Variant="ButtonVariant.FilledTonal"&gt;Tonal&lt;/Button&gt;
&lt;Button Variant="ButtonVariant.Elevated"&gt;Elevated&lt;/Button&gt;
&lt;Button Variant="ButtonVariant.Text"&gt;Text&lt;/Button&gt;</div>
                            }
                            <div class="showcase-controls-bar">
                                <span>Последнее действие: <strong>@lastAction</strong></span>
                            </div>
                        </div>

                        <!-- IconButton Card -->
                        <div class="showcase-card">
                            <div class="showcase-card-header">
                                <div class="showcase-card-title-group">
                                    <h4 class="showcase-card-title">IconButton</h4>
                                    <p class="showcase-card-desc">Компактные кнопки с иконками и поддержкой Toggle-состояния</p>
                                </div>
                                <div class="showcase-card-actions">
                                    <IconButton Icon="code" OnClick=@(() => ToggleCode("iconbutton")) Title="Код" AriaLabel="Код" />
                                </div>
                            </div>
                            <div class="showcase-card-body">
                                <div class="showcase-demo-canvas">
                                    <div class="showcase-demo-row">
                                        <IconButton Icon="favorite" Variant="IconButtonVariant.Filled" OnClick="@(() => IncrementClick("Filled Icon"))" />
                                        <IconButton Icon="share" Variant="IconButtonVariant.FilledTonal" OnClick="@(() => IncrementClick("Tonal Icon"))" />
                                        <IconButton Icon="bookmark" Variant="IconButtonVariant.Outlined" OnClick="@(() => IncrementClick("Outlined Icon"))" />
                                        <IconButton Icon="settings" Variant="IconButtonVariant.Standard" OnClick="@(() => IncrementClick("Standard Icon"))" />
                                        <IconButton Icon="thumb_up" Toggle="true" Selected="@isIconSelected" SelectedChanged="v => isIconSelected = v" />
                                    </div>
                                    <span style="font-size: 0.8rem; color: var(--md-sys-color-on-surface-variant);">
                                        Toggle-кнопка лайка: <strong>@(isIconSelected ? "❤️ Выбрано" : "🤍 Не выбрано")</strong>
                                    </span>
                                </div>
                            </div>
                            @if (IsCodeOpen("iconbutton"))
                            {
                                <div class="showcase-card-code">&lt;IconButton Icon="favorite" Variant="IconButtonVariant.Filled" /&gt;
&lt;IconButton Icon="share" Variant="IconButtonVariant.FilledTonal" /&gt;
&lt;IconButton Icon="bookmark" Variant="IconButtonVariant.Outlined" /&gt;
&lt;IconButton Icon="thumb_up" Toggle="true" @@bind-Selected="isLiked" /&gt;</div>
                            }
                        </div>

                        <!-- Fab Card -->
                        <div class="showcase-card">
                            <div class="showcase-card-header">
                                <div class="showcase-card-title-group">
                                    <h4 class="showcase-card-title">Floating Action Button (FAB)</h4>
                                    <p class="showcase-card-desc">Плавающие кнопки действий разных размеров и цветовых вариантов</p>
                                </div>
                                <div class="showcase-card-actions">
                                    <IconButton Icon="code" OnClick=@(() => ToggleCode("fab")) Title="Код" AriaLabel="Код" />
                                </div>
                            </div>
                            <div class="showcase-card-body">
                                <div class="showcase-demo-canvas">
                                    <div class="showcase-demo-row" style="align-items: center;">
                                        <Fab Icon="add" Size="small" Variant="primary" OnClick="@(() => IncrementClick("Small FAB"))" />
                                        <Fab Icon="edit" Size="medium" Variant="surface" OnClick="@(() => IncrementClick("Medium Surface FAB"))" />
                                        <Fab Icon="shopping_cart" Size="medium" Variant="secondary" Label="В корзину" OnClick="@(() => IncrementClick("Extended FAB"))" />
                                        <Fab Icon="navigation" Size="large" Variant="tertiary" OnClick="@(() => IncrementClick("Large FAB"))" />
                                    </div>
                                </div>
                            </div>
                            @if (IsCodeOpen("fab"))
                            {
                                <div class="showcase-card-code">&lt;Fab Icon="add" Size="small" Variant="primary" /&gt;
&lt;Fab Icon="edit" Size="medium" Variant="surface" /&gt;
&lt;Fab Icon="shopping_cart" Size="medium" Variant="secondary" Label="В корзину" /&gt;
&lt;Fab Icon="navigation" Size="large" Variant="tertiary" /&gt;</div>
                            }
                        </div>

                        <!-- SegmentedButton Card -->
                        <div class="showcase-card">
                            <div class="showcase-card-header">
                                <div class="showcase-card-title-group">
                                    <h4 class="showcase-card-title">SegmentedButtonSet & SegmentedButton</h4>
                                    <p class="showcase-card-desc">Набор связанных кнопок для выбора одного или нескольких вариантов</p>
                                </div>
                                <div class="showcase-card-actions">
                                    <IconButton Icon="code" OnClick=@(() => ToggleCode("segmented")) Title="Код" AriaLabel="Код" />
                                </div>
                            </div>
                            <div class="showcase-card-body">
                                <div class="showcase-demo-canvas">
                                    <SegmentedButtonSet>
                                        <SegmentedButton Label="День" Selected="@(selectedTimePeriod == "Day")" OnClick="@(() => selectedTimePeriod = "Day")">
                                            <Icon Name="calendar_today" Slot="icon" />
                                        </SegmentedButton>
                                        <SegmentedButton Label="Неделя" Selected="@(selectedTimePeriod == "Week")" OnClick="@(() => selectedTimePeriod = "Week")">
                                            <Icon Name="calendar_view_week" Slot="icon" />
                                        </SegmentedButton>
                                        <SegmentedButton Label="Месяц" Selected="@(selectedTimePeriod == "Month")" OnClick="@(() => selectedTimePeriod = "Month")">
                                            <Icon Name="calendar_month" Slot="icon" />
                                        </SegmentedButton>
                                    </SegmentedButtonSet>
                                    <span style="font-size: 0.85rem; color: var(--md-sys-color-on-surface-variant); margin-top: 8px;">
                                        Выбранный период: <strong style="color: var(--md-sys-color-primary);">@selectedTimePeriod</strong>
                                    </span>
                                </div>
                            </div>
                            @if (IsCodeOpen("segmented"))
                            {
                                <div class="showcase-card-code">&lt;SegmentedButtonSet&gt;
    &lt;SegmentedButton Label="День" Selected="@@(period == \"Day\")" OnClick="@@(() =&gt; period = \"Day\")" /&gt;
    &lt;SegmentedButton Label="Неделя" Selected="@@(period == \"Week\")" OnClick="@@(() =&gt; period = \"Week\")" /&gt;
    &lt;SegmentedButton Label="Месяц" Selected="@@(period == \"Month\")" OnClick="@@(() =&gt; period = \"Month\")" /&gt;
&lt;/SegmentedButtonSet&gt;</div>
                            }
                        </div>
                    </div>
                </section>
            }

            @* ------------------------------------------------------------- *@
            @* SECTION 2: MATERIAL.WEB - SELECTION & CONTROLS                *@
            @* ------------------------------------------------------------- *@
            @if (MatchesCategory("mat-controls") && MatchesSearch("Checkbox Switch Radio Slider RangeSlider ColorPicker Выбор"))
            {
                <section class="showcase-section" id="mat-controls">
                    <div class="showcase-section-header">
                        <div class="showcase-section-title-wrap">
                            <Icon Name="tune" class="showcase-section-icon" />
                            <h3 class="showcase-section-title">Элементы управления & Выбор параметров</h3>
                        </div>
                        <span class="showcase-lib-badge">Material.Web.Components</span>
                    </div>

                    <div class="showcase-cards-grid">
                        <!-- Checkbox & Switch Card -->
                        <div class="showcase-card">
                            <div class="showcase-card-header">
                                <div class="showcase-card-title-group">
                                    <h4 class="showcase-card-title">Checkbox & Switch</h4>
                                    <p class="showcase-card-desc">Флажки и переключатели с поддержкой иконок и событий</p>
                                </div>
                                <div class="showcase-card-actions">
                                    <IconButton Icon="code" OnClick=@(() => ToggleCode("checkbox-switch")) Title="Код" AriaLabel="Код" />
                                </div>
                            </div>
                            <div class="showcase-card-body">
                                <div class="showcase-demo-canvas">
                                    <div class="showcase-demo-row">
                                        <label style="display: inline-grid; grid-auto-flow: column; align-items: center; gap: 8px; cursor: pointer;">
                                            <Checkbox @bind-Value="demoCheckbox" />
                                            <span>Уведомления: <strong>@(demoCheckbox ? "Вкл" : "Выкл")</strong></span>
                                        </label>
                                        <label style="display: inline-grid; grid-auto-flow: column; align-items: center; gap: 8px; cursor: pointer;">
                                            <Checkbox @bind-Value="demoIndeterminateCheckbox" Indeterminate="true" />
                                            <span>Частично выбран</span>
                                        </label>
                                    </div>
                                    <div class="showcase-demo-row">
                                        <label style="display: inline-grid; grid-auto-flow: column; align-items: center; gap: 10px; cursor: pointer;">
                                            <Switch @bind-Value="demoSwitch" Icons="true" />
                                            <span>Темный режим: <strong>@(demoSwitch ? "Активен" : "Отключен")</strong></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            @if (IsCodeOpen("checkbox-switch"))
                            {
                                <div class="showcase-card-code">&lt;Checkbox @@bind-Value="isChecked" /&gt;
&lt;Switch @@bind-Value="isDark" Icons="true" /&gt;</div>
                            }
                        </div>

                        <!-- Radio Group Card -->
                        <div class="showcase-card">
                            <div class="showcase-card-header">
                                <div class="showcase-card-title-group">
                                    <h4 class="showcase-card-title">Radio</h4>
                                    <p class="showcase-card-desc">Группы радиокнопок для взаимно исключающего выбора</p>
                                </div>
                                <div class="showcase-card-actions">
                                    <IconButton Icon="code" OnClick=@(() => ToggleCode("radio")) Title="Код" AriaLabel="Код" />
                                </div>
                            </div>
                            <div class="showcase-card-body">
                                <div class="showcase-demo-canvas">
                                    <div class="showcase-demo-col">
                                        <label style="display: inline-grid; grid-auto-flow: column; align-items: center; gap: 8px; cursor: pointer;">
                                            <Radio Name="delivery-opt" Checked="@(selectedDelivery == "courier")" Value="courier" OnChange="@(() => selectedDelivery = "courier")" />
                                            <span>🚀 Курьерская экспресс-доставка</span>
                                        </label>
                                        <label style="display: inline-grid; grid-auto-flow: column; align-items: center; gap: 8px; cursor: pointer;">
                                            <Radio Name="delivery-opt" Checked="@(selectedDelivery == "pickup")" Value="pickup" OnChange="@(() => selectedDelivery = "pickup")" />
                                            <span>🏪 Самовывоз из филиала</span>
                                        </label>
                                        <label style="display: inline-grid; grid-auto-flow: column; align-items: center; gap: 8px; cursor: pointer;">
                                            <Radio Name="delivery-opt" Checked="@(selectedDelivery == "post")" Value="post" OnChange="@(() => selectedDelivery = "post")" />
                                            <span>📦 Почтовое отправление</span>
                                        </label>
                                    </div>
                                    <span style="font-size: 0.8rem; color: var(--md-sys-color-primary);">Выбран способ: <strong>@selectedDelivery</strong></span>
                                </div>
                            </div>
